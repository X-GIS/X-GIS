{
  "name": "@xgis/shader-dsl",
  "version": "0.0.1",
  "description": "A TypeScript shader DSL: author a typed node graph once and emit WGSL, GLSL ES 3.00, an f64 CPU oracle, and pipeline reflection from the same source.",
  "keywords": [
    "shader",
    "wgsl",
    "glsl",
    "webgpu",
    "webgl2",
    "gpu",
    "shading-language",
    "dsl",
    "typescript",
    "reflection"
  ],
  "license": "MIT",
  "author": "TypeShade",
  "homepage": "https://typeshade.dev",
  "bugs": {
    "url": "https://github.com/typeshade/typeshade/issues"
  },
  "type": "module",
  "sideEffects": [
    "./src/core/ir/builder.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dev": "./src/dev.ts",
    "./compute": "./src/compute.ts",
    "./emit-prod": "./src/emit-prod.ts",
    "./core/ir": "./src/core/ir/index.ts",
    "./examples": "./examples/index.ts"
  },
  "files": [
    "src",
    "examples",
    "tsconfig.json",
    "tsconfig.base.json",
    "tsconfig.tests.json",
    "AUTHORING.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "!**/*.test.ts",
    "!**/__emit-goldens__",
    "!**/AGENTS.md",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/typeshade/typeshade.git"
  },
  "scripts": {
    "build": "tsc --build && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "gate:compile": "bun scripts/compile-gate.ts"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@webgpu/types": "^0.1.69",
    "playwright": "^1.59.1",
    "typescript": "5.6.3",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
