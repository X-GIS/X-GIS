{
  "name": "@xgis/shader-dsl",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./core/ir": "./src/core/ir/index.ts",
    "./core/*": "./src/core/*.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./core/ir": {
        "types": "./dist/core/ir/index.d.ts",
        "default": "./dist/core/ir/index.js"
      },
      "./core/*": {
        "types": "./dist/core/*.d.ts",
        "default": "./dist/core/*.js"
      }
    }
  }
}
