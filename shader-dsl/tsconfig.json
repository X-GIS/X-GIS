{
  // #1681 B1 — the PACKAGE-LOCAL base, never the monorepo root's: this directory
  // must compile when it is vendored out of the repo. See tsconfig.base.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": []
  },
  "include": ["src/**/*.ts"],
  // #763 V6 — tests never reach dist/ (the publishable tarball ships `files: ["dist"]`;
  // compiled *.test.js/.d.ts were riding along). Test TYPE-CHECKING is not lost: the
  // `build` script chains `tsc -p tsconfig.tests.json` (a noEmit pass over src + examples).
  "exclude": ["src/**/*.test.ts"]
}
