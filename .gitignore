node_modules/
dist/
*.xgb
# Bulk Natural Earth / xgvt data — large binary files generated by
# the tiler, not source-controlled. The `/*` form (rather than the
# directory form) lets the negation pattern below escape the
# ignore for individual fixture files.
playground/public/data/*
# Fixture data IS checked in — tiny GeoJSON files (<1KB each)
# used by playground/e2e/fixtures.spec.ts. They must travel with
# the tests, unlike the bulk data above.
!playground/public/data/fixture-*.geojson
# Tiny .odb OD-flow fixture (real OA-22300 aggregated to 서울 top-2000, ~26KB)
# so the .odb hero demo + its e2e gate render without the 345MB raw CSV.
!playground/public/data/fixture-*.odb
# Seoul demo backdrop (자치구 boundary) + custom-loader CSV sample — the 생활이동
# hero demos load these; without whitelisting they deploy as 404 (the bulk-data ignore
# above catches them, and CI's git checkout never sees the local-only files).
!playground/public/data/seoul_gu.geojson
!playground/public/data/seoul_outflow.csv

# Natural Earth 110m countries (~700 KB) — referenced by 19+ demo
# .xgis files (filter-gdp, continent-match, layered-borders, etc.).
# Without this, those demos 404 silently. Small enough to ship
# alongside the tracked xgvt fixtures.
!playground/public/data/ne_110m_countries.geojson

# Natural Earth 110m physical layers (~780 KB total). Same rationale:
# lots of demos use `ne_110m_{ocean,land,coastline,rivers,lakes}.geojson`
# directly; 404 leaves iOS showing the opaque "string did not match
# the expected pattern" (response.json() on an HTML error page).
!playground/public/data/ne_110m_ocean.geojson
!playground/public/data/ne_110m_land.geojson
!playground/public/data/ne_110m_coastline.geojson
!playground/public/data/ne_110m_rivers.geojson
!playground/public/data/ne_110m_lakes.geojson
!playground/public/data/ne_110m_populated_places.geojson

# `land.geojson` — small (232KB) Natural-Earth land-only feature set,
# mirrored from site/public/data/land.geojson so the blueprint editor's
# default starter graph (`source land { url: "land.geojson" }`) works
# identically in both contexts. Avoids the "blueprint Open-in-
# Playground 404" gap when the user lands the default scene without
# changing the URL field.
!playground/public/data/land.geojson

# `countries.geojson` — Natural Earth country polygons referenced by 20+ demo
# .xgis files (categorical, continent-match, gdp-gradient, bold-borders, …).
# Same rationale as the ne_110m_* set: must ship or those demos 404.
!playground/public/data/countries.geojson

# Playwright e2e artifacts
playground/test-results/
playground/playwright-report/
playground/.playwright/
/test-results/
playground/e2e/__*__
# Tracked pixel-match outputs that we keep checked in for visual regression
!playground/e2e/__pixel-match-survey__
!playground/e2e/__pixel-match-survey__/**
!playground/e2e/__pixel-match-demotiles-user__
!playground/e2e/__pixel-match-demotiles-user__/**
!playground/e2e/__projection-zoom-survey__
!playground/e2e/__projection-zoom-survey__/**
# Matrix-gate candidate artifacts (scratch for human review) stay ignored via
# the __*__ rule above. The REVIEWED baseline corpus lives at
# playground/render-verify/baselines/ (NOT under __*__), so it is tracked by
# default — only `bun run matrix:accept` writes there. See docs/verification/MATRIX.md.

# Profiling + perf-debug dumps (ad-hoc, not source-controlled)
*.cpuprofile
*.log
playground/profile-*
playground/baseline-stats.json
playground/post-p1-stats.json
/filter-gdp-iphone.png

# Build artifacts in source dirs
**/*.js.map
compiler/src/**/*.d.ts
runtime/src/**/*.d.ts
runtime/src/**/*.js
!compiler/src/tiler/earcut.d.ts
!runtime/src/earcut.d.ts
*.tsbuildinfo
nul

# npm pack output — local tarballs from `npm pack` / clean-room verification
*.tgz

# Local Claude Code harness state (per-machine). EXCEPTION: .claude/agents/
# holds project reviewer agents meant to travel with the repo (like the
# already-tracked settings.json / skills/), so it is carved back in — a
# wholesale `.claude/` exclude would make the carve-back impossible.
.claude/*
!.claude/agents/
!.claude/settings.json
!.claude/launch.json
!.claude/skills/

# Per-developer editor configs. The codebase-memory MCP extension writes a
# machine-local server path (c:\Users\...) into these on install, so they
# can't be shared. CI uses bun/npm scripts, not editor config.
.cursor/
.vscode/
.zed/

# OMC (oh-my-claudecode) working tree — per-machine runtime state, session
# artifacts, and scratch docs. Ignored wholesale; not source-controlled.
# Files committed under .omc before this rule stay tracked until untracked
# explicitly (git rm --cached). EXCEPTION: .omc/skills/ holds project-scoped
# learned skills meant to travel with the repo (per CLAUDE.md), so it is carved
# back in — only the operational state stays ignored.
# Nested .omc dirs in subpackages (playground/.omc, shader-dsl/.omc, …) are all
# operational state — ignore at any depth.
**/.omc/
# Root .omc: keep the dir traversable, ignore its operational contents, but
# carve back in .omc/skills/ (the committable learned-skills exception).
!/.omc/
/.omc/*
!/.omc/skills/
tmp/

# DC=0 pixel-diff verification scratch — regeneratable before/after captures +
# diffs written by the compare-parity / relocation-dc0 dances. NOT golden
# fixtures (the reviewed baselines live tracked at playground/render-verify/
# baselines/ + playground/e2e/__pixel-match-*__). These are throwaway session
# artifacts (~13 MB of PNGs), regenerated by re-running the dance. Never commit.
playground/.reloc-dc0/
playground/.bug-shots/
