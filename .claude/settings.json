{
  "enabledPlugins": {
    "ralph-loop@claude-plugins-official": false
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/skills/prompt-router.cjs\""
          }
        ]
      }
    ]
  },
  {
