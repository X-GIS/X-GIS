xgis 1

/*
 * Port of MapLibre's "Fit a map to a bounding box" (#1192).
 *
 * The .xgis is a plain world base; the gallery action buttons call
 * map.fitBounds([[west, south], [east, north]]) at runtime — the
 * MapLibre original's button -> map.fitBounds wiring, expressed as
 * Demo.actions metadata.
 */

source world {
  type: geojson
  url: "ne_110m_countries.geojson"
}

layer countries {
  source: world
  | fill-emerald-800 stroke-emerald-500 stroke-0.5
}
