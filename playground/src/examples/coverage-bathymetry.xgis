xgis 1

// S-100 gridded-coverage demo (#1158, re-platformed by ADR-0010). A synthetic 32×32
// S-102 bathymetry grid at 50-58°N: a north→south depth ramp (0 → 40 m) with a nodata
// hole and 4 known-value corner cells — the fixture the headed render gate reads
// back (_coverage-render.spec.ts). The `coverage` source reads the S-102 HDF5 IN
// PLACE (no `.xgcov` transcode); regenerate the asset with
// `python playground/scripts/gen-demo-coverage.py`. The GPU colour-ramp draw is the
// INC-A gate-3 (headed) item; `map.getCoverage('bathy').valueAt(lon, lat)` already
// returns the exact positive-down value CPU-side.

// Esri World Imagery satellite basemap (same source the satellite_map demo uses) — the
// bathymetry draws OVER real imagery for real-world context. CORS `*`, so it works on the
// hosted static site. {z}/{y}/{x} = the ArcGIS path order.
source basemap {
  type: raster
  url: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
}

source bathy {
  type: coverage
  url: "synthetic-bathymetry.h5"
}

layer imagery {
  source: basemap
}

// `filter:` on a coverage layer thins the RAMP in the fragment shader (#1437) — the predicate
// is compiled once to shader-dsl IR, emitted into `fs_cov` as a discard, and run on the CPU
// through the same IR for the numerals below. Before that it reached the numerals only, so a
// `ramp:` layer painted every valid cell and the clause looked ignored.
//
// Here it drops the land/zero shelf so the ramp spends its whole range on real water. On this
// synthetic fixture the north edge sits at 0 m, and the nodata hole is discarded already by
// the validity test — the filter is what removes the exactly-zero row.
layer depth {
  source: bathy
  ramp: "bathymetry"
  range: [0, 40]
  filter: .depth > 0.0
  | opacity-75
}

// Sounding NUMERALS over the ramp (#1366 INC-5) — the reading a colour ramp cannot give.
// Depths come straight off the ORIGINAL grid (`valueAt`, nearest-cell, never interpolated),
// so a numeral can only show a depth the cell actually holds; `.depth` is the S-102 band
// name, read exactly as a feature property would be. Candidates are picked on a GRID-anchored
// lattice — every stride'th cell — and thinned by the label collision pass.
//
// `{.depth:.1f}` is the label text-format mini-language (`{<expr>:<spec>}`, the printf/Python
// spec plus GIS types and a `;<locale>` tail), asking for one decimal.
//
// This demo carries them, not just the live one, because it needs NO NETWORK: the fixture is
// committed, so the numerals are verifiable on any checkout — which is how INC-5's render
// gate was actually run. On this fixture they climb north→south with the 0→40 m ramp, with
// none over the nodata hole.
layer soundings {
  source: bathy
  | label-["{.depth:.1f}"] label-color-#fff label-size-11
    label-halo-1 label-halo-color-#000
}
