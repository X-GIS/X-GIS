xgis 1

// NOAA S-111 surface currents (#1272) — a SYNTHETIC Chesapeake-Bay-shaped
// tidal field (northward channel + counter-clockwise gyre, coast-shaped nodata
// margins) carrying the real S-111 band names/units/fill. The speed band draws
// through the viridis coverage colour ramp (range 0-2 kn); the demo runner
// overlays drifting particles along the direction band (Demo.currents →
// retained particle-flow, #826). Regenerate the artifact with
// `bun pipeline/tools/gen-synthetic-currents.ts --out playground/public/synthetic-currents.xgcov`.

source currents {
  type: coverage
  url: "synthetic-currents.xgcov"
  ramp: "viridis"
  range: [0, 2]
}

layer speed {
  source: currents
}
