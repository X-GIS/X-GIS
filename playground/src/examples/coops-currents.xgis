xgis 1

// NOAA CO-OPS live tidal currents (#1272) — declarative style here, live data
// pushed in from coops-currents.recipe.ts (shown in the demo's JS tab).
//
// Two-part demo:
//   • THIS .xgis is the declarative half — a satellite basemap plus a `stations`
//     source that carries no url:. The recipe fetches the Chesapeake Bay PORTS
//     current stations from api.tidesandcurrents.noaa.gov (CORS `*`), assembles
//     GeoJSON, and pushes it with map.setSourceData('stations', …). The
//     station_dots layer below then colours + sizes each point by its `.speed`
//     with zero draw code (the "declare a source, push data in" path, #1303).
//   • Direction is now ALSO declarative: the `arrows` layer below rotates one
//     glyph per station by its `.dir` bearing via `| arrow bearing-[.dir]`
//     (#1302). The recipe just pushes data — no per-arrow draw code anymore.
//
// Basemap: Esri World Imagery, the same raster source the satellite_map demo
// uses, so the live field reads against the real Chesapeake Bay coastline and
// water. Note the ArcGIS {z}/{y}/{x} order (the tile-URL substitution is
// order-agnostic). Imagery © Esri, Maxar, Earthstar Geographics, and the GIS
// User Community.

source satellite {
  type: raster
  url: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
}

// No url: — the recipe fills this at runtime via setSourceData('stations', fc),
// then re-pushes every ~6 min (host setInterval today; a declarative source
// refresh: is #1304).
source stations {
  type: geojson
}

layer imagery {
  source: satellite
}

// DECLARATIVE speed encoding: colour + radius straight from the pushed `.speed`
// field — the same field the recipe's direction arrows ramp, so dots and arrows
// agree. gradient(field, min, max, low, high) is the data-driven colour ramp.
layer station_dots {
  source: stations
  | fill gradient(.speed, 0, 120, sky-300, rose-600) opacity-55 stroke-white stroke-1
  | size-[14 + sqrt(.speed) * 2.2]
}

// DECLARATIVE direction field (#1302): one arrow per station, rotated by the
// station's `.dir` bearing (degrees true, 0 = N clockwise). `| arrow bearing-[.dir]`
// draws the same geo-oriented arrow the retained-graphics primitive did — now as
// pure style. Size + colour ramp the SAME `.speed` field as station_dots, so the
// dots and arrows agree; size clamps to [10,46] px exactly as the old host code did.
layer arrows {
  source: stations
  | arrow bearing-[.dir] size-[clamp(10 + sqrt(.speed) * 4, 10, 46)]
  | fill gradient(.speed, 0, 120, sky-300, rose-600)
}
