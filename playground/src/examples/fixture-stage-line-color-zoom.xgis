xgis 1

/* Fixture: a NON-constant `@stroke` shader stage block on a line layer
 * (#1605 Phase 1) — the one that actually exercises the composer seam
 * (map/src/shaders/dsl/line.ts's 'line-color-return' placeholder).
 *
 * Unlike fixture-stage-line-color.xgis (a constant body, CPU-folded, never
 * reaches the composer), this body reads `zoom`, so it is NOT foldable at
 * compile time and genuinely depends on the runtime variant seam to render.
 *
 * Since #1605 Phase 3 the seam runs on BOTH backends, so this is now a real
 * headless CI render gate: playground/e2e/_stage-block-line-webgl2-gate.spec.ts
 * samples the stroke and asserts the authored colour.
 *
 * KNOWN GAP, do not be surprised by it: the rendered red channel is 0, NOT
 * zoom/22 (#1635). A bare `zoom` in a stage block still compiles to the literal
 * 0.0 — compiler/src/codegen/wgsl-expr.ts's Identifier arm falls back to
 * f32Lit(0) and `zoom` is explicitly excluded from the feature-field set, so
 * the lookup always misses. That is pre-existing and backend-agnostic (shared
 * IR), not a WebGL2 issue, and it does not stop this fixture doing its job:
 * reading `zoom` is what makes the body unfoldable, and the green/blue
 * constants (0.2 / 0.1) render exactly, which is what proves the composed
 * shader evaluated the expression. See the spec header for the full trace. */

source l {
  type: geojson
  data: { "type": "FeatureCollection", "features": [
    { "type": "Feature", "geometry": { "type": "LineString", "coordinates": [[-40, 0], [40, 0]] }, "properties": {} }
  ] }
}

layer painted {
  source: l
  @stroke { return vec4(zoom / 22, 0.2, 0.1, 1) }
  | stroke-16
}
