xgis 1

/*
 * Satellite raster base + a HAND-PICKED subset of OpenFreeMap vector
 * layers on top (roads + place names) — not the whole style.
 *
 * The trap this demo avoids: `import "…/styles/bright"` (splice form)
 * pulls EVERY one of OFM's ~80 layers, and there is no way to cherry-pick
 * individual LAYERS out of it (cherry-pick — `import { name } from "url"`
 * — only selects `source` / `preset` / `symbol` blocks, never `layer`).
 * So to keep a raster base and add just a couple of OFM layers, you don't
 * import the layers at all: declare the vector SOURCE yourself, then
 * hand-write only the layers you want.
 *
 * Layer draw order is DECLARATION order (first = bottom): the satellite
 * imagery sits underneath, roads and labels stack on top.
 *
 * `openmaptiles` is the same OpenMapTiles-schema TileJSON the full OFM
 * Bright style's vector source uses. Source-layers pulled here:
 *   transportation       — road / rail line geometry
 *   transportation_name  — road-name labels (placed along the line)
 *   place                — settlement labels (city / town / suburb)
 * Add water / boundary / poi / building the same way.
 *
 * Labels rasterise on-device from the CSS map fonts, so no glyphs URL is
 * needed here (same path as the pmtiles_labels demo). In your own app,
 * point the map at OFM's font server for MapLibre-parity SDF glyphs:
 *   new XGISMap(el, { glyphs: { url: "<the style's top-level `glyphs` URL>" } })
 *
 * Opens over Seoul. Imagery © Esri, Maxar, Earthstar Geographics, and the
 * GIS User Community.
 */

// 1) Satellite imagery at the bottom (Esri World Imagery; ArcGIS {z}/{y}/{x}).
source satellite {
  type: raster
  url: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
}

layer imagery {
  source: satellite
}

// 2) The OpenFreeMap vector SOURCE only — none of its layers.
source openmaptiles {
  type: tilejson
  url: "https://tiles.openfreemap.org/planet"
}

// 3) Only the layers we actually want, drawn over the imagery in order.
layer roads {
  source: openmaptiles
  sourceLayer: "transportation"
  | stroke-amber-300 stroke-1 opacity-75
}

layer road_labels {
  source: openmaptiles
  sourceLayer: "transportation_name"
  | label-[.name] label-size-12 label-color-#fff
    label-halo-1 label-halo-color-#000 label-along-path
}

layer place_labels {
  source: openmaptiles
  sourceLayer: "place"
  | label-[.name] label-size-14 label-color-#fff
    label-halo-1 label-halo-color-#000
}
