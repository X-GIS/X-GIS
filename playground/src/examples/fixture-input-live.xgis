xgis 1

/* Fixture: `input` host-contract declarations (#1539).
 * `threshold` and `highlight` are declared parameters the host sets at
 * runtime with `map.setInput(name, value)` — a uniform write only, with no
 * pipeline rebuild. With no host call they hold the defaults below.
 *
 * Both are bound through UTILITIES (not a `@color` stage block) on purpose:
 * a utility binding is an `input-dependent` PropertyShape, resolved per frame
 * on the CPU into the existing opacity / fill uniforms, so it renders on the
 * WebGL2 backend too — which is what makes _input-live-set.spec.ts able to
 * prove setInput changes pixels headlessly. */

input threshold: f32 = 1.0
input highlight: color = #f59e0b

source poly {
  type: geojson
  data: { "type": "FeatureCollection", "features": [
    { "type": "Feature", "geometry": { "type": "Polygon", "coordinates": [[[-40, -25], [40, -25], [40, 25], [-40, 25], [-40, -25]]] }, "properties": {} }
  ] }
}

layer painted {
  source: poly
  | fill-[highlight] opacity-[threshold]
}
