xgis 1

// NOAA S-111 LIVE surface currents (#1272) — streams a REAL NOAA forecast cell
// straight from the NOAA Open-Data S3 bucket (noaa-s111-pds), read as the S-100
// HDF5 standard IN PLACE (ADR-0010, no transcode). This is NOT synthetic: the
// CBOFS (Chesapeake Bay Operational Forecast System) regional cell it draws is
// the real operational forecast, ~12 MB of gridded surface-current speed +
// direction.
//
// CORS: the NOAA bucket serves HTTP-Range but sets no Access-Control-Allow-Origin,
// so the browser reaches it through a proxy — the vite dev-server `/noaa-s111`
// bridge in dev, a CORS-open proxy in prod (loader.ts URL rewrite). The proxy's
// `/noaa-s111/latest/<model>.h5` route resolves the newest published cycle on each
// load, so the demo never rots as old cycles age out of the rolling bucket. Those
// URLs are fetched by the MOSAIC, not by this file — see the `currents` source.

// Esri World Imagery satellite basemap (same source the satellite_map demo uses),
// so the currents draw over real nautical imagery. CORS `*`.
source basemap {
  type: raster
  url: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
}

// The coverage source streams the real S-111 cell; the `currents` layer draws the OFFICIAL
// S-111 portrayal from the engine — `| arrow` (#1333): a band-coloured arrow at each grid
// cell, oriented by the direction band, scaled per the vendored IHO catalogue. Those arrows
// are STATIC and stay exactly as the catalogue specifies; no `ramp` is declared, so no colour
// area is drawn either (the catalogue defines coloured symbols, not a fill). Adding a
// `ramp: "s111-speed"` line would overlay the non-standard colour fill under them.
//
// `| flow` is the MOTION layer, and it is deliberately a separate, explicitly NON-CATALOGUE
// opt-in (#1333). The catalogue has nothing to say about animation — `<lineStyles/>`,
// `<areaFills/>` and `<pixmaps/>` are all empty — so a display that must be strictly
// conformant simply omits this one line and keeps the arrows alone.
//
// What it draws is an ADVECTED FIELD (IBFV), not particles: the image is stepped along the
// current each frame and re-seeded with noise, so there is nothing discrete to recycle. That
// is why it cannot blink. An earlier revision animated the arrow GLYPHS themselves — moving a
// recognizable symbol forces a respawn, a respawn forces a fade, and a fade on a large symbol
// IS a blink. Here the motion carrier is texture, and the symbol never moves.
//
// With no `ramp`, the motion renders as a neutral luminance over the satellite imagery — the
// catalogue arrows remain the only colour authority on screen.
// NO `url:` — this source is HOST-FED, and deliberately so (#1426). The VIEWPORT MOSAIC owns
// residency here: on each move-end it loads every NOAA regional model the view covers and
// pushes each one under its own region key (`/noaa-s111/latest/<model>.h5`), starting with the
// initial view at install. Declaring a cell URL as well pointed at `/noaa-s111/latest.h5` —
// which the proxy resolves to the newest CBOFS cell, i.e. THE SAME ~12 MB object the mosaic
// immediately fetches as `cbofs`. Both stayed resident (the mosaic drops only the keys it
// pushed itself), so the demo paid for two downloads, two decodes and two GPU-resident copies
// of one field drawn on top of each other — and stepping the forecast hour moved only the
// mosaic's copy, putting two DIFFERENT hours on screen at once.
source currents {
  type: coverage
}

layer imagery {
  source: basemap
}

layer speed {
  source: currents
  | arrow
  | flow
}
