xgis 1

/*
 * Port of MapLibre's "Animate a point along a route" (#1192).
 *
 * The route is a 33-vertex great-circle arc from San Francisco to
 * Washington DC, inlined so the demo is fully offline. The moving point is a
 * Marker DOM overlay (#1262) the gallery action drives with one
 * marker.setLngLat() per animation frame — a screen-space reposition
 * (map.project), NOT a per-frame source re-tile.
 *
 * Pushing the position through map.setSourceData('marker', …) every frame
 * instead re-seeds the virtual-tiling pipeline 60×/s: the sibling
 * animate-line / realtime-update demos throttle that same push to SECONDS
 * precisely because sub-second churn starves the tiling worker round-trip —
 * at rAF cadence it wedged the tab and lost the GPU context. A moving marker
 * belongs in a screen-space overlay, not the tiled-geometry path.
 */

source route {
  type: geojson
  data: { "type": "FeatureCollection", "features": [
    { "type": "Feature", "properties": {}, "geometry": { "type": "LineString", "coordinates": [
      [-122.41, 37.78], [-121.07, 38.08], [-119.72, 38.36], [-118.35, 38.63],
      [-116.98, 38.89], [-115.6, 39.12], [-114.2, 39.35], [-112.8, 39.55],
      [-111.39, 39.74], [-109.98, 39.91], [-108.55, 40.06], [-107.12, 40.2],
      [-105.69, 40.32], [-104.25, 40.42], [-102.81, 40.5], [-101.36, 40.56],
      [-99.91, 40.61], [-98.46, 40.64], [-97.01, 40.65], [-95.56, 40.64],
      [-94.11, 40.61], [-92.66, 40.57], [-91.21, 40.51], [-89.77, 40.43],
      [-88.33, 40.33], [-86.89, 40.21], [-85.46, 40.08], [-84.04, 39.93],
      [-82.62, 39.76], [-81.21, 39.57], [-79.81, 39.37], [-78.42, 39.15],
      [-77.03, 38.91]
    ] } }
  ] }
}

source world {
  type: geojson
  url: "ne_110m_countries.geojson"
}

layer countries {
  source: world
  | fill-slate-800 stroke-slate-500 stroke-0.5
}

layer route_line {
  source: route
  | stroke-sky-400 stroke-2.5
}
