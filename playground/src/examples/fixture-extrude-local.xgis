/* P1.6 extrude verification: a constant-height 3D-extruded polygon through the VTR.
 * geojson source → VTR (recordTileFill, bindZBuffer) → the extruded fill pipeline.
 * fill-extrusion-height-[20] is a constant (no per-feature expr) → the default extrude shader. */
source poly { type: geojson, url: "fixture-square.geojson" }

layer the_building {
  source: poly
  | fill-stone-300 stroke-stone-500 stroke-1 fill-extrusion-height-[20]
}
