/* Continent colors using match() — each continent gets a distinct color */

source countries {
  type: geojson
  url: "ne_110m_countries.geojson"
}

/* The `_` default is a raw #hex ON PURPOSE (#725 regression guard): a #hex
   default arm used to collapse the whole match to that one colour at lowering,
   while a token default rendered per-feature. gray-400 ≡ #9ca3af. */
layer continents {
  source: countries
  | fill match(.CONTINENT) {
      "Africa"        -> amber-600,
      "Asia"          -> rose-500,
      "Europe"        -> sky-500,
      "North America" -> emerald-500,
      "South America" -> lime-500,
      "Oceania"       -> violet-500,
      "Antarctica"    -> slate-300,
      _               -> #9ca3af
    }
    stroke-slate-700 stroke-0.5 opacity-90
}
