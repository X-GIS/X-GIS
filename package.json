{
  "name": "xgis",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": ["compiler", "blueprint", "runtime", "playground", "site"],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "vitest run",
    "test:pixel": "cd playground && bunx playwright test _pixel-match-survey.spec.ts",
    "test:perf": "cd playground && bunx playwright test _perf-bright-interactive.spec.ts",
    "test:projection": "cd playground && bunx playwright test _projection-coverage.spec.ts",
    "test:e2e": "cd playground && bunx playwright test",
    "dev": "bun run --filter @xgis/playground dev",
    "dev:site": "bun run --filter @xgis/site dev",
    "dev:all": "bun run --filter @xgis/playground --filter @xgis/site dev",
    "precheck": "bun scripts/precheck.ts",
    "precheck:smoke": "bun scripts/precheck.ts --smoke",
    "setup:hooks": "git config core.hooksPath .githooks && echo Pre-push hook armed. Skip with --no-verify."
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@webgpu/types": "^0.1.69",
    "typescript": "5.6.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "earcut": "^3.0.2",
    "monaco-editor": "^0.55.1"
  }
}
