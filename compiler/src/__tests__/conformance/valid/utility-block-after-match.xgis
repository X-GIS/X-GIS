// @case valid
// @construct utility-block-after-match
// @desc a new `|` utility block directly after a match-block-valued utility parses (#1236 — the removed expression pipe used to swallow the `|`)
xgis 1
source land { type: geojson, url: "x.geojson" }
layer c {
  source: land
  | fill match(.C) {
      "Asia" -> red-400,
      _ -> gray-300
    }
  | stroke-white stroke-1
}
