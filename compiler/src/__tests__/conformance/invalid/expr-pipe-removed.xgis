// @case invalid
// @construct pipe-expression
// @desc the expression-level pipe operator was pruned by #1238 — a `|` inside a binding is now a generic syntax error (the `|` token belongs to utility lines, §2.12)
// @expect-code X-GIS0010
xgis 1
source w { type: geojson, url: "w.geojson" }
layer roads {
  source: w
  | size-[.speed | round]
}
