exports[`compute-gen WGSL snapshot — interpolate kernel > canonical interpolate-linear with 2 stops (degenerate-but-valid) 1`] = `
{
  "entryPoint": "eval_interpolate",
  "fieldOrder": [
    "mag",
  ],
  "wgsl": "@group(0) @binding(0) var<storage, read> feat_data: array<f32>;
@group(0) @binding(1) var<storage, read_write> out_color: array<u32>;
@group(0) @binding(2) var<uniform> u_count: vec4<u32>;

@compute @workgroup_size(64)
fn eval_interpolate(@builtin(global_invocation_id) gid: vec3<u32>) {
  let _cse0 = vec4<f32>(1.0, 1.0, 0.0, 1.0);
  let _cse1 = vec4<f32>(1.0, 0.0, 0.0, 1.0);
  if ((gid.x >= u_count.x)) {
    return;
  }
  let _v0 = feat_data[gid.x];
  var _v1: vec4<f32>;
  if ((_v0 <= 1.0)) {
    _v1 = _cse0;
  } else if ((_v0 <= 8.0)) {
    _v1 = mix(_cse0, _cse1, ((_v0 - 1.0) / 7.0));
  } else {
    _v1 = _cse1;
  }
  out_color[gid.x] = pack4x8unorm(_v1);
}
",
}
`;

