@compute @workgroup_size(64)
fn eval_match(@builtin(global_invocation_id) gid: vec3<u32>) {
  let fid = gid.x;
  if (fid >= u_count.x) { return; }
  let v_cls = feat_data[fid];
  var color: vec4<f32>;
