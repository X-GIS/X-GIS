  vec4<f32>(0.043137254901960784, 0.5019607843137255, 0.25098039215686274, 1.0),
  vec4<f32>(0.047058823529411764, 0.5019607843137255, 0.25098039215686274, 1.0),
  vec4<f32>(0.050980392156862744, 0.5019607843137255, 0.25098039215686274, 1.0),
