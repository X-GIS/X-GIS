exports[`compute-gen WGSL snapshot — ternary (case) kernel > canonical case() with 3 predicates + default 1`] = `
{
  "entryPoint": "eval_case",
  "fieldOrder": [
    "cls",
  ],
  "wgsl": "// Auto-generated by compiler/src/codegen/compute-gen.ts
// case() / ternary chain — first matching predicate wins.

@group(0) @binding(0) var<storage, read> feat_data: array<f32>;
@group(0) @binding(1) var<storage, read_write> out_color: array<u32>;
@group(0) @binding(2) var<uniform> u_count: vec4<u32>;

@compute @workgroup_size(64)
fn eval_case(@builtin(global_invocation_id) gid: vec3<u32>) {
  let fid = gid.x;
  if (fid >= u_count.x) { return; }
  let v_cls = feat_data[fid];
  var color: vec4<f32>;
  if (v_cls == 0.0) { color = vec4<f32>(1.0, 0.0, 0.0, 1.0); }
  else if (v_cls == 1.0) { color = vec4<f32>(0.0, 1.0, 0.0, 1.0); }
  else if (v_cls == 2.0) { color = vec4<f32>(0.0, 0.0, 1.0, 1.0); }
  else { color = vec4<f32>(0.5333333333333333, 0.5333333333333333, 0.5333333333333333, 1.0); }
  out_color[fid] = pack4x8unorm(color);
}
",
}
`;

exports[`compute-gen WGSL snapshot — ternary (case) kernel > canonical case() with compound predicate (multi-field) 1`] = `
{
  "entryPoint": "eval_case",
  "fieldOrder": [
    "rank",
    "class",
  ],
  "wgsl": "// Auto-generated by compiler/src/codegen/compute-gen.ts
// case() / ternary chain — first matching predicate wins.

@group(0) @binding(0) var<storage, read> feat_data: array<f32>;
@group(0) @binding(1) var<storage, read_write> out_color: array<u32>;
@group(0) @binding(2) var<uniform> u_count: vec4<u32>;

@compute @workgroup_size(64)
fn eval_case(@builtin(global_invocation_id) gid: vec3<u32>) {
  let fid = gid.x;
  if (fid >= u_count.x) { return; }
  let v_rank = feat_data[fid * 2u + 0u];
  let v_class = feat_data[fid * 2u + 1u];
  var color: vec4<f32>;
  if (v_rank == 0.0 && v_class == 1.0) { color = vec4<f32>(1.0, 0.0, 1.0, 1.0); }
  else { color = vec4<f32>(0.0, 0.0, 0.0, 1.0); }
  out_color[fid] = pack4x8unorm(color);
}
",
}
`;
