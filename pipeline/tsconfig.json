{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": [],
    // The offline CLI (tools/) + its src/ test consume the .xgcov codec via the barrel-free
    // '@xgis/data/coverage' subpath, whose canonical home is @xgis/data (A8). A devDependency
    // + this reference make that dev-time edge explicit and build-ordered; the shipped reader
    // (src, non-test) stays zero-dep. Point at data's EMITTED output (built first via the
    // reference), NOT its source — a source .ts would land outside pipeline's rootDir (TS6059).
    // Extensionless on purpose: `bun` honours these tsconfig paths at RUNTIME too (the CLI is a
    // bun subprocess), so it must resolve to the runtime `format.js` — a `.d.ts` here loads a
    // type-only module with no runtime exports (SyntaxError under bun ≥1.3.14). tsc still picks
    // the co-located `format.d.ts` for types.
    "paths": {
      "@xgis/data/coverage": ["../data/dist/coverage/format"]
    }
  },
  "references": [{ "path": "../data" }],
  "include": ["src/**/*.ts"]
}
