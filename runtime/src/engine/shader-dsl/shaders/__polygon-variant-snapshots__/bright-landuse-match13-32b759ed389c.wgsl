fn proj_oblique_mercator(lon_deg: f32, lat_deg: f32, clon: f32, clat: f32) -> vec2<f32> {
  let r = oblique_rot(lon_deg, lat_deg, clon, clat);
  return proj_oblique_mercator_d(r.x, r.y);
