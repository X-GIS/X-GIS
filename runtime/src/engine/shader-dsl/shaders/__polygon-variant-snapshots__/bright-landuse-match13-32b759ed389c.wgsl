fn center_cos_c(lon_deg: f32, lat_deg: f32, clon: f32, clat: f32) -> f32 {
  let lam = (lon_deg * DEG2RAD);
  let phi = (lat_deg * DEG2RAD);
  let l0 = (clon * DEG2RAD);
  let p0 = (clat * DEG2RAD);
  return ((sin(p0) * sin(phi)) + ((cos(p0) * cos(phi)) * cos((lam - l0))));
