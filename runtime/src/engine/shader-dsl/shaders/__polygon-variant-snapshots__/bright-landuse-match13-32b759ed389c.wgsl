  let y_val = (lat * (1.007226 + (lat2 * (0.015085 + (lat2 * ((-0.044475 + (lat2 * 0.028874)) - (lat4 * 0.005916)))))));
  return vec2<f32>((((lon_rel * DEG2RAD) * x_scale) * EARTH_R), (y_val * EARTH_R));
