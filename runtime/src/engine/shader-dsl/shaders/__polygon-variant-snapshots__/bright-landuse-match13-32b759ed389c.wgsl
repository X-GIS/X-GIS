fn proj_globe(lon_deg: f32, lat_deg: f32) -> vec3<f32> {
  let lam = (lon_deg * DEG2RAD);
  let phi = (lat_deg * DEG2RAD);
  let cphi = cos(phi);
  return vec3<f32>(((EARTH_R * cphi) * cos(lam)), ((EARTH_R * cphi) * sin(lam)), (EARTH_R * sin(phi)));
