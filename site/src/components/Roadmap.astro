---
import ContentBand from './kit/ContentBand.astro'
import SectionHead from './kit/SectionHead.astro'
import FeatureRow from './kit/FeatureRow.astro'

// Real X-GIS direction (grounded in the codebase + project goals) — vision-framed,
// NO dated promises. This is where the honest "future track" lives (custom layers
// / three.js interop is NOT built; it sits here as Planned, never claimed shipped).
const items: { num: string; title: string; status: string; body: string }[] = [
  {
    num: '01',
    title: 'Google-Earth-class 3D globe',
    status: 'In progress',
    body: 'Terrain, 3D tiles, streaming + LOD, and a fly-to camera on top of the ECEF globe that renders today.',
  },
  {
    num: '02',
    title: 'Custom layers',
    status: 'Planned',
    body: 'Draw your own three.js / Babylon.js / raw-WebGPU content on the map — the engine already exposes the render-pass seam to plug into.',
  },
  {
    num: '03',
    title: 'Full Mapbox parity',
    status: 'In progress',
    body: 'Close the gap from 175 supported to all 235 applicable style-spec properties.',
  },
  {
    num: '04',
    title: 'Embeddable engine',
    status: 'In progress',
    body: 'Split into @xgis/engine (RHI · passes · camera) + @xgis/map so the renderer drops into any app.',
  },
]
---

<ContentBand id="roadmap">
  <SectionHead
    num="06"
    eyebrow="Roadmap"
    title="Where it's headed."
    lead="Honest direction — what's shipping and what's next, no dated promises."
  />
  <div class="mt-10 sm:mt-14">
    {items.map((it) => (
      <FeatureRow num={it.num} title={it.title}>
        <p class="text-fg-dim text-[15px] leading-[1.6] max-w-[580px]">{it.body}</p>
        <span class="mt-3 inline-block font-mono text-[10.5px] uppercase tracking-[0.14em] text-fg-mute border border-line rounded-full px-2.5 py-0.5">
          {it.status}
        </span>
      </FeatureRow>
    ))}
  </div>
</ContentBand>
