---
// Beat 3 · "How it compiles" — the SHOW-THE-COMPILER beat (the TS
// "adopt gradually / progressive transform" analog). We display the
// REAL hero .xgis source (the exact source land … | fill-zinc-200 that
// the hero globe runs), state the truthful pipeline in one line, and
// hand off to the genuinely-live compile graph at /docs/concepts/compute
// (titled "Compile graph — live."). No fabricated WGSL is printed here —
// the honest move is to show the real input + a true description and let
// the live tool produce the output the visitor can poke. (REBUILD §6.)
import { ContentBand, SectionHead, Card } from '@/components/kit'

const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
const computeUrl = `${base}/docs/concepts/compute`

// The compiler stages, named truthfully. This is the real pass order in
// the compiler (lexer → parser → IR → optimizer → backends), surfaced as
// a label, not as invented output.
const stages = ['lexer', 'parser', 'IR', 'optimizer', 'WGSL + GLSL']
---

<ContentBand id="compiles">
  <SectionHead num="03" eyebrow="Show The Compiler"
    title="From source to shader."
    lead="The hero globe above is not a video — it is this exact source, compiled in your browser. Here is what the compiler does with it." />

  <div class="grid lg:grid-cols-2 gap-5 lg:gap-6 mt-14 lg:mt-18 items-start">
    <!-- LEFT · the real .xgis input (the hero source, verbatim). -->
    <Card padding="p-0" class="overflow-hidden">
      <div class="px-5 pt-4 pb-3 border-b border-line flex items-center justify-between">
        <span class="font-mono text-[11px] tracking-[0.16em] uppercase text-fg-mute">Input · land.xgis</span>
        <span class="font-mono text-[11px] tracking-[0.16em] uppercase text-fg-faint">source</span>
      </div>
      <pre class="xg m-0 px-5 py-5 font-mono text-[13px] leading-[1.7] text-fg overflow-x-auto"
><code><span class="kw">source</span> <span class="id">land</span> {`{`}
  <span class="kw">type</span><span class="pun">:</span> <span class="lit">geojson</span>
  <span class="kw">url</span><span class="pun">:</span> <span class="str">"data/land.geojson"</span>
{`}`}

<span class="kw">background</span> {`{`} <span class="kw">fill</span><span class="pun">:</span> <span class="str">#0a0a0a</span> {`}`}

<span class="kw">layer</span> <span class="id">continents</span> {`{`}
  <span class="kw">source</span><span class="pun">:</span> <span class="id">land</span>
  <span class="pun">|</span> <span class="util">fill-zinc-200</span>
{`}`}</code></pre>
    </Card>

    <!-- RIGHT · the truthful pipeline + the live hand-off. No fake output. -->
    <div class="flex flex-col h-full">
      <Card padding="p-6" class="flex-1 flex flex-col">
        <span class="font-mono text-[11px] tracking-[0.16em] uppercase text-fg-mute mb-5">The pipeline</span>

        <!-- The real pass order, as labels (not invented output). -->
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-2 mb-6">
          {stages.map((s, i) => (
            <li class="inline-flex items-center gap-2">
              <span class="font-mono text-[12.5px] text-fg">{s}</span>
              {i < stages.length - 1 && (
                <svg class="text-fg-faint shrink-0" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
              )}
            </li>
          ))}
        </ol>

        <p class="text-[14.5px] leading-[1.65] text-fg-dim">
          The source is tokenized, parsed, and lowered to one typed
          <span class="text-fg">IR</span>, optimized, then emitted as
          <span class="text-fg">WGSL</span> (WebGPU) and
          <span class="text-fg">GLSL ES 3.00</span> (WebGL2) — all at compile time,
          before a single frame draws.
        </p>

        <div class="mt-auto pt-7">
          <a href={computeUrl}
            class="group inline-flex items-center gap-2.5 px-4 h-10 rounded-full
                   bg-fg text-bg text-[13.5px] font-medium
                   transition-colors hover:bg-accent-hover">
            Watch it compile, live
            <svg class="transition-transform group-hover:translate-x-0.5 motion-reduce:transform-none" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
          </a>
          <p class="mt-3 font-mono text-[11px] tracking-[0.06em] text-fg-mute">
            Real tokens → AST → IR → plan → WGSL, recompiled as you type.
          </p>
        </div>
      </Card>
    </div>
  </div>
</ContentBand>

<style>
  /* .xgis token colours — illustrative accents from the muted palette
     (DESIGN.md), applied only inside code, never to chrome. Mirrors the
     hero / language-card highlighting so the source reads consistently. */
  .xg .kw   { color: #d97f4d; }
  .xg .id   { color: var(--color-fg); font-weight: 600; }
  .xg .util { color: #c79a63; }
  .xg .lit,
  .xg .str  { color: #c9b489; }
  .xg .pun  { color: var(--color-fg-faint); }
</style>
