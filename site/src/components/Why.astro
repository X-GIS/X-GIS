---
// Four parallel claims, not a sequence — so they carry map-legend
// category tags (what each IS), never 01/02/03 step numbers.
const pillars = [
  {
    tag: 'Declarative',
    title: 'Declarative, not procedural.',
    body: 'Write fill-red-500, stroke-black, opacity-80. Read the style — that is the program. No imperative API calls, no setter chains, no callback graph.',
  },
  {
    tag: 'Compiler',
    title: 'The compiler writes the shaders.',
    body: 'WGSL programs, buffer layouts, projection math, render strategies — all derived from your .xgis source. You never reach for a vertex shader.',
  },
  {
    tag: 'Projection',
    title: 'One source, any view.',
    body: 'Switch from Mercator to Orthographic to Natural Earth via a uniform. The same data renders to a flat map, a globe, or anywhere else — no re-tessellation.',
  },
  {
    tag: 'Expressions',
    title: 'Zoom is a function input.',
    body: 'opacity-[interpolate(zoom, 8, 40, 14, 100)]. Camera state is a runtime value the compiler can sample — same shape works for feature properties.',
  },
]
---

<section id="why" class="relative py-20 sm:py-32 lg:py-44 border-t border-line">

  <div class="max-w-[1000px] mx-auto px-6">

    <div class="max-w-[840px] mb-16 lg:mb-20">
      <!-- xAI eyebrow: GeistMono UPPERCASE tracked, the brand's signature label. -->
      <p class="font-mono uppercase tracking-[0.18em] text-[12px] text-fg-mute mb-6">
        01 · The Approach
      </p>
      <h2 class="font-display font-normal text-fg leading-[1.0] tracking-[-0.02em]
                 text-[40px] sm:text-[52px] lg:text-[64px]">
        Beyond the library.
      </h2>
      <p class="mt-6 text-[17px] sm:text-[19px] leading-[1.55] text-fg-dim max-w-[660px]">
        GIS rendering is locked to libraries. Mapbox, Deck.gl, OpenLayers — each has its own
        API, style format, and shader constraints. Switching means rewriting everything.
        X-GIS answers with a <em class="text-fg not-italic font-medium border-b border-accent/50">language</em>
        instead of an API.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-x-12 gap-y-12 lg:gap-y-14">
      {pillars.map(p => (
        <article class="relative border-t border-line pt-6">
          <div class="mb-4">
            <span class="font-mono text-[11px] tracking-[0.16em] uppercase text-fg-mute">{p.tag}</span>
          </div>
          <h3 class="text-[20px] sm:text-[22px] font-normal text-fg leading-[1.3] tracking-[-0.01em] mb-3">
            {p.title}
          </h3>
          <p class="text-[15px] leading-[1.65] text-fg-dim">
            {p.body}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
