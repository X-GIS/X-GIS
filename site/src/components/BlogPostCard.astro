---
// Shared blog post card — a bordered grid card used by /blog and
// /blog/tags/[tag] so the two listings can't drift. The whole card links
// to the post via a stretched link on the title (`after:inset-0`); the
// tag chips stay independently clickable by sitting on their own stacking
// layer (relative z-[1]) above that overlay.
import { readingTimeMin } from '../lib/blog'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
---

<article class="group relative flex flex-col h-full bg-bg-card border border-line rounded-[10px] p-6 hover:border-line-strong transition-colors">
  <p class="font-mono text-[11px] tracking-[0.14em] uppercase text-fg-mute">
    <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
    <span> · {readingTimeMin(post.body)} min read</span>
  </p>
  <h3 class="mt-2.5 font-display font-normal text-fg text-[21px] leading-[1.15] tracking-[-0.01em]">
    <a
      href={`${base}/blog/${post.id}`}
      class="after:absolute after:inset-0 after:content-[''] group-hover:text-accent transition-colors"
    >
      {post.data.title}
    </a>
  </h3>
  <p class="mt-2.5 text-[14.5px] leading-[1.55] text-fg-dim line-clamp-3">
    {post.data.description}
  </p>
  {post.data.tags.length > 0 && (
    <div class="relative z-[1] mt-auto pt-5 flex flex-wrap gap-1.5">
      {post.data.tags.slice(0, 4).map((t) => (
        <a
          href={`${base}/blog/tags/${t}`}
          class="font-mono text-[10.5px] tracking-[0.1em] uppercase text-fg-mute border border-line rounded-full px-2 py-0.5 hover:text-fg hover:border-line-strong transition-colors"
        >
          {t}
        </a>
      ))}
    </div>
  )}
</article>
