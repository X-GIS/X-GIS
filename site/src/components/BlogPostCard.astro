---
// Shared blog post card — a bordered grid card used by /blog and
// /blog/tags/[tag] so the two listings can't drift. The whole card links
// to the post via a stretched link on the title (`after:inset-0`); the
// tag chips stay independently clickable by sitting on their own stacking
// layer (relative z-[1]) above that overlay. Tags read as quiet metadata
// (no chip border) — the bordered "filter" pills live only in the blog
// index's tag row, so the two roles stay visually distinct.
import { readingTimeMin } from '../lib/blog'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
---

<article class="group relative flex flex-col h-full bg-bg-card border border-line rounded-[8px] p-6 transition-[border-color,transform] duration-200 hover:border-line-strong hover:-translate-y-0.5">
  {post.data.tags[0] && (
    <p class="font-mono text-[11px] tracking-[0.16em] uppercase text-accent">{post.data.tags[0]}</p>
  )}
  <p class="mt-2 font-mono text-[11px] tracking-[0.14em] uppercase text-fg-mute">
    {readingTimeMin(post.body)} min read
    <span aria-hidden="true"> · </span>
    <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
  </p>
  <h3 class="mt-2.5 font-display font-normal text-fg text-[21px] leading-[1.15] tracking-[-0.015em] text-balance">
    <a
      href={`${base}/blog/${post.id}`}
      class="after:absolute after:inset-0 after:content-[''] group-hover:text-accent transition-colors"
    >
      {post.data.title}
    </a>
  </h3>
  <p class="mt-3 text-[14.5px] leading-[1.55] text-fg-dim line-clamp-3">
    {post.data.description}
  </p>
  {post.data.tags.length > 1 && (
    <div class="relative z-[1] mt-auto pt-5 flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[10.5px] tracking-[0.12em] uppercase text-fg-mute">
      {post.data.tags.slice(1, 4).map((t, i) => (
        <>
          {i > 0 && <span aria-hidden="true">·</span>}
          <a href={`${base}/blog/tags/${t}`} class="hover:text-fg transition-colors">{t}</a>
        </>
      ))}
    </div>
  )}
</article>
