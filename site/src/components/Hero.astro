---
const githubUrl = 'https://github.com/X-GIS/X-GIS'
const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
const docsUrl = `${base}/docs`
const examplesUrl = `${base}/examples`
const convertUrl = `${base}/convert`
---

<section class="relative min-h-[100svh] flex items-center justify-center overflow-hidden pt-24 pb-20">
  <div class="relative w-full max-w-[1080px] mx-auto px-6 text-center">

    <!-- Eyebrow: a chart legend tag. The vermilion lozenge is the same
         pen that marks the live projection below — one accent, one story. -->
    <p class="fade-up inline-flex items-center gap-2.5 font-mono text-[11px] tracking-[0.22em] text-fg-mute uppercase mb-7"
       style="animation-delay: 80ms">
      <span class="inline-block w-2 h-2 rotate-45 bg-vermilion"></span>
      Introducing X-GIS
    </p>

    <!-- The thesis, set in the chart title-block face. Condensed, so it
         goes big. The subject's own headline — said plainly, drawn large. -->
    <h1 class="fade-up font-display font-semibold uppercase text-fg leading-[0.88] tracking-[0.005em]
               text-[44px] sm:text-[80px] md:text-[104px] lg:text-[132px] xl:text-[150px]"
        style="animation-delay: 200ms">
      A language for<br />cartography
    </h1>

    <p class="fade-up mt-8 mx-auto max-w-[600px] text-[17px] sm:text-[20px] leading-[1.5] text-fg-dim"
       style="animation-delay: 340ms">
      Declare what your map should look like. The compiler emits the
      WGSL shaders, buffer layouts, and projection math.
    </p>

    <div class="fade-up mt-10 flex flex-wrap items-center justify-center gap-3.5"
         style="animation-delay: 480ms">
      <a
        href={docsUrl}
        class="inline-flex items-center gap-2 px-6 h-11 rounded-md
               bg-accent hover:bg-accent-hover active:bg-accent-press
               text-bg text-[15px] font-semibold transition-colors"
      >
        Read the docs
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
      </a>
      <a
        href={examplesUrl}
        class="inline-flex items-center gap-2 px-5 h-11 rounded-md border border-line-strong
               text-fg hover:border-accent hover:text-accent text-[15px] font-medium transition-colors"
      >
        View examples
      </a>
      <a
        href={convertUrl}
        class="inline-flex items-center gap-1.5 px-3 h-11
               text-fg-mute hover:text-fg text-[15px] font-medium transition-colors"
      >
        Convert from Mapbox
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
      </a>
    </div>

    <!-- The signature: one source, rendered live across projections. The
         .xgis above never changes; the chart below morphs globe → flat →
         globe while the legend reads out the active view. "One source,
         any view" — shown, not claimed. -->
    <div class="scale-fade mt-16 sm:mt-20 mx-auto max-w-[680px] text-left"
         style="animation-delay: 640ms">
      <div class="rounded-xl bg-bg-card border border-line overflow-hidden shadow-[0_24px_60px_-24px_rgba(0,0,0,0.7)]">
        <pre class="m-0 px-7 py-6 font-mono text-[13.5px] sm:text-[14.5px] leading-[1.8] text-fg whitespace-pre overflow-x-auto"
><code><span class="kw">source</span> <span class="id">land</span> {`{`}
  <span class="kw">type</span><span class="pun">:</span> <span class="lit">geojson</span>
  <span class="kw">url</span><span class="pun">:</span> <span class="str">"data/land.geojson"</span>
{`}`}

<span class="kw">layer</span> <span class="id">continents</span> {`{`}
  <span class="kw">source</span><span class="pun">:</span> <span class="id">land</span>
  <span class="pun">|</span> <span class="util">fill-zinc-200</span>
{`}`}</code></pre>

        <div class="border-t border-line"></div>

        <div class="relative bg-bg">
          <canvas
            id="hero-map"
            class="block w-full opacity-0 transition-opacity duration-300"
            style="height: 300px; touch-action: none;"
          ></canvas>
          <div
            id="hero-map-fallback"
            class="absolute inset-0 flex items-center justify-center text-fg-mute text-[12px] font-mono uppercase tracking-[0.16em] pointer-events-none"
          >
            Compiling…
          </div>
        </div>

        <!-- Title block / legend: the chart's frame metadata. -->
        <div class="flex items-center justify-between gap-4 border-t border-line px-5 py-2.5 font-mono text-[10.5px] uppercase tracking-[0.16em] text-fg-mute">
          <span>Source · land.geojson</span>
          <span class="inline-flex items-center gap-2">
            Projection
            <span id="hero-proj-marker" class="marker-pulse inline-block w-1.5 h-1.5 rounded-full bg-vermilion"></span>
            <span id="hero-proj-name" class="text-fg-dim w-[92px] text-left">Globe</span>
          </span>
        </div>
      </div>

      <p class="mt-5 text-center text-[12px] text-fg-mute">
        Drag, zoom, explore. &nbsp;
        <a href={examplesUrl} class="text-accent hover:text-accent-hover transition-colors inline-flex items-center gap-1">
          See more examples
          <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
        </a>
      </p>
    </div>

    <p class="fade-up mt-10 font-mono text-[11px] tracking-[0.16em] uppercase text-fg-faint"
       style="animation-delay: 820ms">
      WebGPU&nbsp; · &nbsp;Seven projections&nbsp; · &nbsp;MIT
    </p>
  </div>
</section>

<script>
  // Lazy-mount @xgis/runtime (~397 KB) off the landing-route critical
  // path: mount when the canvas nears the viewport / the user touches it,
  // never on first paint. Once mounted, the chart auto-cycles projections
  // to demonstrate "one source, any view" — paused on user interaction
  // (they're exploring) and when the tab is hidden.
  type XGISMapType = import('@xgis/runtime').XGISMap

  const canvas = document.getElementById('hero-map') as HTMLCanvasElement | null
  const fallback = document.getElementById('hero-map-fallback')
  const projName = document.getElementById('hero-proj-name')

  // [projection id, display label] — a visually distinct quartet that
  // takes the same land source from sphere to plane and back.
  const CYCLE: [string, string][] = [
    ['globe', 'Globe'],
    ['natural_earth', 'Natural Earth'],
    ['mercator', 'Mercator'],
    ['orthographic', 'Orthographic'],
  ]

  if (canvas) {
    let mountedMap: XGISMapType | null = null
    let mountStarted = false
    let cycleTimer: ReturnType<typeof setTimeout> | null = null
    let cycleIdx = 0
    let userTookOver = false
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const stopCycle = (): void => {
      if (cycleTimer) { clearTimeout(cycleTimer); cycleTimer = null }
    }

    // Cross-fade the canvas, swap projection at the dark point, fade back.
    const advance = (): void => {
      if (!mountedMap || userTookOver || document.hidden) return
      cycleIdx = (cycleIdx + 1) % CYCLE.length
      const [id, label] = CYCLE[cycleIdx]
      canvas.style.opacity = '0'
      window.setTimeout(() => {
        if (!mountedMap || userTookOver) return
        mountedMap.setProjection(id)
        // Re-center so each view frames the whole world the same way.
        const c = mountedMap.getCamera()
        c.zoom = 1; c.centerX = 0; c.centerY = 0
        mountedMap.markCameraPositioned()
        mountedMap.invalidate()
        if (projName) projName.textContent = label
        canvas.style.opacity = '1'
        cycleTimer = window.setTimeout(advance, 3600)
      }, 280)
    }

    const startMount = async (): Promise<void> => {
      if (mountStarted) return
      mountStarted = true
      try {
        const { XGISMap } = await import('@xgis/runtime')

        // Wheel-zoom focal-point fix: the runtime feeds WheelEvent
        // clientX/Y straight into zoomAt, which wants canvas-local CSS
        // px. For a centered hero canvas that is off by canvasLeft/Top.
        // Capture + stopImmediatePropagation blocks the runtime listener;
        // we re-dispatch with corrected coords. Touching the canvas also
        // hands control to the user — the auto-cycle stops.
        canvas.addEventListener('wheel', (e) => {
          e.preventDefault()
          e.stopImmediatePropagation()
          if (!mountedMap) return
          userTookOver = true; stopCycle()
          const rect = canvas.getBoundingClientRect()
          const delta = -e.deltaY * (e.deltaMode === 1 ? 0.05 : 0.003)
          mountedMap.getCamera().zoomAt(
            Math.max(-1, Math.min(1, delta)),
            e.clientX - rect.left, e.clientY - rect.top,
            canvas.width, canvas.height,
          )
        }, { capture: true, passive: false })

        const baseUrl = window.location.pathname.endsWith('/')
          ? window.location.pathname
          : window.location.pathname.substring(0, window.location.pathname.lastIndexOf('/') + 1)

        const source = `source land {
  type: geojson
  url: "data/land.geojson"
}

layer continents {
  source: land
  | fill-zinc-200
}`

        mountedMap = new XGISMap(canvas)
        await mountedMap.run(source, baseUrl)
        mountedMap.setProjection(CYCLE[0][0])
        const c = mountedMap.getCamera()
        c.zoom = 1; c.centerX = 0; c.centerY = 0
        mountedMap.markCameraPositioned()
        mountedMap.invalidate()
        canvas.style.opacity = '1'
        if (fallback) fallback.style.display = 'none'
        if (projName) projName.textContent = CYCLE[0][1]

        // Auto-cycle unless the user prefers reduced motion (then the
        // chart sits still on the globe — the readout still labels it).
        if (!reduceMotion) cycleTimer = window.setTimeout(advance, 3600)
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) stopCycle()
          else if (!userTookOver && !reduceMotion && !cycleTimer) cycleTimer = window.setTimeout(advance, 1200)
        })
      } catch (err) {
        console.warn('[hero-map]', err)
        if (fallback) fallback.textContent = 'Map preview unavailable'
      }
    }

    // Defer the runtime import past the entrance-animation tail (~2.2s),
    // with requestIdleCallback to pick the actual dispatch moment.
    // Interaction shortcuts both.
    const requestIdle = (window as { requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => void }).requestIdleCallback
      ?? ((cb: () => void) => setTimeout(cb, 0))
    setTimeout(() => requestIdle(() => { startMount() }, { timeout: 1500 }), 2200)

    const onInteract = (): void => {
      userTookOver = true; stopCycle()
      canvas.removeEventListener('pointerdown', onInteract)
      startMount()
    }
    canvas.addEventListener('pointerdown', onInteract, { once: true, passive: true })
    canvas.addEventListener('focus', () => startMount(), { once: true })
  }
</script>

<style>
  /* .xgis token coloring — tuned to the Chart Room palette. Keywords in
   * the surveyor's pen, utilities in phosphor cyan, literals in chart
   * annotation sand. */
  pre .kw   { color: #ff8a6b; }
  pre .id   { color: var(--color-fg); font-weight: 600; }
  pre .util { color: #6fe3da; }
  pre .lit, pre .str { color: #d8c79a; }
  pre .pun  { color: var(--color-fg-faint); }
</style>
