---
const cloneCmd = 'git clone https://github.com/X-GIS/X-GIS && cd X-GIS && bun install && bun run dev'
const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
const docsUrl = `${base}/docs`
---

<section id="install" class="relative py-20 sm:py-32 lg:py-44 border-t border-line">

  <div class="max-w-[1200px] mx-auto px-6">

    <div class="max-w-[840px] mb-12 lg:mb-16">
      <p class="font-mono uppercase tracking-[0.18em] text-[12px] text-fg-mute mb-6">
        08 · Get Started
      </p>
      <h2 class="font-display font-normal text-fg leading-[1.0] tracking-[-0.02em]
                 text-[40px] sm:text-[52px] lg:text-[64px]">
        Clone, install, run.
      </h2>
      <p class="mt-5 text-[15px] text-fg-mute">
        npm release is in flight; for now the playground is the way in.
      </p>
    </div>

    <!-- Clone + install + dev in one block — the only working install
         path until the package lands on npm. -->
    <div class="max-w-[720px]">
      <div class="rounded-[8px] bg-bg-card border border-line p-1.5">
        <div class="rounded-[6px] bg-bg px-6 py-5 flex items-start gap-4">
          <span class="text-vermilion font-mono text-[15px] select-none pt-px">$</span>
          <code class="flex-1 font-mono text-[13.5px] sm:text-[14.5px] text-fg whitespace-pre-wrap break-words leading-[1.65]"
>git clone <span class="text-accent">https://github.com/X-GIS/X-GIS</span>
cd X-GIS
bun install
bun run dev</code>
          <button
            type="button"
            class="copy-btn shrink-0 inline-flex items-center gap-1.5 px-3.5 h-8 rounded-full
                   text-[12px] font-medium text-fg-dim hover:text-fg
                   border border-line hover:border-line-strong transition-colors"
            data-copy={cloneCmd}
            aria-label="Copy clone + install command"
          >
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            <span class="copy-label">Copy</span>
          </button>
        </div>
      </div>

      <p class="mt-4 font-mono text-[11px] tracking-[0.08em] text-fg-mute">
        Bun workspace · dev server boots the playground at localhost:3000
      </p>
    </div>

    <!-- The actual public API, two lines. -->
    <div class="max-w-[720px] mt-12">
      <div class="rounded-[8px] bg-bg-card border border-line overflow-hidden">
        <pre class="px-7 py-6 font-mono text-[13.5px] sm:text-[14.5px] leading-[1.8] text-fg overflow-x-auto"
><code><span class="cs-kw">import</span> {`{`} XGISMap {`}`} <span class="cs-kw">from</span> <span class="cs-str">"@xgis/runtime"</span>

<span class="cs-kw">const</span> map = <span class="cs-kw">new</span> <span class="cs-fn">XGISMap</span>(canvas)
<span class="cs-kw">await</span> map.<span class="cs-fn">run</span>(source, baseUrl)</code></pre>
      </div>

      <p class="mt-4 font-mono text-[11px] tracking-[0.08em] text-fg-mute">
        WebGPU when available · Canvas 2D fallback when not
      </p>
    </div>

    <div class="mt-14">
      <a
        href={docsUrl}
        class="inline-flex items-center gap-2 text-accent hover:text-accent-hover text-[15px] font-medium transition-colors"
      >
        Read the documentation
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? ''
      try {
        await navigator.clipboard.writeText(text)
        const label = btn.querySelector('.copy-label') as HTMLElement | null
        if (!label) return
        const original = label.textContent
        label.textContent = 'Copied'
        btn.classList.add('text-accent')
        setTimeout(() => {
          label.textContent = original
          btn.classList.remove('text-accent')
        }, 1400)
      } catch {
        /* clipboard denied (insecure context, etc.) — fail silently */
      }
    })
  })
</script>

<style>
  pre .cs-kw  { color: #ff8a6b; }
  pre .cs-str { color: #d8c79a; }
  pre .cs-fn  { color: var(--color-accent); }
</style>
