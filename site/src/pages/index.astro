---
import Base from '../layouts/Base.astro'
import Graticule from '../components/Graticule.astro'
import Header from '../components/Header.astro'
import Hero from '../components/react/Hero.tsx'
import WhatIsXGIS from '../components/WhatIsXGIS.astro'
import HowItCompiles from '../components/HowItCompiles.astro'
import BecomesShaders from '../components/BecomesShaders.astro'
import Coverage from '../components/Coverage.astro'
import Roadmap from '../components/Roadmap.astro'
import Showcase from '../components/Showcase.astro'
import QuickStart from '../components/QuickStart.astro'
import Footer from '../components/Footer.astro'
// Demo-forward home (REBUILD §4 — the "code → render" arc). Every beat is
// either a live X-GIS render or a real compiler artifact, composed on the
// xAI kit (ContentBand · SectionHead · Card) for one uniform rhythm:
//   1 Hero            — live globe, one source cycling projections (React island)
//   2 What is X-GIS   — language / compiler / globe, three cards
//   3 How it compiles — the real .xgis → truthful pipeline → live compile graph
//   4 Becomes shaders — one IR → WGSL + GLSL ES 3.00 (the "TS becomes JS" beat)
//   5 Mapbox-compatible — the honest spec-coverage figures (derived from MAPBOX_COVERAGE)
//   6 Roadmap         — where it's headed (vision; the future-track lives here)
//   7 Examples        — live gallery teaser
//   8 Get started     — install / docs CTAs
// The hero is hydrated; everything below is static Astro inheriting the
// tokens. Nav still anchors #install (QuickStart).
const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
---

<Base>
  <Graticule />
  <Header />
  <main>
    <Hero client:load docsUrl={`${base}/docs`} examplesUrl={`${base}/examples`} convertUrl={`${base}/convert`} />
    <WhatIsXGIS />
    <HowItCompiles />
    <BecomesShaders />
    <Coverage />
    <Roadmap />
    <Showcase />
    <QuickStart />
  </main>
  <Footer />
</Base>
