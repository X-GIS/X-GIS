---
import Base from '../layouts/Base.astro'
import Graticule from '../components/Graticule.astro'
import Header from '../components/Header.astro'
import Hero from '../components/react/Hero.tsx'
import Why from '../components/Why.astro'
import Capabilities from '../components/Capabilities.astro'
import Showcase from '../components/Showcase.astro'
import Coverage from '../components/Coverage.astro'
import QuickStart from '../components/QuickStart.astro'
import Footer from '../components/Footer.astro'
// "Drafting Table" landing. The narrative: live hero map → why a language
// (Why) → the language shown in real .xgis (Capabilities) → live example
// gallery (Showcase) → the full shipped surface (Coverage) → install. The
// hero is a hydrated React island; the rest is static Astro inheriting the
// palette through the shared tokens.
const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
---

<Base>
  <Graticule />
  <Header />
  <main>
    <Hero client:load docsUrl={`${base}/docs`} examplesUrl={`${base}/examples`} convertUrl={`${base}/convert`} />
    <Why />
    <Capabilities />
    <Showcase />
    <Coverage />
    <QuickStart />
  </main>
  <Footer />
</Base>
