---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
// Build-time only: emit WGSL / GLSL / reflection from the SAME example modules the CLI and
// the e2e render-gate use. The client ships just the emitted GLSL + a tiny WebGL2 runner —
// @xgis/shader-dsl never reaches the browser bundle. Relative imports (workspace src),
// matching how the site resolves @xgis/runtime.
import { examples } from '../../../shader-dsl/examples/index.ts'
import { emitModule, emitGlslModule, reflect } from '../../../shader-dsl/src/index.ts'

// Raw example sources for the "DSL (TypeScript)" tab — globbed as text at build time.
const rawSources = import.meta.glob('../../../shader-dsl/examples/*.ts', {
  query: '?raw', import: 'default', eager: true,
}) as Record<string, string>
const sourceByFile = Object.fromEntries(
  Object.entries(rawSources).map(([p, src]) => [p.split('/').pop()!, src]),
)

const cards = examples.map((ex) => ({
  ...ex,
  source: sourceByFile[ex.file] ?? '',
  wgsl: emitModule(ex.module),
  glsl: ex.renderable
    ? `// ─────────── vertex ───────────\n${emitGlslModule(ex.module, 'vertex')}\n// ────────── fragment ──────────\n${emitGlslModule(ex.module, 'fragment')}`
    : null,
  reflection: JSON.stringify(reflect(ex.module), null, 2),
}))

// Compact render spec for the client (renderables only): GLSL + reflection + controls.
const runtimeSpecs = cards
  .filter((c) => c.renderable)
  .map((c) => ({
    id: c.id,
    vertex: emitGlslModule(c.module, 'vertex'),
    fragment: emitGlslModule(c.module, 'fragment'),
    reflection: reflect(c.module),
    controls: c.controls ?? {},
  }))

const groups = [
  {
    key: 'cartographic',
    title: 'Cartographic shaders',
    body: 'The GPU code behind a map — a graticule, shaded relief, a choropleth colour ramp. All procedural, so they render live with no data and no tiles.',
  },
  {
    key: 'generic',
    title: 'General shaders',
    body: 'The DSL is content-free: the same authoring surface, used as a plain shader toolkit.',
  },
  {
    key: 'compute',
    title: 'Compute (WebGPU)',
    body: 'GPGPU kernels. GLSL ES 3.00 has no compute, so the DSL fails closed for WebGL2 — these show the WGSL + reflection face of the same source.',
  },
] as const

const sliderControls = (c: typeof cards[number]) =>
  Object.entries(c.controls ?? {}).filter(([, ctl]) => ctl.kind === 'slider') as [string, Extract<typeof c.controls[string], { kind: 'slider' }>][]

const tabsFor = (c: typeof cards[number]) => [
  { id: 'dsl', label: 'DSL (TypeScript)' },
  { id: 'wgsl', label: 'WGSL' },
  ...(c.glsl ? [{ id: 'glsl', label: 'GLSL ES 3.00' }] : []),
  { id: 'reflect', label: 'Reflection' },
]
---

<Base
  title="X-GIS — Shader DSL"
  description="Author a GPU shader in TypeScript and watch it compile, live, to WGSL (WebGPU) and GLSL ES 3.00 (WebGL2). The engine that renders every X-GIS map — runnable in your browser, on mobile."
>
  <Header />

  <main class="pt-24 pb-32">
    <!-- Hero -->
    <section class="max-w-[820px] mx-auto px-6 mb-16">
      <p class="text-[13px] font-medium tracking-[-0.01em] text-accent mb-4">Shader DSL</p>
      <h1 class="font-medium text-fg leading-[1.05] tracking-[-0.035em] text-[40px] sm:text-[56px] lg:text-[64px]">
        Shaders, authored in <span class="font-mono">TypeScript</span>.
      </h1>
      <p class="mt-6 text-[17px] sm:text-[18px] leading-[1.55] text-fg-dim">
        Every X-GIS map is drawn by shaders this DSL emits. Author a typed shader once; it
        compiles to <span class="text-fg font-medium">WGSL</span> for WebGPU and
        <span class="text-fg font-medium">GLSL ES 3.00</span> for WebGL2, and reflects its own
        pipeline layout. Below, each example runs live on your device — drag a slider and watch.
      </p>
      <p class="mt-4 text-[13px] text-fg-mute font-mono">
        Live render = WebGL2 · one DSL source → two backends · reflection-driven uniforms
      </p>
    </section>

    {groups.map((group) => {
      const groupCards = cards.filter((c) => c.category === group.key)
      if (groupCards.length === 0) return null
      return (
        <section class="max-w-[1100px] mx-auto px-6 mb-20">
          <h2 class="text-[26px] sm:text-[30px] font-medium text-fg leading-[1.2] tracking-[-0.02em] mb-2">
            {group.title}
          </h2>
          <p class="text-[15px] leading-[1.6] text-fg-dim mb-8 max-w-[720px]">{group.body}</p>

          <div class="grid lg:grid-cols-2 gap-6">
            {groupCards.map((c) => (
              <article data-card={c.id} class="rounded-2xl bg-bg-card border border-line overflow-hidden flex flex-col">
                <div class="p-5 pb-3">
                  <div class="flex items-center gap-2 mb-2">
                    <h3 class="text-[18px] font-medium text-fg tracking-[-0.015em]">{c.title}</h3>
                    <span class="font-mono text-[10px] text-fg-mute uppercase tracking-wider px-1.5 py-0.5 rounded bg-bg-elev border border-line">
                      {c.id}.ts
                    </span>
                  </div>
                  <p class="text-[13.5px] leading-[1.55] text-fg-dim">{c.blurb}</p>
                </div>

                {c.renderable && (
                  <div class="px-5">
                    <div class="relative rounded-xl overflow-hidden bg-bg-elev border border-line" style="aspect-ratio: 16 / 10;">
                      <canvas
                        data-shader={c.id}
                        class="block w-full h-full"
                        style="touch-action: none;"
                      ></canvas>
                      <span class="absolute top-2.5 left-2.5 inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-bg/80 backdrop-blur text-accent text-[10px] font-medium tracking-wide uppercase pointer-events-none">
                        <span class="w-1.5 h-1.5 rounded-full bg-accent inline-block animate-pulse"></span>
                        Live
                      </span>
                      <div
                        data-error={c.id}
                        hidden
                        class="absolute inset-0 flex items-center justify-center p-4 text-center text-fg-mute text-[12px] font-mono bg-bg-elev"
                      ></div>
                    </div>

                    {sliderControls(c).length > 0 && (
                      <div class="mt-4 space-y-3">
                        {sliderControls(c).map(([field, ctl]) => (
                          <label class="block">
                            <span class="flex items-center justify-between text-[12px] text-fg-dim mb-1.5">
                              <span>{ctl.label}</span>
                              <span class="font-mono text-fg-mute" data-value={field}>{ctl.value}</span>
                            </span>
                            <input
                              type="range"
                              data-field={field}
                              min={ctl.min}
                              max={ctl.max}
                              step={ctl.step}
                              value={ctl.value}
                              class="shader-range w-full"
                            />
                          </label>
                        ))}
                      </div>
                    )}
                  </div>
                )}

                {!c.renderable && (
                  <div class="px-5">
                    <div class="rounded-xl bg-bg-elev border border-line px-4 py-3 text-[12.5px] leading-[1.5] text-fg-mute">
                      WebGPU / compute only — no WebGL2 live render. The WGSL + reflection below
                      are emitted from the same DSL source.
                    </div>
                  </div>
                )}

                <!-- Code tabs -->
                <div class="px-5 pt-4 pb-5 mt-auto">
                  <div data-tabs={c.id} role="tablist" class="flex gap-1 overflow-x-auto no-scrollbar mb-2 -mx-1 px-1">
                    {tabsFor(c).map((tab, i) => (
                      <button
                        type="button"
                        role="tab"
                        data-tab={tab.id}
                        aria-selected={i === 0 ? 'true' : 'false'}
                        class="shrink-0 text-[12px] font-medium px-2.5 py-1 rounded-md transition-colors"
                      >
                        {tab.label}
                      </button>
                    ))}
                  </div>
                  <div class="rounded-lg bg-bg-elev border border-line overflow-hidden">
                    <pre data-panel="dsl" class="shader-code"><code>{c.source}</code></pre>
                    <pre data-panel="wgsl" hidden class="shader-code"><code>{c.wgsl}</code></pre>
                    {c.glsl && <pre data-panel="glsl" hidden class="shader-code"><code>{c.glsl}</code></pre>}
                    <pre data-panel="reflect" hidden class="shader-code"><code>{c.reflection}</code></pre>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      )
    })}

    <!-- Footer pointer -->
    <section class="max-w-[820px] mx-auto px-6 mt-12 pt-12 border-t border-line">
      <p class="text-[14px] leading-[1.6] text-fg-dim">
        These examples live in
        <a href="https://github.com/X-GIS/X-GIS/tree/main/shader-dsl/examples" target="_blank" rel="noopener" class="text-accent hover:text-accent-hover transition-colors">shader-dsl/examples</a>.
        Run them in a terminal with <code class="font-mono text-[13px] text-fg">npx tsx examples/print.ts</code>
        to print the emitted WGSL, GLSL, and reflection.
      </p>
    </section>
  </main>

  <Footer />
</Base>

<script type="application/json" id="shader-specs" set:html={JSON.stringify(runtimeSpecs)}></script>

<script>
  import { mountShader, type RenderSpec } from '../lib/shader-playground'

  const raw = document.getElementById('shader-specs')?.textContent
  const specs: RenderSpec[] = raw ? JSON.parse(raw) : []

  // Tab switching — every card (renderable or not).
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((tabbar) => {
    const card = tabbar.closest('[data-card]')
    if (!card) return
    const buttons = Array.from(tabbar.querySelectorAll<HTMLButtonElement>('button[data-tab]'))
    const panels = Array.from(card.querySelectorAll<HTMLElement>('[data-panel]'))
    const select = (tab: string): void => {
      buttons.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === tab)))
      panels.forEach((p) => { p.hidden = p.dataset.panel !== tab })
    }
    buttons.forEach((b) => b.addEventListener('click', () => select(b.dataset.tab!)))
  })

  // Live renderers.
  for (const spec of specs) {
    const canvas = document.querySelector<HTMLCanvasElement>(`canvas[data-shader="${spec.id}"]`)
    const card = canvas?.closest('[data-card]')
    if (!canvas || !card) continue

    const sliders: Record<string, number> = {}
    card.querySelectorAll<HTMLInputElement>('input[type="range"][data-field]').forEach((input) => {
      const field = input.dataset.field!
      sliders[field] = parseFloat(input.value)
      const out = card.querySelector<HTMLElement>(`[data-value="${field}"]`)
      input.addEventListener('input', () => {
        sliders[field] = parseFloat(input.value)
        if (out) out.textContent = input.value
      })
    })

    try {
      mountShader(canvas, spec, sliders)
    } catch (err) {
      const overlay = card.querySelector<HTMLElement>('[data-error]')
      if (overlay) {
        overlay.textContent = err instanceof Error ? err.message : 'Failed to render this shader.'
        overlay.hidden = false
      }
    }
  }
</script>

<style>
  .shader-code {
    margin: 0;
    padding: 0.85rem 0.95rem;
    max-height: 320px;
    overflow: auto;
    font-family: "DM Mono", "Fira Code", monospace;
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-fg-dim);
    white-space: pre;
    tab-size: 2;
  }
  .no-scrollbar { scrollbar-width: none; }
  .no-scrollbar::-webkit-scrollbar { display: none; }

  /* Tab buttons: selected = accent text on a subtle fill. */
  [role="tab"] { color: var(--color-fg-mute); }
  [role="tab"]:hover { color: var(--color-fg-dim); }
  [role="tab"][aria-selected="true"] {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  /* Range slider — large touch target, accent thumb. */
  .shader-range {
    -webkit-appearance: none;
    appearance: none;
    height: 4px;
    border-radius: 999px;
    background: var(--color-line-strong);
    outline: none;
  }
  .shader-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-accent);
    cursor: pointer;
    border: 3px solid var(--color-bg-card);
  }
  .shader-range::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border: 3px solid var(--color-bg-card);
    border-radius: 50%;
    background: var(--color-accent);
    cursor: pointer;
  }
</style>
