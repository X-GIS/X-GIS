---
import Docs from '../../layouts/Docs.astro'
import Callout from '../../components/Callout.astro'
import { MAPBOX_COVERAGE, type CoverageStatus, type CoverageImpact } from '@xgis/compiler'

const base = import.meta.env.BASE_URL.replace(/\/+$/, '')

// Headings for the right-side On-this-page TOC — one entry per
// coverage section.
const headings = [
  { depth: 2, slug: 'summary', text: 'Summary' },
  ...MAPBOX_COVERAGE.map(s => ({ depth: 2, slug: s.id, text: s.title })),
]

// Compute coverage counts for the summary band.
const totals = { supported: 0, partial: 0, unsupported: 0, na: 0 }
for (const section of MAPBOX_COVERAGE) {
  for (const e of section.entries) totals[e.status]++
}
const total = totals.supported + totals.partial + totals.unsupported + totals.na
// Coverage % is quoted against APPLICABLE properties (excluding n/a — Mapbox-only
// concepts with no xgis equivalent), matching the figures the marketing pages
// (Coverage.astro, why.astro) state: 175 / 235 ≈ 74%, not 175 / 242.
const applicable = total - totals.na

const statusBadge = (s: CoverageStatus): { label: string; cls: string } => {
  switch (s) {
    case 'supported':   return { label: 'supported',   cls: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30' }
    case 'partial':     return { label: 'partial',     cls: 'bg-amber-500/15 text-amber-300 border-amber-500/30' }
    case 'unsupported': return { label: 'unsupported', cls: 'bg-rose-500/15 text-rose-300 border-rose-500/30' }
    case 'na':          return { label: 'n/a',         cls: 'bg-bg-elev text-fg-mute border-line' }
  }
}
const impactBadge = (i?: CoverageImpact): { label: string; cls: string } | null => {
  if (!i) return null
  switch (i) {
    case 'high':   return { label: 'high',   cls: 'bg-rose-500/10 text-rose-300/90 border-rose-500/20' }
    case 'medium': return { label: 'medium', cls: 'bg-amber-500/10 text-amber-300/90 border-amber-500/20' }
    case 'low':    return { label: 'low',    cls: 'bg-bg-elev text-fg-mute border-line' }
  }
}
---

<Docs
  current="mapbox-spec"
  title="X-GIS — Mapbox Style Spec coverage"
  description="Every Mapbox Style Spec property the X-GIS converter touches, classified as supported / partial / unsupported, derived from the converter source itself."
  headings={headings}
>
  <header class="mb-12">
    <p class="font-mono text-[11px] tracking-[0.2em] uppercase text-accent mb-3">Reference</p>
    <h1 class="font-display font-semibold uppercase text-fg leading-[0.95] tracking-[0.01em] text-[38px] sm:text-[52px] lg:text-[64px]">
      Mapbox Style Spec coverage.
    </h1>
    <p class="mt-5 text-[16px] sm:text-[17px] leading-[1.6] text-fg-dim max-w-[720px]">
      Single source of truth for what the
      <a href={`${base}/convert`} class="text-accent hover:text-accent-hover underline">convertMapboxStyle</a>
      pipeline handles. Each row is checked against the converter source
      at build time — entries marked <em>supported</em> must have a
      matching reference in the converter; new converter cases that miss
      a table entry fail CI. See the migration guide at
      <a href={`${base}/docs/mapbox`} class="text-accent hover:text-accent-hover underline">Mapbox migration</a>
      for narrative context and examples.
    </p>
  </header>

  <section id="summary" class="mb-14 scroll-mt-24">
    <h2 class="text-[24px] sm:text-[28px] font-medium text-fg leading-[1.2] tracking-[-0.02em] mb-3 pb-2 border-b border-line">
      Summary
    </h2>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
      <div class="rounded-lg border border-line bg-bg-elev p-4">
        <div class="text-[11px] uppercase tracking-[0.16em] text-emerald-300 font-mono mb-1.5">Supported</div>
        <div class="text-[28px] font-medium text-fg leading-none">{totals.supported}</div>
        <div class="text-[11px] text-fg-mute mt-1.5">{Math.round(totals.supported / applicable * 100)}% of {applicable} applicable</div>
      </div>
      <div class="rounded-lg border border-line bg-bg-elev p-4">
        <div class="text-[11px] uppercase tracking-[0.16em] text-amber-300 font-mono mb-1.5">Partial</div>
        <div class="text-[28px] font-medium text-fg leading-none">{totals.partial}</div>
        <div class="text-[11px] text-fg-mute mt-1.5">Lossy or runtime gap</div>
      </div>
      <div class="rounded-lg border border-line bg-bg-elev p-4">
        <div class="text-[11px] uppercase tracking-[0.16em] text-rose-300 font-mono mb-1.5">Unsupported</div>
        <div class="text-[28px] font-medium text-fg leading-none">{totals.unsupported}</div>
        <div class="text-[11px] text-fg-mute mt-1.5">Dropped on convert</div>
      </div>
      <div class="rounded-lg border border-line bg-bg-elev p-4">
        <div class="text-[11px] uppercase tracking-[0.16em] text-fg-mute font-mono mb-1.5">N/A</div>
        <div class="text-[28px] font-medium text-fg leading-none">{totals.na}</div>
        <div class="text-[11px] text-fg-mute mt-1.5">No xgis equivalent</div>
      </div>
    </div>
    <Callout type="note" title="Reading this table">
      <p class="text-[13px] leading-[1.6] text-fg-dim mb-2">
        <strong class="text-fg">Supported</strong> — converter emits an
        xgis form AND the runtime honours it.
        <strong class="text-fg">Partial</strong> — converter emits
        SOMETHING but loses information (e.g. exponential interpolation
        folded to linear) or the runtime side has a gap.
        <strong class="text-fg">Unsupported</strong> — silently dropped
        or warned. <strong class="text-fg">N/A</strong> — Mapbox-only
        concept with no xgis equivalent and no plan to add.
      </p>
      <p class="text-[13px] leading-[1.6] text-fg-dim">
        Impact tier reflects user-visible severity in common basemap
        styles (OFM Bright, MapLibre demo), not effort to fix.
      </p>
    </Callout>
  </section>

  {/* ── Filter / search toolbar ── sticks under the header; a small vanilla
        script (bottom of file) shows/hides rows by status + property name. */}
  <div class="cov-toolbar sticky top-12 z-20 -mx-2 px-2 py-3 mb-10 bg-bg/85 backdrop-blur-md border-b border-line flex flex-wrap items-center gap-x-3 gap-y-2.5">
    <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filter by status">
      <button type="button" class="cov-chip" data-filter="all" aria-pressed="true">All <span class="cov-chip-n">{total}</span></button>
      <button type="button" class="cov-chip" data-filter="supported" aria-pressed="false">Supported <span class="cov-chip-n">{totals.supported}</span></button>
      <button type="button" class="cov-chip" data-filter="partial" aria-pressed="false">Partial <span class="cov-chip-n">{totals.partial}</span></button>
      <button type="button" class="cov-chip" data-filter="unsupported" aria-pressed="false">Unsupported <span class="cov-chip-n">{totals.unsupported}</span></button>
      <button type="button" class="cov-chip" data-filter="na" aria-pressed="false">N/A <span class="cov-chip-n">{totals.na}</span></button>
    </div>
    <label class="ml-auto relative">
      <span class="sr-only">Search properties</span>
      <input
        id="cov-search"
        type="search"
        placeholder="Search property…"
        autocomplete="off"
        class="w-[200px] max-w-[60vw] bg-bg-elev border border-line rounded-md pl-3 pr-3 py-1.5 text-[13px] text-fg placeholder:text-fg-mute focus:outline-none focus:border-accent"
      />
    </label>
    <p class="text-[12px] text-fg-mute basis-full sm:basis-auto">Showing <span id="cov-count" class="text-fg-dim tabular-nums">{total}</span> of {total}</p>
    <p id="cov-empty" class="hidden basis-full text-[13px] text-fg-mute">No properties match — try another status or clear the search.</p>
  </div>

  {MAPBOX_COVERAGE.map(section => (
    <section id={section.id} class="cov-section mb-12 scroll-mt-24">
      <h2 class="text-[20px] sm:text-[24px] font-medium text-fg leading-[1.25] tracking-[-0.02em] mb-2 pb-2 border-b border-line">
        {section.title}
      </h2>
      {section.description && (
        <p class="text-[13px] leading-[1.6] text-fg-dim mb-4 max-w-[720px]">{section.description}</p>
      )}
      <div class="overflow-x-auto -mx-2 px-2">
        <table class="w-full text-[12.5px] border-collapse">
          <thead>
            <tr class="text-left text-[11px] uppercase tracking-[0.16em] text-fg-mute">
              <th class="font-mono pb-2 pr-3 align-bottom whitespace-nowrap">Property</th>
              <th class="font-mono pb-2 pr-3 align-bottom whitespace-nowrap">Status</th>
              <th class="font-mono pb-2 pr-3 align-bottom whitespace-nowrap">Impact</th>
              <th class="font-mono pb-2 pr-3 align-bottom w-full">Note</th>
              <th class="font-mono pb-2 align-bottom whitespace-nowrap">Source</th>
            </tr>
          </thead>
          <tbody>
            {section.entries.map(e => {
              const sb = statusBadge(e.status)
              const ib = impactBadge(e.impact)
              return (
                <tr class="cov-row border-t border-line/60 align-top" data-status={e.status} data-name={e.name}>
                  <td class="py-2 pr-3"><code class="font-mono text-fg">{e.name}</code></td>
                  <td class="py-2 pr-3">
                    <span class={`inline-block text-[10.5px] font-medium px-1.5 py-0.5 rounded border ${sb.cls}`}>{sb.label}</span>
                  </td>
                  <td class="py-2 pr-3">
                    {ib ? <span class={`inline-block text-[10.5px] font-medium px-1.5 py-0.5 rounded border ${ib.cls}`}>{ib.label}</span> : <span class="text-fg-mute text-[11px]">—</span>}
                  </td>
                  <td class="py-2 pr-3 text-fg-dim leading-[1.5]">{e.note ? <div class="cov-note cursor-pointer" title="Click to expand">{e.note}</div> : <span class="text-fg-mute">—</span>}</td>
                  <td class="py-2 text-fg-mute font-mono text-[11px] whitespace-nowrap">{e.source ?? '—'}</td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  <section class="mt-16 pt-8 border-t border-line">
    <h3 class="text-[16px] font-medium text-fg mb-3">Keeping this page accurate</h3>
    <p class="text-[13px] leading-[1.6] text-fg-dim max-w-[720px]">
      The table lives in
      <code class="font-mono text-fg">compiler/src/convert/spec-coverage.ts</code>.
      A vitest regression
      (<code class="font-mono text-fg">spec-coverage-drift.test.ts</code>)
      scans the converter source files at build time and fails when:
    </p>
    <ul class="text-[13px] leading-[1.6] text-fg-dim mt-3 space-y-1.5 max-w-[720px]">
      <li>• A new <code class="font-mono text-fg">case 'X':</code>,
        <code class="font-mono text-fg">layout['X']</code>, or
        <code class="font-mono text-fg">paint['X']</code> reference
        appears in the converter without a corresponding table entry, or
      </li>
      <li>• An entry marked <code class="font-mono text-fg">supported</code>
        has no matching reference in the source (catches stale entries
        after the converter loses a feature).
      </li>
    </ul>
  </section>

  <style>
    /* Filter chips — active state via aria-pressed so the script only flips
       one attribute. */
    .cov-chip {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.04em;
      color: var(--color-fg-mute);
      background: var(--color-bg-elev);
      border: 1px solid var(--color-line);
      border-radius: 999px;
      padding: 0.3rem 0.7rem;
      cursor: pointer;
      transition: color 0.15s, border-color 0.15s, background 0.15s;
    }
    .cov-chip:hover { color: var(--color-fg-dim); }
    .cov-chip[aria-pressed='true'] {
      color: var(--color-fg);
      border-color: var(--color-line-strong);
      background: var(--color-bg-hover);
    }
    .cov-chip-n { color: var(--color-fg-faint); margin-left: 0.25rem; }
    .cov-chip[aria-pressed='true'] .cov-chip-n { color: var(--color-fg-mute); }

    /* Note column — clamp to 2 lines so rows stay uniform; click to expand. */
    .cov-note {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }
    .cov-note.cov-note-open { -webkit-line-clamp: unset; }
  </style>

  <script>
    // Client-side filter for the coverage tables: status chips + property
    // search hide non-matching rows and any section left empty. Vanilla, no
    // deps — same pattern as the other inline scripts on the site.
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('.cov-row'))
    const sections = Array.from(document.querySelectorAll<HTMLElement>('.cov-section'))
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.cov-chip'))
    const search = document.getElementById('cov-search') as HTMLInputElement | null
    const count = document.getElementById('cov-count')
    const empty = document.getElementById('cov-empty')

    if (rows.length && chips.length && search && count) {
      let active = 'all'

      const apply = () => {
        const q = search.value.trim().toLowerCase()
        let shown = 0
        for (const r of rows) {
          const okStatus = active === 'all' || r.dataset.status === active
          const okName = !q || (r.dataset.name ?? '').toLowerCase().includes(q)
          const visible = okStatus && okName
          r.classList.toggle('hidden', !visible)
          if (visible) shown++
        }
        for (const s of sections) {
          s.classList.toggle('hidden', !s.querySelector('.cov-row:not(.hidden)'))
        }
        count.textContent = String(shown)
        if (empty) empty.classList.toggle('hidden', shown !== 0)
      }

      for (const c of chips) {
        c.addEventListener('click', () => {
          active = c.dataset.filter ?? 'all'
          for (const x of chips) x.setAttribute('aria-pressed', String(x === c))
          apply()
        })
      }
      search.addEventListener('input', apply)

      // Expand a clamped note on click.
      for (const n of Array.from(document.querySelectorAll('.cov-note'))) {
        n.addEventListener('click', () => n.classList.toggle('cov-note-open'))
      }
    }
  </script>
</Docs>
