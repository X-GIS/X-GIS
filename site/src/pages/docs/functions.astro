---
import Docs from '../../layouts/Docs.astro'
import { Code } from 'astro-expressive-code/components'

interface Fn {
  name: string
  signature: string
  body: string
  examples: string[]
  /** Where the function is callable. The evaluator runs in three
   *  contexts — paint binding (`utility-[expr]`), filter predicate
   *  (`filter:`), and per-feature property eval (data-driven match
   *  branch values, etc.). All three share the same builtin set, so
   *  unless we explicitly mark a function as restricted assume it
   *  works everywhere. */
  context?: string
}

interface FnGroup {
  title: string
  body: string
  fns: Fn[]
}

// Ground truth: compiler/src/eval/evaluator-helpers.ts (callBuiltin).
// Every entry below corresponds to one switch-case branch there. The
// accessor-style builtins (get / properties) and the runtime
// identifiers (zoom / pitch / .field) are resolved in
// compiler/src/eval/evaluator.ts instead, before the callBuiltin
// dispatch — they read the live props bag, not just evaluated args.
const groups: FnGroup[] = [
  {
    title: 'Math',
    body: 'Number-in / number-out helpers. Inputs are coerced via `toNumber` (strings parseFloat, booleans 0/1, anything else 0). Division-by-zero in the language operators returns 0 silently — these helpers follow the same convention.',
    fns: [
      { name: 'clamp', signature: 'clamp(value, min, max)',
        body: 'Pin `value` into the closed range `[min, max]`. Equivalent to `min(max(value, min), max)` but a single call.',
        examples: ['size-[clamp(.speed / 50, 4, 24)]'] },
      { name: 'min', signature: 'min(a, b, …)',
        body: 'Smallest of all arguments. Variadic — pass any number of values.',
        examples: ['stroke-[min(.width, 8)]', 'opacity-[min(.alpha, 0.7)]'] },
      { name: 'max', signature: 'max(a, b, …)',
        body: 'Largest of all arguments. Variadic.',
        examples: ['stroke-[max(.width, 1)]'] },
      { name: 'round', signature: 'round(value)', body: 'Round half-up to the nearest integer.', examples: ['size-[round(.zoom)]'] },
      { name: 'floor', signature: 'floor(value)', body: 'Round down to the next integer.', examples: ['size-[floor(.density / 100)]'] },
      { name: 'ceil',  signature: 'ceil(value)',  body: 'Round up to the next integer.',     examples: ['size-[ceil(.depth)]'] },
      { name: 'abs',   signature: 'abs(value)',   body: 'Absolute value.',                    examples: ['stroke-[abs(.delta)]'] },
      { name: 'sqrt',  signature: 'sqrt(value)',  body: 'Square root. Negative inputs return NaN; the toNumber pipeline coerces NaN to 0 in arithmetic.', examples: ['size-[sqrt(.area)]'] },
      { name: 'pow',   signature: 'pow(base, exponent)', body: 'Raise `base` to `exponent`. `pow(x, 0.5)` is equivalent to `sqrt(x)`.', examples: ['size-[pow(.population, 0.3)]'] },
      { name: 'exp',   signature: 'exp(value)',   body: 'Natural exponential — `e ^ value`.', examples: ['size-[exp(.score / 1000)]'] },
      { name: 'log',   signature: 'log(value)',   body: 'Natural log — `ln(value)`. Inputs ≤ 0 are clamped to 1e-10 to avoid `-Infinity`.', examples: ['size-[log(.population)]'] },
      { name: 'ln',    signature: 'ln(value)',    body: 'Alias for `log` — kept so converted Mapbox styles using `["ln", x]` round-trip 1:1.', examples: [] },
      { name: 'log10', signature: 'log10(value)', body: 'Base-10 log. Same negative-input clamp as `log`.', examples: ['fill-[interpolate(log10(.population), 3, white-100, 7, red-500)]'] },
      { name: 'log2',  signature: 'log2(value)',  body: 'Base-2 log. Same clamp as `log`.', examples: ['size-[log2(.zoom)]'] },
      { name: 'scale', signature: 'scale(value, factor)', body: 'Multiply `value` by `factor`. Pure sugar over `*`: `scale(.x, 2)`.', examples: ['size-[scale(.height, 0.5)]'] },
    ],
  },

  {
    title: 'Trigonometry',
    body: 'Standard trig in **radians**. Convert from degrees with `value * PI / 180` or use the `TAU` constant for full-revolution math.',
    fns: [
      { name: 'sin', signature: 'sin(radians)', body: 'Sine.',          examples: ['stroke-[sin(.angle) * 5]'] },
      { name: 'cos', signature: 'cos(radians)', body: 'Cosine.',        examples: ['size-[cos(.heading) * 10]'] },
      { name: 'tan', signature: 'tan(radians)', body: 'Tangent.',       examples: [] },
      { name: 'asin', signature: 'asin(value)', body: 'Inverse sine. Inputs outside [-1, 1] return NaN.', examples: [] },
      { name: 'acos', signature: 'acos(value)', body: 'Inverse cosine. Inputs outside [-1, 1] return NaN.', examples: [] },
      { name: 'atan', signature: 'atan(value)', body: 'Inverse tangent.', examples: [] },
      { name: 'atan2', signature: 'atan2(y, x)', body: 'Two-arg arctangent — angle of the vector (x, y) in [-π, π]. Use this for "rotate to face direction" since it handles all four quadrants.', examples: ['size-[atan2(.dy, .dx)]'] },
    ],
  },

  {
    title: 'Stops & gates',
    body: 'Builtins that pick or blend between values. Both work for any input — `zoom` (camera state), `.field` (feature property), arithmetic results.',
    fns: [
      { name: 'interpolate', signature: 'interpolate(input, x1, y1, x2, y2, …)',
        body: 'Linear interpolation between `(xi, yi)` stops. When `input` is below `x1` returns `y1`; above the last `xN` returns `yN`; in between blends linearly. Numeric values blend; non-numeric (e.g. color hex) snap to the nearest stop without blending. The single most-used builtin — covers every Mapbox `interpolate` zoom-driven paint property.',
        examples: [
          'opacity-[interpolate(zoom, 8, 40, 14, 100)]',
          'stroke-[interpolate(zoom, 11, 1, 19, 2.5)]',
          'fill-[interpolate(.population, 0, white-100, 1e6, red-500)]',
        ] },
      { name: 'step', signature: 'step(input, default, stop1, val1, stop2, val2, …)  // OR  step(value, threshold, below, above)',
        body: 'Discrete-stop gate. Two shapes: the **N-stop** form (Mapbox-spec — preferred) returns `default` while `input < stop1`, then walks stops left-to-right and returns the val for the largest `stop_i ≤ input`. The legacy **2-stop** form (4 args) is `below` when `value < threshold`, else `above`. Distinguish by arg count: even = legacy, odd ≥ 5 = N-stop.',
        examples: [
          'size-[step(.rank, 0.5, 5, 0.7, 10, 1)]   // N-stop: default 0.5, jumps at rank 5 → 0.7, rank 10 → 1',
          'opacity-[step(zoom, 10, 30, 100)]        // legacy: < 10 → 30, else 100',
        ] },
      { name: 'interpolate_exp', signature: 'interpolate_exp(input, base, x1, y1, x2, y2, …)',
        body: 'Exponential-curve interpolation — Mapbox `["interpolate", ["exponential", base], …]`. Same stop shape as `interpolate` but with a leading `base` that shapes the between-stops curve; `base = 1` is mathematically linear (identical to `interpolate`).',
        examples: ['size-[interpolate_exp(zoom, 1.5, 8, 2, 16, 20)]'] },
      { name: 'interpolate_lab', signature: 'interpolate_lab(input, x1, color1, x2, color2, …)',
        body: 'Colour interpolation in CIELAB space — Mapbox `["interpolate-lab", …]`. Stop values resolve to colours at eval time; blends perceptually (smoother than RGB lerp). Stop `xi` must be literal numbers. Curve is linear only.',
        examples: ['fill-[interpolate_lab(.t, 0, blue-500, 1, red-500)]'] },
      { name: 'interpolate_hcl', signature: 'interpolate_hcl(input, x1, color1, x2, color2, …)',
        body: 'Colour interpolation in HCL (LCh) space — Mapbox `["interpolate-hcl", …]`. Like `interpolate_lab` but interpolates hue on the shortest arc, keeping chroma vivid through the blend.',
        examples: ['fill-[interpolate_hcl(.t, 0, yellow-400, 1, purple-600)]'] },
    ],
  },

  {
    title: 'Strings',
    body: 'String-coercing helpers. Numeric inputs stringify via `String()`; null / undefined drop. The label resolver runs strings through these the same way it does for inline `{template}` syntax.',
    fns: [
      { name: 'concat', signature: 'concat(a, b, c, …)',
        body: 'Concatenate any number of arguments after coercing each to its string form. Null / undefined are skipped (matches the Mapbox spec). Common shape inside `label-[<expr>]` for compound labels — bilingual names, prefix-suffix wraps, units suffixed to numbers.',
        examples: [
          'label-[concat(.name, " (", .country, ")")]',
          'label-[concat(round(.elevation_m), " m")]',
        ] },
      { name: 'downcase', signature: 'downcase(value)', body: 'Lowercase the string form of `value`. Coerces non-strings via `String()`.', examples: ['label-[downcase(.name)]'] },
      { name: 'upcase',   signature: 'upcase(value)',   body: 'Uppercase the string form of `value`. Same coercion.',                       examples: ['label-[upcase(.country_code)]'] },
    ],
  },

  {
    title: 'String / type ops',
    body: 'String slicing, search, number formatting, and the Mapbox type-cast family. These round-trip the corresponding Mapbox expressions 1:1 — a converted style that calls them keeps working even though the converter usually rewrites the casts into a coalesce chain.',
    fns: [
      { name: 'typeof', signature: 'typeof(value)',
        body: 'Mapbox `["typeof", value]`. Returns `"string"`, `"number"`, `"boolean"`, `"object"`, or `"null"`. Useful inside a `filter:` to branch on a property\'s shape.',
        examples: ['filter: typeof(.name) == "string"'] },
      { name: 'slice', signature: 'slice(input, start, end?)',
        body: 'Substring (string input) or sub-array (array input) — Mapbox `["slice", …]`. Negative indices count from the end. Non-string / non-array input returns `null`.',
        examples: ['label-[slice(.iso_code, 0, 2)]'] },
      { name: 'index_of', signature: 'index_of(needle, haystack, from?)',
        body: 'First index of `needle` in a string or array (Mapbox `["index-of", …]`; the hyphen form `index-of` also routes here). Returns `-1` when not found.',
        examples: ['size-[index_of("toll", .tags) >= 0]'] },
      { name: 'number_format', signature: 'number_format(input, minFrac?, maxFrac?, locale?, currency?)',
        body: 'Locale-aware number formatting via `Intl.NumberFormat` — Mapbox `["number-format", …]`. Positional args (the form the converter emits) or an options-object second arg both work; `null` slots take spec defaults.',
        examples: ['label-[number_format(.population, 0, 0, "en-US")]'] },
      { name: 'to_number', signature: 'to_number(value, …fallbacks)',
        body: 'Mapbox `["to-number", …]` (alias `number`). Returns the first arg that converts to a finite number — strings via `Number()`, booleans as 0/1 — else `null`. Use it to harden a string property before arithmetic.',
        examples: ['size-[to_number(.height_str)]'] },
      { name: 'to_string', signature: 'to_string(value)',
        body: 'Mapbox `["to-string", value]` (alias `string`). Coerces to a string — numbers via `String()`, booleans to `"true"` / `"false"`, objects via `JSON.stringify`, null/undefined to `""`.',
        examples: ['label-[to_string(.rank)]'] },
      { name: 'to_boolean', signature: 'to_boolean(value)',
        body: 'Mapbox `["to-boolean", value]` (alias `boolean`). Spec false-y values (`0`, `""`, `null`, `undefined`, `NaN`) become `false`; everything else `true`.',
        examples: ['filter: to_boolean(.is_capital)'] },
      { name: 'to_color', signature: 'to_color(value, …fallbacks)',
        body: 'Mapbox `["to-color", …]`. Returns the first arg that parses as a hex colour (`#rgb` / `#rgba` / `#rrggbb` / `#rrggbbaa`), else `null`. Non-string args skip to the next fallback.',
        examples: ['fill-[to_color(.color_hex, gray-400)]'] },
    ],
  },

  {
    title: 'Constants',
    body: 'Compile-time constants. No-arg builtins.',
    fns: [
      { name: 'PI',  signature: 'PI',  body: 'π ≈ 3.14159. Half a revolution.',  examples: ['stroke-[sin(.heading * PI / 180) * 5]'] },
      { name: 'TAU', signature: 'TAU', body: '2π ≈ 6.28318. Full revolution. Often nicer than `2 * PI`.', examples: [] },
      { name: 'pi',  signature: 'pi()',  body: 'π as a zero-arg builtin call — same value as `PI`. Kept for 1:1 round-trip with Mapbox `["pi"]`.', examples: [] },
      { name: 'e',   signature: 'e()',   body: 'Euler\'s number — ≈ 2.71828. Mapbox `["e"]` round-trip.', examples: [] },
      { name: 'ln2', signature: 'ln2()', body: '`ln(2)` ≈ 0.69315. Mapbox `["ln2"]` round-trip.', examples: [] },
    ],
  },

  {
    title: 'Array',
    body: 'Helpers for array values. The match-arm value path and geometry generators (`polygon`, `linestring`) produce arrays.',
    fns: [
      { name: 'length', signature: 'length(array)', body: 'Number of elements. Returns 0 for non-arrays.', examples: ['size-[length(.tags)]'] },
      { name: '[i] index', signature: 'array[i]', body: 'Zero-based subscript. Out-of-bounds returns `null`. Bracket form, not a function — read in the parser.', examples: ['fill-[.colors[0]]'] },
    ],
  },

  {
    title: 'Geometry generators',
    body: 'Construct coordinate arrays / GeoJSON-shaped values from numbers. Used inside `geometry: <expr>` block-property to build a per-feature mesh from properties (e.g. draw a circle around each city sized by population).',
    fns: [
      { name: 'circle', signature: 'circle(cx, cy, radius, segments?)',
        body: 'Polygon ring approximating a circle. `segments` defaults to 32 (clamped ≥ 4). Returns a closed array of `[lon, lat]` pairs.',
        examples: ['geometry: circle(.lon, .lat, .radius, 64)'] },
      { name: 'arc', signature: 'arc(cx, cy, radius, startRad, endRad, segments?)',
        body: 'Open polyline along an arc from `startRad` to `endRad`, both in radians. `segments` defaults to 32 (clamped ≥ 2).',
        examples: ['geometry: arc(.cx, .cy, 5, 0, PI, 24)'] },
      { name: 'polygon', signature: 'polygon(points)',
        body: 'Wrap a `[[lon, lat], …]` ring as a GeoJSON `Polygon`. Caller must close the ring (or use `circle` which closes for you).',
        examples: ['geometry: polygon(.boundary)'] },
      { name: 'linestring', signature: 'linestring(points)',
        body: 'Wrap a `[[lon, lat], …]` array as a GeoJSON `LineString`.',
        examples: ['geometry: linestring(.path)'] },
    ],
  },

  {
    title: 'Runtime accessors',
    body: 'Names + accessor builtins the evaluator resolves against live camera / feature state (not the plain `callBuiltin` args). The bare identifiers (`zoom`, `pitch`, `.field`) and the `get` / `properties` accessor calls all read the live props bag.',
    fns: [
      { name: 'zoom', signature: 'zoom',
        body: 'Current camera zoom level (float). Sampled per-frame. Inject in any expression — most commonly inside `interpolate(zoom, …)`.',
        examples: ['opacity-[interpolate(zoom, 8, 40, 14, 100)]'] },
      { name: 'pitch', signature: 'pitch',
        body: 'Current camera pitch in degrees — Mapbox `["pitch"]`. Sampled per-frame on the render path; `null` at decode time. Bare name, like `zoom`.',
        examples: ['opacity-[interpolate(pitch, 0, 100, 60, 30)]'] },
      { name: '.field', signature: '.field_name',
        body: 'Feature property accessor. `.height` reads the `height` property from the current feature\'s tags. Returns `null` when the property is missing — pair with `??` for a fallback.',
        examples: [
          'fill-extrusion-height-[.height ?? 5]',
          'filter: .class == "highway"',
        ] },
      { name: 'get', signature: 'get("key")',
        body: 'Feature property accessor for keys the bare-dot form can\'t name — Mapbox `["get", key]`. Use it for colon-bearing locale keys (`name:ko`, `name:latin`) or a dynamic key (`get(.field_name)`). Returns `null` when absent.',
        examples: ['label-[get("name:ko") ?? get("name")]'] },
      { name: 'properties', signature: 'properties()',
        body: 'The whole feature-properties object — Mapbox `["properties"]`. Strips the reserved `$`-sigil camera/meta keys the runtime injects, returning only the feature\'s own properties.',
        examples: ['filter: typeof(properties()) == "object"'] },
    ],
  },
]
---

<Docs
  current="functions"
  title="X-GIS — Function reference"
  description="Every builtin function the xgis evaluator recognises — math, trig, interpolation, runtime accessors, and geometry generators."
  headings={groups.map(g => ({
    depth: 2,
    slug: g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),
    text: g.title,
  }))}
>
  <header class="mb-12">
    <p class="font-mono text-[11px] tracking-[0.2em] uppercase text-accent mb-3">Language</p>
    <h1 class="font-display font-normal text-fg leading-[0.95] tracking-[-0.02em] text-[38px] sm:text-[52px] lg:text-[64px]">
      Function reference.
    </h1>
    <p class="mt-5 text-[16px] sm:text-[17px] leading-[1.6] text-fg-dim max-w-[720px]">
      Every builtin the evaluator knows about. Use any of these inside a
      utility binding (<code class="font-mono text-fg">utility-[expr]</code>),
      a layer filter (<code class="font-mono text-fg">filter:</code>), a
      block property (<code class="font-mono text-fg">extrude:</code>,
      <code class="font-mono text-fg">geometry:</code>), or as a match-arm
      value.
    </p>
    <p class="mt-3 text-[14px] text-fg-mute max-w-[720px]">
      Inputs are coerced — strings get <code class="font-mono">parseFloat</code>'d,
      booleans become 0/1, anything else becomes 0. Numeric ops follow JS
      semantics except division-by-zero returns 0 (no <code class="font-mono">Infinity</code>).
    </p>
  </header>

  <article class="space-y-14">
    {groups.map(g => {
      const slug = g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
      return (
      <section>
        <h2 id={slug} class="scroll-mt-24 text-[24px] sm:text-[28px] font-medium text-fg leading-[1.2] tracking-[-0.02em] mb-3 pb-2 border-b border-line">
          {g.title}
        </h2>
        <p class="text-[14px] sm:text-[15px] leading-[1.6] text-fg-dim mb-8 max-w-[720px]">
          {g.body}
        </p>
        <div class="space-y-7">
          {g.fns.map(fn => (
            <div class="grid lg:grid-cols-[200px_minmax(0,1fr)] gap-x-6 gap-y-2">
              <div class="lg:pt-1">
                <h3 class="font-mono text-[14px] text-fg font-medium">{fn.name}</h3>
              </div>
              <div>
                <p class="font-mono text-[13px] text-fg-mute mb-2">{fn.signature}</p>
                <p class="text-[14px] leading-[1.6] text-fg-dim mb-3" set:html={fn.body.replace(/`([^`]+)`/g, '<code class="font-mono text-fg">$1</code>')}></p>
                {fn.examples.length > 0 && (
                  <Code code={fn.examples.join('\n')} lang="xgis" />
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
      )
    })}
  </article>
</Docs>
