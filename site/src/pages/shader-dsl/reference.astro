---
// ═══ The shader-dsl reference MAP (#1700) ═══
//
// This page used to transcribe 53 signatures by hand. Nothing checked them against the
// source, so every one was a second authority that could rot silently while reading as
// authoritative — and #1699's generated reference made them redundant besides.
//
// What a generated reference CANNOT produce is the part that survived: grouping by INTENT.
// "Layout declarators (single source of truth)" is an editorial claim about which five
// symbols solve one problem together; /api can only sort alphabetically inside a kind. So
// this page keeps the groups and the notes, and hands every signature to the generated page.
//
// A name here is VERIFIED AT BUILD TIME against the published reference: `routeFor` throws
// if a symbol is not in the api collection, so this page cannot link to a symbol that was
// renamed, un-exported, or excluded as `@internal`. That is strictly stronger than the
// #1700 ratchet's text check — it catches "exists but is not published" too — which is why
// the ratchet no longer needs to scan this file.
import ShaderDsl from '../../layouts/ShaderDsl.astro'
import { getCollection } from 'astro:content'

const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
const root = `${base}/shader-dsl`

const api = await getCollection('api')
/** symbol name → its published route. Built from the collection, never hand-written. */
const ROUTE = new Map<string, string>()
for (const e of api) {
  const segs = e.id.split('/')
  const name = segs.at(-1)!
  if (name === 'README') continue
  // `.` subpath wins when a symbol is exposed by several — it is the one a reader imports.
  if (!ROUTE.has(name) || segs[0] === 'index') ROUTE.set(name, e.id)
}

function routeFor(name: string): string {
  const r = ROUTE.get(name)
  if (r === undefined)
    throw new Error(
      `shader-dsl/reference.astro lists \`${name}\`, which the generated API reference does ` +
        `not publish. It was renamed, un-exported, or is tagged @internal. Fix the name or ` +
        `drop the row — this page must not link a reader to a 404. (#1700)`,
    )
  return `${base}/api/${r}`
}

interface Group {
  title: string
  note?: string
  /** Symbols, in the order a reader meets them — NOT alphabetical; that is /api's job. */
  names: string[]
  /** For groups whose members are methods on a value node rather than exports. */
  seeAlso?: { label: string; name: string }
}

const groups: Group[] = [
  {
    title: 'Module & functions',
    note: 'Declare a function, assemble a module. `fn` returns a CALLABLE handle — prefer calling it over spelling a name as a string.',
    names: ['fn', 'module', 'externFn', 'callFn', 'composeModule'],
  },
  {
    title: 'Layout declarators',
    note: 'Declare a layout ONCE; the struct, the binding, the access node, and typed field access are all derived — they cannot drift.',
    names: ['uniformStruct', 'ioStruct', 'structDecl', 'storageBuffer', 'resource', 'builtin', 'location'],
  },
  {
    title: 'Values & constructors',
    note: 'Scalars, vectors, locals. `Var` is mutable, `Let` and params are not — `.assign` on a readonly node is a tsc error, not a runtime one.',
    names: ['f32', 'i32', 'u32', 'bool', 'vec2', 'vec3', 'vec4', 'Var', 'Let', 'constExpr', 'arrayLit', 'toF32', 'toI32', 'toU32'],
  },
  {
    title: 'Operators',
    note: 'Arithmetic, comparison, swizzles and `.assign` are METHODS on a value node, not free functions — so they live on the node type rather than in this list.',
    names: [],
    seeAlso: { label: 'All methods on a value node', name: 'Node' },
  },
  {
    title: 'Built-in functions',
    note: 'Reach for the free `mod` over the `.mod` method: `mod` is floor-mod and portable, `.mod` is trunc-mod and invalid on GLSL ES 3.00 floats.',
    names: ['sin', 'cos', 'tan', 'atan2', 'exp', 'log', 'pow', 'sqrt', 'floor', 'ceil', 'fract', 'abs', 'sign', 'min', 'max', 'clamp', 'mix', 'smoothstep', 'mod', 'length', 'dot', 'cross', 'distance', 'radians', 'degrees'],
  },
  {
    title: 'Control flow',
    note: 'Statement forms (`If`, `Loop`, `Switch`) and value combinators (`when`, `reduce`). `matchEnum` is EXHAUSTIVE — a missing arm is a compile error.',
    names: ['If', 'Loop', 'Switch', 'Return', 'ReturnIf', 'Break', 'Continue', 'Discard', 'when', 'reduce', 'enumU32', 'matchEnum', 'condExpr', 'ifExpr'],
  },
  {
    title: 'Types',
    names: ['f32T', 'i32T', 'u32T', 'boolT', 'arrayT', 'f64T'],
  },
  {
    title: 'Emit & reflect',
    note: 'One module, many targets. `reflect` is the target-neutral description the host binds against.',
    names: ['emitModule', 'emitModuleAt', 'emitGlslModule', 'emitGlslStages', 'emitModuleWithReflection', 'reflect', 'hostFeaturesFor'],
  },
  {
    title: 'Production emit',
    note: 'Ship-time plugins, composed Vite/Webpack-style, from `@xgis/shader-dsl/emit-prod`.',
    names: ['mangle', 'minify', 'inline', 'obfuscate'],
  },
  {
    title: 'Validation & diagnostics',
    note: '`validate` is the emit-time gate on the main entry; the lint and capability analysis are reached through `@xgis/shader-dsl/dev`.',
    names: ['validate', 'lintModule', 'requiredCaps', 'assertCaps', 'diagnose'],
  },
]

// Resolve every route now, so an unknown name fails the BUILD rather than rendering a 404.
const resolved = groups.map((g) => ({
  ...g,
  links: g.names.map((n) => ({ name: n, href: routeFor(n) })),
  seeAlsoHref: g.seeAlso ? routeFor(g.seeAlso.name) : undefined,
}))
const total = resolved.reduce((n, g) => n + g.links.length, 0)
---

<ShaderDsl
  current="reference"
  title="X-GIS Shader DSL — API reference"
  description="A map of the @xgis/shader-dsl authoring surface, grouped by what you are trying to do, linking into the full generated API reference."
>
  <h1
    class="font-display text-[40px] leading-[1.0] font-normal tracking-[-0.02em] text-fg sm:text-[52px] lg:text-[64px]"
  >
    API reference
  </h1>
  <p class="mt-4 max-w-[60ch] text-[16px] leading-[1.6] text-fg-dim">
    {total} entry points into <code class="font-mono text-[14px] text-fg">@xgis/shader-dsl</code>,
    grouped by what you are trying to do. Every name links to its generated page — signatures,
    parameters and a source link, produced from the TSDoc at the definition site.
  </p>
  <p class="mt-3 max-w-[60ch] text-[16px] leading-[1.6] text-fg-dim">
    Browsing rather than looking something up? The
    <a href={`${base}/api`} class="text-accent transition-colors hover:text-accent-hover"
      >full reference</a
    > lists every export with a filter, and the
    <a href={`${root}/examples`} class="text-accent transition-colors hover:text-accent-hover"
      >examples</a
    > are runnable.
  </p>

  <div class="mt-12 max-w-full space-y-10">
    {
      resolved.map((g) => (
        <section>
          <h2 class="font-display mb-1.5 text-[20px] font-normal tracking-[-0.015em] text-fg">
            {g.title}
          </h2>
          {g.note && (
            <p class="mb-4 max-w-[70ch] text-[13.5px] leading-[1.55] text-fg-mute" set:html={g.note.replace(/`([^`]+)`/g, '<code class="font-mono text-[12.5px] text-fg-dim">$1</code>')} />
          )}
          {g.links.length > 0 && (
            <ul class="flex flex-wrap gap-x-2 gap-y-2">
              {g.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="border-line hover:border-line-strong inline-block rounded-[6px] border px-2.5 py-1 font-mono text-[12.5px] text-fg-dim transition-colors hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
                  >
                    {l.name}
                  </a>
                </li>
              ))}
            </ul>
          )}
          {g.seeAlso && g.seeAlsoHref && (
            <a
              href={g.seeAlsoHref}
              class="inline-block font-mono text-[12.5px] text-accent transition-colors hover:text-accent-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
            >
              {g.seeAlso.label} →
            </a>
          )}
        </section>
      ))
    }
  </div>
</ShaderDsl>
