---
import ShaderDsl from '../../layouts/ShaderDsl.astro'
import { Code } from 'astro-expressive-code/components'
import { shaderCards } from '../../lib/shader-examples.ts'
import { examples } from '@xgis/shader-dsl/examples'
import { emitGlslModule } from '@xgis/shader-dsl'
import { inline, mangle, minify } from '@xgis/shader-dsl/emit-prod'

const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
const root = `${base}/shader-dsl`

// A concrete dual-backend contrast: the gradient example, emitted both ways from one module.
const gradient = shaderCards.find((c) => c.id === 'gradient')!

// Shipping demo — kaleidoscope has a real authored vocabulary (hash / noise /
// fbm / palette), so the mangle+minify contrast is visible. Every combination
// of the two plugins is emitted at BUILD time by the real emit; the client just
// toggles which precomputed string is shown (the DSL never ships to the browser),
// and the byte counts are measurements, not copy.
const kal = examples.find((e) => e.id === 'kaleidoscope')!
// All 2³ combinations of the three IR/text plugins, emitted at build time; the
// key is the bit-string inline·mangle·minify. inline() flattens the call graph
// entirely — hash/fbm/palette AND the multi-statement noise are all lifted into
// the fragment body — so the three toggles compose visibly.
const shipCombos = [false, true]
  .flatMap((i) => [false, true].flatMap((m) => [false, true].map((n) => ({ i, m, n }))))
  .map(({ i, m, n }) => {
    const plugins = [...(i ? [inline()] : []), ...(m ? [mangle()] : []), ...(n ? [minify()] : [])]
    const code = emitGlslModule(kal.module, 'fragment', { plugins })
    const names = [i && 'inline()', m && 'mangle()', n && 'minify()'].filter(Boolean)
    const label =
      names.length === 0
        ? "emitGlslModule(m, 'fragment')"
        : `{ plugins: [${names.join(', ')}] }`
    return { key: `${+i}${+m}${+n}`, i, m, n, code, bytes: code.length, label }
  })
const shipPlainBytes = shipCombos.find((c) => c.key === '000')!.bytes

// Each body: a bold lead (the payoff) + one tight sentence. Ordered pitch-first
// (IR, backends) then the supporting layers. Deep detail lives in the reference.
const sections = [
  {
    id: 'ir',
    title: 'One typed IR',
    body: '<strong class="text-fg">One representation feeds everything downstream.</strong> Value-nodes carry their type key (<code>vec3&lt;f32&gt;</code>) in the TypeScript type, so a vec2 used where a vec3 belongs is a compile error — before any shader compiler runs.',
  },
  {
    id: 'backends',
    title: 'Two backends, one source',
    body: '<strong class="text-fg">The same IR lowers to WGSL and GLSL.</strong> <strong>WGSL</strong> is canonical and byte-stable for WebGPU; <strong>GLSL ES 3.00</strong> targets WebGL2, turning uniform structs into std140 blocks, entry-IO into <code>in</code>/<code>out</code> varyings, and divergent spellings (<code>atan2</code>→<code>atan</code>) through one intrinsic registry.',
  },
  {
    id: 'reflection',
    title: 'Reflection',
    body: '<strong class="text-fg">Binding layout is derived, never emitted.</strong> <code>reflect(module)</code> reads the IR to recover bind groups, std140/std430 byte offsets, and entry signatures; the host packs its uniforms straight from those offsets.',
  },
  {
    id: 'optimize',
    title: 'Optimize + lint',
    body: '<strong class="text-fg">Every module is optimized and linted before emit.</strong> CSE, DCE, LICM, and const-fold run on the WGSL side so its output stays byte-stable; a 21-rule linter guards naming, dead bindings, and float-equality.',
  },
  {
    id: 'oracle',
    title: 'CPU f64 oracle',
    body: '<strong class="text-fg">The same module also runs on the CPU in f64.</strong> Diffing the GPU shader against that mirror on identical inputs catches sibling-path divergences (fill vs outline, CPU vs GPU projection) that hide sub-pixel until zoom amplifies them.',
  },
  {
    id: 'fail-closed',
    title: 'Fail-closed capabilities',
    body: '<strong class="text-fg">Unsupported features throw — they never mis-emit.</strong> GLSL ES 3.00 has no compute, SSBO, or MSAA-load, so a capability gate raises <code>UnsupportedFeatureError</code> up front rather than emitting invalid GLSL.',
  },
]
---

<ShaderDsl
  current="concepts"
  title="X-GIS Shader DSL — Concepts"
  description="How the shader DSL works: one typed IR, two backends (WGSL + GLSL ES 3.00), reflection, a CPU f64 oracle, and an optimizer + lint pipeline."
>
  <h1 class="font-display font-normal text-fg leading-[1.0] tracking-[-0.02em] text-[40px] sm:text-[52px] lg:text-[64px]">Concepts</h1>
  <p class="mt-4 text-[16px] leading-[1.6] text-fg-dim max-w-[680px]">
    One typed IR, read by everything downstream — the type checker, both backends, reflection, and a
    CPU oracle — so they cannot disagree.
  </p>

  <div class="mt-10 grid sm:grid-cols-2 gap-x-8 gap-y-7">
    {sections.map((s) => (
      <section id={s.id} class="border-t border-line pt-3.5">
        <h2 class="font-display text-[17px] font-normal text-fg tracking-[-0.015em] mb-1.5">{s.title}</h2>
        <p class="text-[14px] leading-[1.6] text-fg-mute" set:html={s.body}></p>
      </section>
    ))}
  </div>

  <section class="mt-20 pt-10 border-t border-line">
    <h2 class="font-display text-[21px] font-normal text-fg tracking-[-0.02em] mb-2">See it both ways</h2>
    <p class="text-[14.5px] leading-[1.6] text-fg-dim max-w-[680px] mb-5">
      One <a href={`${root}/examples/gradient`} class="text-accent hover:text-accent-hover transition-colors">gradient</a>
      module, emitted twice — WGSL for WebGPU and GLSL ES 3.00 for WebGL2. The backends diverge
      (<code class="font-mono text-[13px] text-fg">vec4&lt;f32&gt;</code> → <code class="font-mono text-[13px] text-fg">vec4</code>,
      the std140 block, the synthesised <code class="font-mono text-[13px] text-fg">main()</code>); the source doesn’t.
    </p>
    <div class="sd-code grid lg:grid-cols-2 gap-4 items-start">
      <div>
        <p class="text-[11px] font-mono text-fg-mute uppercase tracking-[0.16em] mb-2">WGSL — emitModule(m)</p>
        <Code code={gradient.wgsl} lang="wgsl" />
      </div>
      <div>
        <div class="flex items-center justify-between gap-3 mb-2">
          <p class="text-[11px] font-mono text-fg-mute uppercase tracking-[0.16em]">GLSL ES 3.00 — emitGlslModule(m, …)</p>
          <!-- GLSL compiles as two separate sources (unlike the single WGSL
               module), so each stage gets its own tab instead of one dump. -->
          <div class="flex gap-1" role="group" aria-label="GLSL stage">
            <button type="button" data-glsl-stage="vs" aria-pressed="true"
              class="font-mono text-[10.5px] px-2 py-0.5 rounded-full border border-line-strong text-fg transition-colors">vertex</button>
            <button type="button" data-glsl-stage="fs" aria-pressed="false"
              class="font-mono text-[10.5px] px-2 py-0.5 rounded-full border border-line text-fg-mute hover:text-fg transition-colors">fragment</button>
          </div>
        </div>
        <div data-glsl-panel="vs"><Code code={gradient.glslVertex ?? ''} lang="glsl" /></div>
        <div data-glsl-panel="fs" hidden><Code code={gradient.glslFragment ?? ''} lang="glsl" /></div>
      </div>
    </div>
  </section>

  <section class="mt-20 pt-10 border-t border-line" id="shipping">
    <h2 class="font-display text-[21px] font-normal text-fg tracking-[-0.02em] mb-2">Shipping shaders</h2>
    <p class="text-[14.5px] leading-[1.6] text-fg-dim max-w-[680px] mb-4">
      <strong class="text-fg">Your bundler minifies every byte of JS — but never the shader text handed to
      <code class="font-mono text-[13px]">gl.shaderSource</code>.</strong> Build-time plugins
      (<code class="font-mono text-[13px] text-fg">@xgis/shader-dsl/emit-prod</code>) fix that, composed the Vite/Webpack way:
      <code class="font-mono text-[13px] text-fg">emitModule(m, {'{ plugins: […] }'})</code>.
    </p>
    <ul class="text-[14px] leading-[1.55] text-fg-mute max-w-[680px] mb-3 space-y-1.5">
      <li><strong class="text-fg font-mono text-[13px]">mangle</strong> — renames authored names (helpers, structs, consts → <code class="font-mono text-[13px]">_f0/_S0/_k0</code>).</li>
      <li><strong class="text-fg font-mono text-[13px]">minify</strong> — strips whitespace and comments.</li>
      <li><strong class="text-fg font-mono text-[13px]">inline</strong> — lifts every helper into its call sites, so the call graph disappears.</li>
    </ul>
    <p class="text-[13.5px] leading-[1.6] text-fg-mute max-w-[680px] mb-5">
      The ABI boundary (entry points, binding names, UBO tags, struct fields) is never renamed, so reflection-driven hosts
      bind unchanged. Toggle below — every combination is emitted at build time, so the DSL never ships to the browser.
      <a href={`${root}/reference`} class="text-accent hover:text-accent-hover transition-colors">Reference →</a>
    </p>

    <div
      id="ship-demo"
      data-plain-bytes={String(shipPlainBytes)}
      class="rounded-[10px] border border-line overflow-hidden"
    >
      <div class="flex flex-wrap items-center gap-x-5 gap-y-3 px-4 py-3 border-b border-line bg-bg-card">
        {['inline', 'mangle', 'minify'].map((name) => (
          <label class="inline-flex items-center gap-2 cursor-pointer select-none">
            <input type="checkbox" data-ship-toggle={name} class="peer sr-only" />
            <span class="w-9 h-5 rounded-full bg-line-strong peer-checked:bg-accent transition-colors relative after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:rounded-full after:bg-white after:transition-transform peer-checked:after:translate-x-4"></span>
            <span class="font-mono text-[12.5px] text-fg">{name}()</span>
          </label>
        ))}
        <span class="ml-auto flex items-center gap-3">
          <code data-ship-call class="font-mono text-[11.5px] text-fg-mute hidden md:inline">{shipCombos[0].label}</code>
          <span data-ship-badge class="font-mono text-[12px] text-fg tabular-nums">{shipPlainBytes.toLocaleString()} B</span>
        </span>
      </div>
      <div class="sd-code">
        {shipCombos.map((c) => (
          <div data-ship-panel={c.key} data-bytes={String(c.bytes)} data-label={c.label} hidden={c.key !== '000'}>
            <Code code={c.code} lang="glsl" wrap={c.n} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="mt-12 rounded-[8px] border border-line p-5 bg-bg-card">
    <p class="text-[14px] leading-[1.6] text-fg-dim">
      Each <a href={`${root}/examples`} class="text-accent hover:text-accent-hover transition-colors">example</a>
      shows these concepts end to end: the DSL source, the emitted WGSL and GLSL, and the reflection JSON —
      next to the frame they produce.
    </p>
  </div>
</ShaderDsl>

<script>
  const stageBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-glsl-stage]'))
  const stagePanels = Array.from(document.querySelectorAll<HTMLElement>('[data-glsl-panel]'))
  stageBtns.forEach((b) =>
    b.addEventListener('click', () => {
      const stage = b.dataset.glslStage
      stagePanels.forEach((p) => { p.hidden = p.dataset.glslPanel !== stage })
      stageBtns.forEach((o) => {
        const on = o === b
        o.setAttribute('aria-pressed', String(on))
        o.classList.toggle('border-line-strong', on)
        o.classList.toggle('text-fg', on)
        o.classList.toggle('border-line', !on)
        o.classList.toggle('text-fg-mute', !on)
      })
    }),
  )

  // Shipping demo — toggle the inline/mangle/minify plugins and show the
  // matching build-time-emitted string, with a live (growth-aware) byte badge.
  const demo = document.getElementById('ship-demo')
  if (demo) {
    const plainBytes = Number(demo.dataset.plainBytes)
    const toggles = Array.from(demo.querySelectorAll<HTMLInputElement>('[data-ship-toggle]'))
    const panels = Array.from(demo.querySelectorAll<HTMLElement>('[data-ship-panel]'))
    const badge = demo.querySelector<HTMLElement>('[data-ship-badge]')!
    const call = demo.querySelector<HTMLElement>('[data-ship-call]')
    const bit = (name: string) =>
      toggles.find((t) => t.dataset.shipToggle === name)?.checked ? '1' : '0'
    const fmt = (n: number) => n.toLocaleString()
    const sync = () => {
      const key = `${bit('inline')}${bit('mangle')}${bit('minify')}`
      const active = panels.find((p) => p.dataset.shipPanel === key)!
      panels.forEach((p) => { p.hidden = p !== active })
      const bytes = Number(active.dataset.bytes)
      // inline() can GROW the pre-minify text (it duplicates helper bodies), so
      // the badge shows a signed delta rather than assuming a shrink.
      const pct = Math.round((Math.abs(bytes - plainBytes) / plainBytes) * 100)
      const sign = bytes <= plainBytes ? '−' : '+'
      badge.textContent =
        bytes === plainBytes ? `${fmt(bytes)} B` : `${fmt(plainBytes)} B → ${fmt(bytes)} B (${sign}${pct}%)`
      if (call) call.textContent = active.dataset.label ?? ''
    }
    toggles.forEach((t) => t.addEventListener('change', sync))
  }
</script>
