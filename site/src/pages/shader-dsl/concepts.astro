---
import ShaderDsl from '../../layouts/ShaderDsl.astro'
import { Code } from 'astro-expressive-code/components'
import { shaderCards } from '../../lib/shader-examples.ts'
import { examples } from '@xgis/shader-dsl/examples'
import { emitGlslModule } from '@xgis/shader-dsl'
import { mangle, minify } from '@xgis/shader-dsl/emit-prod'

const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
const root = `${base}/shader-dsl`

// A concrete dual-backend contrast: the gradient example, emitted both ways from one module.
const gradient = shaderCards.find((c) => c.id === 'gradient')!

// Shipping demo — kaleidoscope has a real authored vocabulary (hash / noise /
// fbm / palette), so the mangle+minify contrast is visible. Every combination
// of the two plugins is emitted at BUILD time by the real emit; the client just
// toggles which precomputed string is shown (the DSL never ships to the browser),
// and the byte counts are measurements, not copy.
const kal = examples.find((e) => e.id === 'kaleidoscope')!
const shipCombos = [
  { key: '00', mangle: false, minify: false, label: "emitGlslModule(m, 'fragment')" },
  { key: '10', mangle: true, minify: false, label: '{ plugins: [mangle()] }' },
  { key: '01', mangle: false, minify: true, label: '{ plugins: [minify()] }' },
  { key: '11', mangle: true, minify: true, label: '{ plugins: obfuscate() }' },
].map((c) => {
  const code = emitGlslModule(kal.module, 'fragment', {
    plugins: [...(c.mangle ? [mangle()] : []), ...(c.minify ? [minify()] : [])],
  })
  return { ...c, code, bytes: code.length }
})
const shipPlainBytes = shipCombos[0].bytes

const sections = [
  {
    id: 'ir',
    title: 'One typed IR',
    body: 'You build a tree of typed value-nodes (each carries a compile-time key like <code>vec3&lt;f32&gt;</code>) and imperative statements. Because the key is part of the TypeScript type, mixing a vec2 where a vec3 is wanted, or returning the wrong field, is a compile error — caught before any shader compiler runs. The IR is the single source every backend, the reflection, and the CPU oracle read from.',
  },
  {
    id: 'backends',
    title: 'Two backends, one source',
    body: 'A backend is a writer over the shared IR walk. The <strong>WGSL</strong> backend is the canonical one (byte-stable output, the full validate → caps → optimize pipeline) for WebGPU. The <strong>GLSL ES 3.00</strong> backend targets WebGL2: a uniform struct lowers to a std140 UBO block, <code>@vertex</code>/<code>@fragment</code> entry-IO lowers to <code>in</code>/<code>out</code> varyings + a synthesised <code>main()</code>, and the divergent spellings (a scalar cast <code>f32(x)</code>→<code>float(x)</code>, <code>atan2</code>→<code>atan</code>, an integer builtin cast for <code>gl_VertexID</code>) come from one neutral intrinsic registry.',
  },
  {
    id: 'fail-closed',
    title: 'Fail-closed capabilities',
    body: 'GLSL ES 3.00 has no compute, no SSBO, no multisampled-texture load. Rather than emit invalid GLSL, the GLSL backend’s capability set is empty for those, and a capability gate throws <code>UnsupportedFeatureError</code> up front. That is why the compute example shows WGSL + reflection only — the DSL refuses to pretend.',
  },
  {
    id: 'reflection',
    title: 'Reflection',
    body: '<code>reflect(module)</code> is additive and read-only over the IR — it never runs on the emit path, so it cannot change an emitted byte. It recovers the bind-group entries, the std140 / std430 struct byte layouts, and the entry-point signatures. The host packs its uniform buffer straight from those offsets; the live examples on this site do exactly that.',
  },
  {
    id: 'oracle',
    title: 'CPU f64 oracle',
    body: 'The same module compiles to an f64 CPU function. Running the GPU shader and the CPU mirror on the same inputs and comparing is how X-GIS catches the sibling-path divergences (fill vs outline, CPU vs GPU projection) that hide sub-pixel until a zoom or projection axis amplifies them.',
  },
  {
    id: 'optimize',
    title: 'Optimize + lint',
    body: 'Before emit, a pass pipeline runs CSE, DCE, LICM, const-fold, algebraic simplification, and auto-var/auto-let materialisation, plus a 21-rule lint engine (no-float-eq, single-exit, naming, dead-binding, …). The optimizer is WGSL-side so the byte-stable WGSL stays canonical; GLSL emit is an identity pass over the lowered tree.',
  },
]
---

<ShaderDsl
  current="concepts"
  title="X-GIS Shader DSL — Concepts"
  description="How the shader DSL works: one typed IR, two backends (WGSL + GLSL ES 3.00), reflection, a CPU f64 oracle, and an optimizer + lint pipeline."
>
  <h1 class="font-display font-normal text-fg leading-[1.0] tracking-[-0.02em] text-[40px] sm:text-[52px] lg:text-[64px]">Concepts</h1>
  <p class="mt-4 text-[16px] leading-[1.6] text-fg-dim max-w-[680px]">
    The DSL is a TSL-style graph with a real type checker, two backends, a reflection layer, a CPU
    oracle, and an optimizer — all over one intermediate representation.
  </p>

  <div class="mt-10 space-y-10">
    {sections.map((s) => (
      <section id={s.id}>
        <h2 class="font-display text-[21px] font-normal text-fg tracking-[-0.02em] mb-2">{s.title}</h2>
        <p class="text-[14.5px] leading-[1.65] text-fg-dim max-w-[700px]" set:html={s.body}></p>
      </section>
    ))}
  </div>

  <section class="mt-14">
    <h2 class="font-display text-[21px] font-normal text-fg tracking-[-0.02em] mb-2">See it both ways</h2>
    <p class="text-[14.5px] leading-[1.65] text-fg-dim max-w-[700px] mb-5">
      The <a href={`${root}/examples/gradient`} class="text-accent hover:text-accent-hover transition-colors">gradient</a>
      example, emitted from one module. Note the divergences the DSL handles: <code class="font-mono text-[13px] text-fg">vec4&lt;f32&gt;</code> →
      <code class="font-mono text-[13px] text-fg">vec4</code>, the std140 <code class="font-mono text-[13px] text-fg">uniform</code> block,
      and the entry-IO lowering to <code class="font-mono text-[13px] text-fg">in</code>/<code class="font-mono text-[13px] text-fg">out</code> varyings + <code class="font-mono text-[13px] text-fg">main()</code>.
    </p>
    <div class="sd-code grid lg:grid-cols-2 gap-4 items-start">
      <div>
        <p class="text-[11px] font-mono text-fg-mute uppercase tracking-[0.16em] mb-2">WGSL — emitModule(m)</p>
        <Code code={gradient.wgsl} lang="wgsl" />
      </div>
      <div>
        <div class="flex items-center justify-between gap-3 mb-2">
          <p class="text-[11px] font-mono text-fg-mute uppercase tracking-[0.16em]">GLSL ES 3.00 — emitGlslModule(m, …)</p>
          <!-- GLSL compiles as two separate sources (unlike the single WGSL
               module), so each stage gets its own tab instead of one dump. -->
          <div class="flex gap-1" role="group" aria-label="GLSL stage">
            <button type="button" data-glsl-stage="vs" aria-pressed="true"
              class="font-mono text-[10.5px] px-2 py-0.5 rounded-full border border-line-strong text-fg transition-colors">vertex</button>
            <button type="button" data-glsl-stage="fs" aria-pressed="false"
              class="font-mono text-[10.5px] px-2 py-0.5 rounded-full border border-line text-fg-mute hover:text-fg transition-colors">fragment</button>
          </div>
        </div>
        <div data-glsl-panel="vs"><Code code={gradient.glslVertex ?? ''} lang="glsl" /></div>
        <div data-glsl-panel="fs" hidden><Code code={gradient.glslFragment ?? ''} lang="glsl" /></div>
      </div>
    </div>
  </section>

  <section class="mt-14" id="shipping">
    <h2 class="font-display text-[21px] font-normal text-fg tracking-[-0.02em] mb-2">Shipping shaders</h2>
    <p class="text-[14.5px] leading-[1.65] text-fg-dim max-w-[700px] mb-5">
      Your bundler minifies every byte of JS — and none of the shader text it hands to
      <code class="font-mono text-[13px] text-fg">gl.shaderSource</code>. The production tooling lives on its own subpath and
      composes the Vite/Webpack way — <code class="font-mono text-[13px] text-fg">emitModule(m, {'{ plugins: [mangle(), minify()] }'})</code>
      (<code class="font-mono text-[13px] text-fg">obfuscate()</code> is that pair as a preset). <strong class="text-fg">mangle</strong>
      renames the authored vocabulary (helpers, plain structs, consts → <code class="font-mono text-[13px] text-fg">_f0/_S0/_k0</code>);
      <strong class="text-fg">minify</strong> compacts the text. The <em>ABI boundary</em> — entry points, binding names, UBO
      block tags, struct fields — is never touched, so reflection-driven hosts bind unchanged. Toggle the plugins below and
      watch the kaleidoscope fragment shader change live (every combination is emitted at build time — the DSL never ships to
      your browser). Details in the <a href={`${root}/reference`} class="text-accent hover:text-accent-hover transition-colors">reference</a>.
    </p>

    <div
      id="ship-demo"
      data-plain-bytes={String(shipPlainBytes)}
      class="rounded-[10px] border border-line overflow-hidden"
    >
      <div class="flex flex-wrap items-center gap-x-5 gap-y-3 px-4 py-3 border-b border-line bg-bg-card">
        <label class="inline-flex items-center gap-2 cursor-pointer select-none">
          <input type="checkbox" data-ship-toggle="mangle" class="peer sr-only" />
          <span class="w-9 h-5 rounded-full bg-line-strong peer-checked:bg-accent transition-colors relative after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:rounded-full after:bg-white after:transition-transform peer-checked:after:translate-x-4"></span>
          <span class="font-mono text-[12.5px] text-fg">mangle()</span>
        </label>
        <label class="inline-flex items-center gap-2 cursor-pointer select-none">
          <input type="checkbox" data-ship-toggle="minify" class="peer sr-only" />
          <span class="w-9 h-5 rounded-full bg-line-strong peer-checked:bg-accent transition-colors relative after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:rounded-full after:bg-white after:transition-transform peer-checked:after:translate-x-4"></span>
          <span class="font-mono text-[12.5px] text-fg">minify()</span>
        </label>
        <span class="ml-auto flex items-center gap-3">
          <code data-ship-call class="font-mono text-[11.5px] text-fg-mute hidden sm:inline">{shipCombos[0].label}</code>
          <span data-ship-badge class="font-mono text-[12px] text-fg tabular-nums">{shipPlainBytes.toLocaleString()} B</span>
        </span>
      </div>
      <div class="sd-code">
        {shipCombos.map((c) => (
          <div data-ship-panel={c.key} data-bytes={String(c.bytes)} hidden={c.key !== '00'}>
            <Code code={c.code} lang="glsl" wrap={c.minify} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="mt-12 rounded-[8px] border border-line p-5 bg-bg-card">
    <p class="text-[14px] leading-[1.6] text-fg-dim">
      Each <a href={`${root}/examples`} class="text-accent hover:text-accent-hover transition-colors">example</a>
      shows these concepts end to end: the DSL source, the emitted WGSL and GLSL, and the reflection JSON —
      next to the frame they produce.
    </p>
  </div>
</ShaderDsl>

<script>
  const stageBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-glsl-stage]'))
  const stagePanels = Array.from(document.querySelectorAll<HTMLElement>('[data-glsl-panel]'))
  stageBtns.forEach((b) =>
    b.addEventListener('click', () => {
      const stage = b.dataset.glslStage
      stagePanels.forEach((p) => { p.hidden = p.dataset.glslPanel !== stage })
      stageBtns.forEach((o) => {
        const on = o === b
        o.setAttribute('aria-pressed', String(on))
        o.classList.toggle('border-line-strong', on)
        o.classList.toggle('text-fg', on)
        o.classList.toggle('border-line', !on)
        o.classList.toggle('text-fg-mute', !on)
      })
    }),
  )

  // Shipping demo — toggle the mangle/minify plugins and show the matching
  // build-time-emitted string, with a live byte badge.
  const demo = document.getElementById('ship-demo')
  if (demo) {
    const plainBytes = Number(demo.dataset.plainBytes)
    const toggles = Array.from(demo.querySelectorAll<HTMLInputElement>('[data-ship-toggle]'))
    const panels = Array.from(demo.querySelectorAll<HTMLElement>('[data-ship-panel]'))
    const badge = demo.querySelector<HTMLElement>('[data-ship-badge]')!
    const call = demo.querySelector<HTMLElement>('[data-ship-call]')
    const fmt = (n: number) => n.toLocaleString()
    const sync = () => {
      const m = toggles.find((t) => t.dataset.shipToggle === 'mangle')?.checked ? '1' : '0'
      const n = toggles.find((t) => t.dataset.shipToggle === 'minify')?.checked ? '1' : '0'
      const key = `${m}${n}`
      const active = panels.find((p) => p.dataset.shipPanel === key)!
      panels.forEach((p) => { p.hidden = p !== active })
      const bytes = Number(active.dataset.bytes)
      const pct = Math.round((1 - bytes / plainBytes) * 100)
      badge.textContent = bytes === plainBytes ? `${fmt(bytes)} B` : `${fmt(plainBytes)} B → ${fmt(bytes)} B (−${pct}%)`
      const labels: Record<string, string> = {
        '00': "emitGlslModule(m, 'fragment')",
        '10': '{ plugins: [mangle()] }',
        '01': '{ plugins: [minify()] }',
        '11': '{ plugins: obfuscate() }',
      }
      if (call) call.textContent = labels[key]
    }
    toggles.forEach((t) => t.addEventListener('change', sync))
  }
</script>
