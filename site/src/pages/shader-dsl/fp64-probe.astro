---
// ═══ df64 GPU conformance probe (diagnostic, not in nav) ═══
//
// Runs a known-answer test PER df64 operation — plus the composed loran chain —
// through the REAL emit + the REAL _fp64 guard, the exact path the fp64 examples
// use. Each test's df64 result is rendered, read back as a real number, and
// compared to the CPU f64 oracle (JS number == f64). Output is a copy-pasteable
// text digest so the failing op(s) and the actual numbers are exact — no
// screenshot reading. SwiftShader (CI / headless) passes everything; the point
// is real-GPU behaviour, where driver fast-math can fold the error terms away.
//
// Every test is built so plain f32 would give a WRONG answer (a big magnitude +
// a sub-ulp signal), so a PASS genuinely means df64 held on this GPU.
import ShaderDsl from '../../layouts/ShaderDsl.astro'
import {
  fn,
  module,
  ioStruct,
  uniformStruct,
  builtin,
  location,
  u32,
  f32,
  vec2,
  vec3,
  vec4,
  toF32,
  toF64,
  sqrt,
  floor,
  fract,
  length,
  distance,
  normalize,
  dot,
  mix,
  abs,
  min,
  max,
  vec2f64,
  Let,
  f32T,
  vec2fT,
  vec4fT,
  u32T,
  vec2f64T,
  emitModule,
  emitGlslModule,
  reflect,
} from '@xgis/shader-dsl'

const VsOut = ioStruct('VsOut', { pos: builtin('position', vec4fT), uv: location(0, vec2fT) })
const vs = fn(
  'vs',
  { vi: builtin('vertex_index', u32T) },
  ({ vi }) => {
    const x = toF32(vi.bitAnd(u32(1))).mul(4).sub(1)
    const y = toF32(vi.shr(u32(1))).mul(4).sub(1)
    return VsOut.construct({ pos: vec4(x, y, 0, 1), uv: vec2(x.mul(0.5).add(0.5), y.mul(0.5).add(0.5)) })
  },
  { stage: 'vertex' },
)

// loran stations + observer, so the composed test reproduces the real render.
const ST_A: [number, number] = [1.2e7, 3.4e7]
const ST_B: [number, number] = [1.9e7, 2.6e7]
const OBS: [number, number] = [2.31e7 + 0.13, 3.07e7 + 0.57]

// Shared inputs (uniforms → no const-fold; the df64 chain must run on the GPU).
const U = uniformStruct(
  'Probe',
  { group: 0, binding: 0, as: 'u' },
  {
    big: f32T, // 1e8
    small: f32T, // 0.5
    root: f32T, // 1e6
    factor: vec2f64T, // df64 1 + 5e-9 (.x) — mul / div
    val: vec2f64T, // df64 1e8 + 0.5 (.x) — sub / floor / fract / cmp
    sq: vec2f64T, // df64 (1e6+0.5)^2 (.x) — sqrt
    mulA: vec2f64T, // df64 B+0.5 (.x), B≈1.23e6 — mul_sq (genuine hi·hi product)
    mulRef: vec2f64T, // df64 B²+B (.x) — the exact reference mul_sq subtracts
    pt: vec2f64T, // df64 vec (1e6+0.5, 0) — length / distance / dot / normalize
    vBig: vec2f64T, // df64 vec (1e8, 0) — vec64 add / sub / mul
    center: vec2f64T, // df64 observer — loran
    ra: vec2f64T, // df64 √2      ┐ tame irrational leaves for the random
    rb: vec2f64T, // df64 π/4     │ composition sweep — each carries a real lo
    rc: vec2f64T, // df64 e/2     │ word, so every EFT error term is exercised
    rd: vec2f64T, // df64 1/3     ┘ (see the generator below)
  },
)

// f: () => f32 node (the displayable result; every test targets 0.5 unless noted).
// The fragment encodes r ∈ [-2,2] into an 8-bit grey level: t = (r+2)/4, read back
// and decoded on the host (≈0.016 quantisation, well inside the 0.06 pass band).
type Test = {
  name: string
  glslVertex: string
  glslFragment: string
  wgsl: string
  vertexEntry: string
  fragmentEntry: string
  guardBinding: number | null
  reflection: ReturnType<typeof reflect>
  golden: number
  circular: boolean
}
const mk = (name: string, f: () => ReturnType<typeof toF32>, golden: number, circular = false): Test => {
  const fs = fn(
    `fs_${name}`,
    { vo: VsOut },
    () => {
      const r = Let(f())
      const t = Let(min(max(r.add(2).mul(0.25), f32(0)), f32(1)))
      // Pack t (∈[0,1)) across RGB8 (24-bit) so the host reads the result at full
      // f32 precision, not one 8-bit grey level — a correct answer reads ~0.5000
      // (not 0.4941), and a PARTIAL lo-word degradation becomes visible instead of
      // hiding under the ±0.016 grey quantisation. Host unpacks with the matching
      // dot(rgb, [1, 1/255, 1/65025]).
      const enc = Let(fract(vec3(t, t.mul(255), t.mul(65025))))
      const adj = Let(enc.sub(vec3(enc.y, enc.z, f32(0)).mul(1 / 255)))
      return vec4(adj, f32(1))
    },
    { stage: 'fragment', retAttr: '@location(0)' },
  )
  const m = module({ funcs: [vs, fs], uses: [U, VsOut] })
  const wgsl = emitModule(m)
  const gb = wgsl.match(/@binding\((\d+)\)\s+var\s+_fp64/)
  return {
    name,
    glslVertex: emitGlslModule(m, 'vertex'),
    glslFragment: emitGlslModule(m, 'fragment'),
    wgsl,
    vertexEntry: 'vs',
    fragmentEntry: `fs_${name}`,
    guardBinding: gb ? Number(gb[1]) : null,
    reflection: reflect(m),
    golden,
    circular,
  }
}

const B = () => U.field.big
const S = () => U.field.small
const R = () => U.field.root

// CPU f64 oracle (JS number == f64) for the composed loran chain.
const d1 = Math.hypot(OBS[0] - ST_A[0], OBS[1] - ST_A[1])
const d2 = Math.hypot(OBS[0] - ST_B[0], OBS[1] - ST_B[1])
// fract semantics (x − ⌊x⌋, always in [0,1)) — matches the shader's fract, NOT the
// truncated JS `%` (which returns a negative remainder for negative operands).
const tLoran = (d1 - d2) * 0.25
const THEXP = tLoran - Math.floor(tLoran)

const tests: Test[] = [
  // ── scalar arithmetic ──
  mk('add', () => toF32(toF64(B()).add(toF64(S())).sub(toF64(B()))), 0.5), // (1e8⊕0.5)⊖1e8
  mk('sub', () => toF32(U.field.val.x.sub(toF64(B()))), 0.5), // (1e8+0.5)⊖1e8
  mk('mul', () => toF32(toF64(B()).mul(U.field.factor.x).sub(toF64(B()))), 0.5), // 1e8·(1+5e-9)⊖1e8
  mk('div', () => toF32(U.field.val.x.div(toF64(B())).sub(toF64(1)).mul(toF64(B()))), 0.5), // ((1e8+.5)/1e8−1)·1e8
  mk('neg', () => toF32(toF64(B()).sub(U.field.val.x).neg()), 0.5), // −(1e8 − (1e8+.5))
  mk('abs', () => toF32(abs(U.field.val.x.sub(toF64(B())))), 0.5), // |(1e8+.5) − 1e8|
  mk('sqrt', () => toF32(sqrt(U.field.sq.x).sub(toF64(R()))), 0.5), // √((1e6+.5)²)⊖1e6
  // mul_sq: (B+0.5)² ⊖ (B²+B) = 0.25, ×2 → 0.5. Unlike `mul` above (whose big
  // operand multiplies 1.0 — exact on any ALU), BOTH hi words here are ~1.23e6,
  // so this exercises a genuine hi·hi f32 product — the split-based twoProd path
  // luma.gl's Intel/Apple HIGH_BITS_OVERFLOW workaround (split2) protects. A GPU
  // whose f32 multiply isn't correctly rounded fails HERE while `mul` passes.
  mk('mul_sq', () => toF32(U.field.mulA.x.mul(U.field.mulA.x).sub(U.field.mulRef.x).mul(2)), 0.5),
  mk('floor', () => toF32(U.field.val.x.sub(floor(U.field.val.x))), 0.5), // x − ⌊x⌋
  mk('fract', () => toF32(fract(U.field.val.x)), 0.5),
  mk('min', () => toF32(min(U.field.val.x, toF64(B()).add(2)).sub(toF64(B()))), 0.5),
  mk('max', () => toF32(max(U.field.val.x, toF64(B()).sub(2)).sub(toF64(B()))), 0.5),
  mk('mix', () => toF32(mix(toF64(B()), toF64(B()).add(1), S()).sub(toF64(B()))), 0.5), // t=0.5 → +.5
  // ── comparisons (near-equal df64 vs the f32-equal pair) ──
  mk('lt', () => toF64(B()).lt(U.field.val.x).select(f32(0.5), f32(0)), 0.5),
  mk('le', () => toF64(B()).le(U.field.val.x).select(f32(0.5), f32(0)), 0.5),
  mk('gt', () => U.field.val.x.gt(toF64(B())).select(f32(0.5), f32(0)), 0.5),
  mk('ge', () => U.field.val.x.ge(toF64(B())).select(f32(0.5), f32(0)), 0.5),
  mk('eq', () => U.field.val.x.eq(toF64(B())).select(f32(0), f32(0.5)), 0.5), // NOT equal in df64
  mk('ne', () => U.field.val.x.ne(toF64(B())).select(f32(0.5), f32(0)), 0.5),
  // ── vec64 (DF64VecN lane-wise) ──
  mk('vec_add', () => toF32(U.field.vBig.add(vec2f64(0.5, 0)).x.sub(toF64(B()))), 0.5),
  mk('vec_sub', () => toF32(U.field.vBig.add(vec2f64(0.5, 0)).sub(U.field.vBig).x), 0.5),
  mk('vec_mul', () => toF32(U.field.vBig.mul(vec2f64(1 + 0.5 / 1e8, 1)).x.sub(toF64(B()))), 0.5),
  mk('dot', () => toF32(dot(U.field.pt, vec2f64(1, 0)).sub(toF64(R()))), 0.5), // (1e6+.5)·1 ⊖ 1e6
  mk('length', () => toF32(length(U.field.pt).sub(toF64(R()))), 0.5), // |(1e6+.5,0)| ⊖ 1e6
  mk('distance', () => toF32(distance(U.field.pt, vec2f64(0, 0)).sub(toF64(R()))), 0.5),
  mk('normalize', () => toF32(normalize(U.field.pt).x), 1.0), // (1e6+.5,0) → (1,0); code-path check
  mk(
    'loran',
    () =>
      toF32(
        fract(
          distance(U.field.center, vec2f64(ST_A[0], ST_A[1]))
            .sub(distance(U.field.center, vec2f64(ST_B[0], ST_B[1])))
            .mul(0.25),
        ),
      ),
    THEXP,
    true,
  ),
  // ── Diagnostic bisect (Apple df64 collapse) ──
  // On Apple, `add` (which builds 1e8+0.5 on-GPU via a twoSum) holds but `sub`
  // (which loads the same df64 from a uniform) collapses — same cancellation,
  // different lo-word source. These isolate that, and test whether laundering the
  // uniform-loaded value through a real df64 op restores it (the candidate fix).
  // All target 0.5; every one passes on a correctly-rounded GPU (SwiftShader).
  mk('dg_sub_ld', () => toF32(U.field.val.x.sub(toF64(B()))), 0.5), // uniform lo → sub (Apple: expect FAIL)
  mk('dg_sub_cp', () => toF32(toF64(B()).add(toF64(S())).sub(toF64(B()))), 0.5), // computed lo → sub (expect PASS)
  mk('dg_launder', () => toF32(U.field.val.x.add(toF64(S())).sub(toF64(S())).sub(toF64(B()))), 0.5), // launder uniform lo (+.5−.5) → sub — the FIX test
  mk('dg_launder0', () => toF32(U.field.val.x.add(toF64(f32(0))).sub(toF64(B()))), 0.5), // launder via +0 (does the guard block the x+0→x fold?)
  mk('dg_mul_lnd', () => toF32(toF64(B()).mul(U.field.factor.x.add(toF64(S())).sub(toF64(S()))).sub(toF64(B()))), 0.5), // launder uniform factor → mul (FIX test, mul side)
]

// Host-side packed inputs. df64: lossless double → (hi, lo) f32 pair.
const fr = Math.fround
const df = (x: number): [number, number] => [fr(x), fr(x - fr(x))]
const sc = (x: number): number[] => [df(x)[0], 0, df(x)[1], 0] // vec2f64 field, value only in .x
const factor = 1 + 0.5 / 1e8
// mul_sq base: a globe-magnitude integer so B+0.5 is f32-exact and B²+B stays
// under 2⁵³ (packs losslessly into df64). B² ≈ 1.5e12 — length/distance square
// coordinates of this size, so this is a realistic, not synthetic, stress.
const MUL_B = 1234567
const values: Record<string, number[]> = {
  big: [1e8],
  small: [0.5],
  root: [1e6],
  factor: sc(factor),
  val: sc(1e8 + 0.5),
  sq: sc((1e6 + 0.5) * (1e6 + 0.5)),
  mulA: sc(MUL_B + 0.5),
  mulRef: sc(MUL_B * MUL_B + MUL_B),
  pt: [df(1e6 + 0.5)[0], 0, df(1e6 + 0.5)[1], 0],
  vBig: [df(1e8)[0], 0, df(1e8)[1], 0],
  center: [df(OBS[0])[0], df(OBS[1])[0], df(OBS[0])[1], df(OBS[1])[1]],
  ra: sc(Math.SQRT2),
  rb: sc(Math.PI / 4),
  rc: sc(Math.E / 2),
  rd: sc(1 / 3),
}

// ── Random composition sweep ──
//
// The fixed tests above each exercise ONE df64 op. But a driver's fast-math has
// the most room to reassociate — and so to delete the EFT error terms — inside a
// COMPOSED expression (the loran chain and the Mandelbrot iteration that first
// broke on real hardware were both compositions). So this generates seeded random
// df64 expression TREES over the four irrational leaves and runs each on the GPU.
//
// Two invariants make each kept tree a clean pass/fail probe:
//   1. well-conditioned — a catastrophic-cancellation add/sub is rejected, so a
//      CORRECT df64 tracks the f64 golden to ~2^-46 (κ ≈ 1, no false failures);
//   2. discriminative — plain f32 must get the tree wrong by ≥ 2^-23, so a df64
//      collapse is unmistakable (the same "f32 provably fails" gate the unit tests
//      use). Trees f32 already nails carry no signal and are skipped.
// The kernel outputs the AMPLIFIED relative error vs the baked f64 golden: a
// correct GPU reads ~0 (PASS), a fast-math / non-correctly-rounded-multiply
// collapse saturates the channel (FAIL). The golden is the native-f64 value of
// the same tree — more accurate than df64, so df64's own ~2^-46 is the residual.
const RIN = [Math.SQRT2, Math.PI / 4, Math.E / 2, 1 / 3] // must match ra..rb..rc..rd above
const RIN_DF = RIN.map((x) => df(x)[0] + df(x)[1]) // the exact df64 value the GPU reads
const RLEAF = [U.field.ra.x, U.field.rb.x, U.field.rc.x, U.field.rd.x] as const

const rprng = (seed: number): (() => number) => {
  let s = seed >>> 0
  return () => {
    s = (s + 0x6d2b79f5) | 0
    let t = Math.imul(s ^ (s >>> 15), 1 | s)
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
  }
}
// eslint-disable-next-line @typescript-eslint/no-explicit-any
type Df64Node = any
// An abstract node carries its DSL builder plus its f64 (golden) and f32 (signal)
// values at the fixed leaves — so the generator can reject cancellation and gate
// on the f32 error without re-emitting.
type RNode = { render: (L: readonly Df64Node[]) => Df64Node; v: number; vf: number }
const RUN = ['neg', 'abs', 'sqrt'] as const
const RBIN = ['add', 'sub', 'mul', 'min', 'max', 'div'] as const
const frd = Math.fround
const leaf = (i: number): RNode => ({ render: (L) => L[i], v: RIN_DF[i]!, vf: frd(RIN_DF[i]!) })
const rgen = (rnd: () => number, depth: number): RNode => {
  if (depth <= 0 || rnd() < 0.25) return leaf(Math.floor(rnd() * 4))
  for (let attempt = 0; attempt < 8; attempt++) {
    if (rnd() < 0.4) {
      const op = RUN[Math.floor(rnd() * RUN.length)]
      const x = rgen(rnd, depth - 1)
      if (op === 'neg') return { render: (L) => x.render(L).neg(), v: -x.v, vf: frd(-x.vf) }
      if (op === 'abs') return { render: (L) => abs(x.render(L)), v: Math.abs(x.v), vf: frd(Math.abs(x.vf)) }
      return { render: (L) => sqrt(abs(x.render(L))), v: Math.sqrt(Math.abs(x.v)), vf: frd(Math.sqrt(Math.abs(x.vf))) }
    }
    const op = RBIN[Math.floor(rnd() * RBIN.length)]
    const x = rgen(rnd, depth - 1)
    const y = rgen(rnd, depth - 1)
    if (op === 'add' || op === 'sub') {
      const v = op === 'add' ? x.v + y.v : x.v - y.v
      if (Math.abs(v) < 0.1 * Math.max(Math.abs(x.v), Math.abs(y.v))) continue // reject cancellation
      const vf = frd(op === 'add' ? x.vf + y.vf : x.vf - y.vf)
      return { render: (L) => (op === 'add' ? x.render(L).add(y.render(L)) : x.render(L).sub(y.render(L))), v, vf }
    }
    if (op === 'mul') return { render: (L) => x.render(L).mul(y.render(L)), v: x.v * y.v, vf: frd(x.vf * y.vf) }
    if (op === 'min') return { render: (L) => min(x.render(L), y.render(L)), v: Math.min(x.v, y.v), vf: frd(Math.min(x.vf, y.vf)) }
    if (op === 'max') return { render: (L) => max(x.render(L), y.render(L)), v: Math.max(x.v, y.v), vf: frd(Math.max(x.vf, y.vf)) }
    // div guarded away from 0: divide by |y| + 1
    return { render: (L) => x.render(L).div(abs(y.render(L)).add(toF64(1))), v: x.v / (Math.abs(y.v) + 1), vf: frd(x.vf / (Math.abs(y.vf) + 1)) }
  }
  return leaf(Math.floor(rnd() * 4))
}

const R_SCALE = 2 ** 25 // held ~2^-46 → ~2^-21 (≈0); collapse ~2^-24 → saturates
const rrnd = rprng(0x5f3759df)
const randomTests: Test[] = []
for (let i = 0; i < 6000 && randomTests.length < 24; i++) {
  const t = rgen(rrnd, 5)
  const golden = t.v
  if (!isFinite(golden) || Math.abs(golden) < 1e-3) continue
  if (Math.abs((t.vf - golden) / golden) < 2 ** -23) continue // discriminative: f32 must provably fail
  const idx = randomTests.length
  randomTests.push(
    mk(
      `rand${String(idx).padStart(2, '0')}`,
      () => {
        const resid = toF32(t.render(RLEAF).sub(golden)) // df64(expr) − golden, narrowed to f32
        return abs(resid).div(f32(Math.abs(golden) + 2 ** -30)).mul(R_SCALE) // amplified: 0 held, saturates on collapse
      },
      0,
    ),
  )
}

const payload = { values, tests: [...tests, ...randomTests] }
---

<ShaderDsl current="fp64-probe" hideSectionNav title="X-GIS Shader DSL — df64 GPU conformance probe" description="Per-op df64 known-answer tests on WebGPU + WebGL2 through the real emit + guard, GPU readback vs CPU oracle.">
  <h1 class="font-display font-normal text-fg leading-[1.0] tracking-[-0.02em] text-[40px] sm:text-[52px] lg:text-[64px]">df64 GPU conformance probe</h1>
  <p class="mt-4 text-[16px] leading-[1.6] text-fg-dim max-w-full">
    One known-answer test per df64 operation, plus the composed <strong class="text-fg">loran</strong> chain, run on
    <strong class="text-fg">both backends — WebGPU (WGSL) and WebGL2 (GLSL)</strong> — through the same emit +
    <code class="font-mono text-[13px] text-fg">_fp64</code> guard the examples use. Each result is read back as a real number
    and compared to the CPU f64 oracle. Every test is built so plain f32 gives a wrong answer, so <strong class="text-fg">PASS means df64
    held on this GPU</strong>. The final <strong class="text-fg">Random composition</strong> family fuzzes seeded random df64
    expression <em>trees</em> — where a driver's fast-math has a whole expression to reassociate, and so the most room to
    delete the error terms single ops survive. Run it, then hit <strong class="text-fg">Copy</strong> and paste the digest back (per device).
  </p>

  <!-- Results — the table skeleton renders on load (you see WHAT is being tested
       right away); each backend cell starts as a spinner and is swapped in place
       for the value the moment that test resolves, so completed vs in-progress is
       visible per row. No full-page loading gate. -->
  <div id="probe-out">
    <div class="mt-10 flex items-start justify-between gap-4">
      <div id="probe-summary" class="min-w-0 flex-1" aria-live="polite"></div>
      <button
        id="probe-copy"
        type="button"
        class="shrink-0 inline-flex items-center gap-1.5 px-3.5 h-8 rounded-full text-[12px] font-medium text-fg-dim hover:text-fg border border-line hover:border-line-strong transition-colors opacity-40 pointer-events-none"
        aria-label="Copy df64 digest"
      >
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
        </svg>
        <span class="copy-label">Copy</span>
      </button>
    </div>

    <!-- Results table — built once from the test list; cells are updated in place.
         The table IS the view now; the old raw-digest dump duplicated it, so it's
         gone. Copy still emits the same frozen text digest (for pasting back). -->
    <div id="probe-table" class="mt-8 max-w-full overflow-x-auto"></div>
  </div>

  <p class="mt-8 text-[13px] leading-[1.6] text-fg-mute max-w-full">
    SwiftShader (CI / headless) passes everything — the diagnostic value is on real GPUs, where driver fast-math can fold the df64 error terms away.
  </p>
</ShaderDsl>

<script type="application/json" id="probe-payload" set:html={JSON.stringify(payload)}></script>

<script>
  type Refl = { uniforms: { name: string; size: number; fields: { name: string; offset: number }[] }[] }
  type T = {
    name: string; glslVertex: string; glslFragment: string; wgsl: string
    vertexEntry: string; fragmentEntry: string; guardBinding: number | null
    reflection: Refl; golden: number; circular: boolean
  }
  const summary = document.getElementById('probe-summary')!
  const tableEl = document.getElementById('probe-table')!
  const copyBtn = document.getElementById('probe-copy') as HTMLButtonElement
  // RGB8 (24-bit) unpack → r ∈ [-2,2]. Inverse of the fragment's pack; a black
  // (undrawn) pixel decodes to exactly -2, distinct from a collapsed df64 (~0).
  const decode = (R: number, G: number, B: number) =>
    (R / 255 + G / 65025 + B / 16581375) * 4 - 2
  const pack = (block: Refl['uniforms'][0], values: Record<string, number[]>): ArrayBuffer => {
    const buf = new ArrayBuffer(Math.ceil(block.size / 16) * 16)
    const f = new Float32Array(buf)
    for (const fld of block.fields) { const v = values[fld.name] ?? [0]; for (let i = 0; i < v.length; i++) f[fld.offset / 4 + i] = v[i] }
    return buf
  }
  const verdict = (r: number | null, gold: number, circular: boolean): string => {
    if (r == null) return 'ERR'
    let d = Math.abs(r - gold); if (circular) d = Math.min(d, 1 - d)
    return d < 0.06 ? 'PASS' : Math.abs(r) < 0.06 ? 'FAIL(→0)' : 'FAIL'
  }
  const isFail = (vr: string): boolean => vr !== 'PASS' && vr !== 'n/a'

  // Families group the tests so a block pattern (e.g. "vec64 collapsed as a unit")
  // reads at a glance. Order within a family is DEFINITION order and stays put —
  // rows must not reshuffle under the reader as results land, so unlike the old
  // one-shot table there is no failures-first sort; the left rust tick flags fails.
  const famOf = (n: string): 'scalar' | 'vector' | 'comparison' | 'composed' | 'diag' | 'random' =>
    /^dg_/.test(n) ? 'diag'
    : /^rand/.test(n) ? 'random'
    : n === 'loran' ? 'composed'
    : /^(lt|le|gt|ge|eq|ne)$/.test(n) ? 'comparison'
    : /^vec_|^(dot|length|distance|normalize)$/.test(n) ? 'vector'
    : 'scalar'
  const FAMS: [string, string][] = [['scalar', 'Scalar'], ['vector', 'Vector · vec64'], ['comparison', 'Comparison'], ['composed', 'Composed'], ['diag', 'Diagnostic — Apple bisect'], ['random', 'Random composition']]

  // A RESOLVED cell: the value carries the only hue (rust on fail), the reason is
  // grey lowercase meta. A PENDING cell is a small spinner, swapped out in place.
  const cell = (v: number | null, vr: string): string => {
    if (vr === 'n/a') return '<span class="text-fg-faint">—</span>'
    if (v == null) return '<span class="font-mono text-[11px] text-destructive">err</span>'
    const num = `<span class="font-mono tabular-nums text-[13px] ${vr === 'PASS' ? 'text-fg-mute' : 'text-destructive'}">${v.toFixed(4)}</span>`
    if (vr === 'PASS') return num
    const why = Math.abs(v) < 0.06 ? 'collapsed→0' : Math.abs(v + 2) < 0.06 ? 'no draw' : 'wrong'
    return `${num} <span class="font-mono text-[11px] text-fg-mute">${why}</span>`
  }
  const PENDING = '<span class="inline-block w-3 h-3 align-middle rounded-full border-2 border-line border-t-fg-mute animate-spin motion-reduce:animate-none"></span>'
  // Narrow, fixed result columns on mobile so all three fit the viewport (the
  // reason tag wraps under the value via flex-wrap on the cells); the roomier
  // desktop layout returns at sm.
  const GRID =
    'grid grid-cols-[minmax(64px,1fr)_88px_88px] sm:grid-cols-[minmax(84px,1fr)_140px_140px] gap-x-2 sm:gap-x-4 items-center'

  ;(async () => {
    try {
      const { values, tests } = JSON.parse(document.getElementById('probe-payload')!.textContent!) as { values: Record<string, number[]>; tests: T[] }
      const total = tests.length

      // ── Skeleton: render EVERY test immediately (you see what is tested before
      // anything runs), each backend cell a "pending" spinner. Built once; cells
      // are then swapped in place — the table never re-renders wholesale. ──
      const groups = FAMS
        .map(([key, label]) => ({ label, items: tests.filter((t) => famOf(t.name) === key) }))
        .filter((g) => g.items.length)
      const colhead = `<div class="${GRID} pl-4 pr-4 border-l-2 border-transparent mb-3 text-[11px] font-mono text-fg-mute uppercase tracking-[0.16em]">
        <span>Test</span><span class="text-right">WebGL2</span><span class="text-right">WebGPU</span>
      </div>`
      tableEl.innerHTML = colhead + '<div class="space-y-8">' + groups.map((g) => `
        <section>
          <h2 class="font-display text-[20px] font-normal text-fg tracking-[-0.015em] mb-2">${g.label}</h2>
          <div class="rounded-[8px] border border-line overflow-hidden divide-y divide-[var(--color-line)]">${g.items.map((t) => `<div data-row="${t.name}" class="${GRID} py-2.5 pl-4 pr-4 border-l-2 border-transparent hover:bg-bg-hover transition-colors">
            <code class="font-mono text-[13px] text-fg leading-[1.5]">${t.name}<span data-differ="${t.name}"></span></code>
            <div class="flex flex-wrap justify-end items-baseline gap-x-1 text-right" data-gl="${t.name}">${PENDING}</div>
            <div class="flex flex-wrap justify-end items-baseline gap-x-1 text-right" data-gpu="${t.name}">${PENDING}</div>
          </div>`).join('')}</div>
        </section>`).join('') + '</div>'
      const q = (sel: string) => tableEl.querySelector(sel) as HTMLElement

      // ── Live state — also feeds the frozen text digest built at the end. ──
      const glRes: Record<string, number | null> = {}, gpuRes: Record<string, number | null> = {}
      const glVer: Record<string, string> = {}, gpuVer: Record<string, string> = {}
      let glPass = 0, gpuPass = 0, glDone = 0, gpuDone = 0
      let glAvail = true, gpuAvail = true, glGuard = false, gpuGuard = false, gpuNote = ''

      // Summary ticks the pass count up live; a trailing spinner + n/total marks a
      // backend still in progress, resolved to "all pass" / "N failed" when done.
      const summaryLine = (label: string, pass: number, done: number, avail: boolean, guard: boolean): string => {
        const running = done < total
        const body = !avail
          ? '<span class="text-[13px] text-fg-mute">not available on this browser</span>'
          : `<span class="font-display text-[22px] leading-none text-fg tabular-nums">${pass}<span class="text-fg-mute text-[14px]">/${total}</span></span>`
            + (running
              ? `<span class="inline-flex items-center gap-1.5 text-[12px] text-fg-mute">${PENDING}${done}/${total}</span>`
              : (total - pass ? `<span class="text-[12px] text-destructive">${total - pass} failed</span>` : '<span class="text-[12px] text-fg-mute">all pass</span>')
                + (guard ? '' : '<span class="text-[12px] text-destructive">guard missing</span>'))
        return `<div class="flex items-baseline gap-x-3 gap-y-1 flex-wrap"><span class="text-[11px] font-mono text-fg-mute uppercase tracking-[0.16em] shrink-0 whitespace-nowrap min-w-[104px]">${label}</span>${body}</div>`
      }
      const renderSummary = () => {
        summary.innerHTML = `<div class="space-y-3">${summaryLine('WebGL2 · GLSL', glPass, glDone, glAvail, glGuard)}${summaryLine('WebGPU · WGSL', gpuPass, gpuDone, gpuAvail, gpuGuard)}</div>`
      }
      const markFail = (name: string) => { const r = q(`[data-row="${name}"]`); r.classList.remove('border-transparent'); r.classList.add('border-destructive') }
      const showDiffer = (name: string) => {
        if (!gpuAvail || glVer[name] === undefined || gpuVer[name] === undefined || glVer[name] === gpuVer[name]) return
        const s = q(`[data-differ="${name}"]`); if (s) s.outerHTML = `<span data-differ="${name}" class="font-mono text-[11px] text-destructive lowercase"> differ</span>`
      }
      // Swap one cell from spinner → resolved value the moment its test lands.
      const report = (side: 'gl' | 'gpu', name: string, v: number | null, vr: string) => {
        q(`[data-${side}="${name}"]`).innerHTML = vr === 'n/a' ? '<span class="text-fg-faint">—</span>' : cell(v, vr)
        if (side === 'gl') { glRes[name] = v; glVer[name] = vr; glDone++; if (vr === 'PASS') glPass++ }
        else { gpuRes[name] = v; gpuVer[name] = vr; gpuDone++; if (vr === 'PASS') gpuPass++ }
        if (isFail(vr)) markFail(name)
        showDiffer(name); renderSummary()
      }
      renderSummary()
      const raf = () => new Promise<void>((r) => requestAnimationFrame(() => r()))

      // WebGL2 (GLSL): each test → 8×8 draw, read back, report, yield so the just-
      // filled cell paints before the next runs (progress is visible, not a freeze).
      const runWebGL = async () => {
        const canvas = document.createElement('canvas'); canvas.width = 8; canvas.height = 8
        const gl = canvas.getContext('webgl2')
        if (!gl) { glAvail = false; for (const t of tests) report('gl', t.name, null, 'n/a'); return }
        const gtex = gl.createTexture()
        gl.activeTexture(gl.TEXTURE7); gl.bindTexture(gl.TEXTURE_2D, gtex)
        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA8, 1, 1, 0, gl.RGBA, gl.UNSIGNED_BYTE, new Uint8Array([255, 255, 255, 255]))
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.NEAREST); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST)
        gl.activeTexture(gl.TEXTURE0); gl.bindVertexArray(gl.createVertexArray()); gl.viewport(0, 0, 8, 8)
        for (const t of tests) {
          try {
            const c = (ty: number, src: string) => { const s = gl.createShader(ty)!; gl.shaderSource(s, src); gl.compileShader(s); if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s) || ''); return s }
            const p = gl.createProgram()!
            gl.attachShader(p, c(gl.VERTEX_SHADER, t.glslVertex)); gl.attachShader(p, c(gl.FRAGMENT_SHADER, t.glslFragment)); gl.linkProgram(p)
            if (!gl.getProgramParameter(p, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(p) || '')
            gl.useProgram(p)
            const block = t.reflection.uniforms[0]
            if (block) { const ubo = gl.createBuffer(); gl.bindBuffer(gl.UNIFORM_BUFFER, ubo); gl.bufferData(gl.UNIFORM_BUFFER, pack(block, values), gl.STATIC_DRAW); const i = gl.getUniformBlockIndex(p, block.name); if (i !== 0xffffffff) { gl.uniformBlockBinding(p, i, 0); gl.bindBufferBase(gl.UNIFORM_BUFFER, 0, ubo) } }
            const gLoc = gl.getUniformLocation(p, '_fp64'); if (gLoc) { gl.uniform1i(gLoc, 7); glGuard = true }
            gl.clearColor(0, 0, 0, 1); gl.clear(gl.COLOR_BUFFER_BIT); gl.drawArrays(gl.TRIANGLES, 0, 3)
            const px = new Uint8Array(4); gl.readPixels(4, 4, 1, 1, gl.RGBA, gl.UNSIGNED_BYTE, px)
            const v = decode(px[0], px[1], px[2]); report('gl', t.name, v, verdict(v, t.golden, t.circular))
          } catch (e) { report('gl', t.name, null, 'ERR') }
          await raf()
        }
      }

      // WebGPU (WGSL): same modules; each test awaits a real GPU readback, then reports.
      const runWebGPU = async () => {
        const g = (navigator as any).gpu
        if (!g) { gpuAvail = false; gpuNote = 'WebGPU unavailable (no navigator.gpu)'; for (const t of tests) report('gpu', t.name, null, 'n/a'); return }
        let adapter: any
        try { adapter = await g.requestAdapter() } catch { gpuAvail = false; gpuNote = 'requestAdapter threw'; for (const t of tests) report('gpu', t.name, null, 'n/a'); return }
        if (!adapter) { gpuAvail = false; gpuNote = 'no adapter'; for (const t of tests) report('gpu', t.name, null, 'n/a'); return }
        let device: any
        try { device = await adapter.requestDevice() } catch { gpuAvail = false; gpuNote = 'requestDevice threw'; for (const t of tests) report('gpu', t.name, null, 'n/a'); return }
        const TU = (globalThis as any).GPUTextureUsage, BU = (globalThis as any).GPUBufferUsage, MM = (globalThis as any).GPUMapMode
        const guardTex = device.createTexture({ size: [1, 1], format: 'rgba8unorm', usage: TU.TEXTURE_BINDING | TU.COPY_DST })
        device.queue.writeTexture({ texture: guardTex }, new Uint8Array([255, 255, 255, 255]), { bytesPerRow: 4, rowsPerImage: 1 }, [1, 1])
        const guardView = guardTex.createView()
        for (const t of tests) {
          try {
            const mod = device.createShaderModule({ code: t.wgsl })
            const target = device.createTexture({ size: [8, 8], format: 'rgba8unorm', usage: TU.RENDER_ATTACHMENT | TU.COPY_SRC })
            const ab = pack(t.reflection.uniforms[0], values)
            const ubuf = device.createBuffer({ size: ab.byteLength, usage: BU.UNIFORM | BU.COPY_DST }); device.queue.writeBuffer(ubuf, 0, ab)
            const pipeline = device.createRenderPipeline({ layout: 'auto', vertex: { module: mod, entryPoint: t.vertexEntry }, fragment: { module: mod, entryPoint: t.fragmentEntry, targets: [{ format: 'rgba8unorm' }] }, primitive: { topology: 'triangle-list' } })
            const entries: any[] = [{ binding: 0, resource: { buffer: ubuf } }]
            if (t.guardBinding != null) { entries.push({ binding: t.guardBinding, resource: guardView }); gpuGuard = true }
            const bg = device.createBindGroup({ layout: pipeline.getBindGroupLayout(0), entries })
            const rb = device.createBuffer({ size: 256 * 8, usage: BU.COPY_DST | BU.MAP_READ })
            const enc = device.createCommandEncoder()
            const pass = enc.beginRenderPass({ colorAttachments: [{ view: target.createView(), loadOp: 'clear', storeOp: 'store', clearValue: { r: 0, g: 0, b: 0, a: 1 } }] })
            pass.setPipeline(pipeline); pass.setBindGroup(0, bg); pass.draw(3); pass.end()
            enc.copyTextureToBuffer({ texture: target }, { buffer: rb, bytesPerRow: 256, rowsPerImage: 8 }, [8, 8])
            device.queue.submit([enc.finish()])
            await rb.mapAsync(MM.READ)
            const arr = new Uint8Array(rb.getMappedRange().slice(0)); const o = 4 * 256 + 4 * 4
            rb.unmap()
            const v = decode(arr[o], arr[o + 1], arr[o + 2]); report('gpu', t.name, v, verdict(v, t.golden, t.circular))
          } catch (e) { report('gpu', t.name, null, 'ERR') }
        }
        const info = adapter.info || {}
        gpuNote = `adapter ${info.vendor || ''} ${info.architecture || ''}`.trim()
      }

      // Both backends fill their own column concurrently.
      await Promise.all([runWebGL(), runWebGPU()])
      renderSummary()

      // ── Frozen text digest (format unchanged — the dev's parser reads it),
      // built in-memory now that the on-page dump is gone; Copy emits this. ──
      const rows = tests.map((t) => {
        const gv = glRes[t.name] ?? null, pv = gpuRes[t.name] ?? null
        const gs = gv == null ? '  ERR ' : gv.toFixed(4)
        const ps = !gpuAvail ? '   —  ' : pv == null ? '  ERR ' : pv.toFixed(4)
        return `${t.name.padEnd(9)} gold=${t.golden.toFixed(4)}  WebGL2 ${gs} ${(glVer[t.name] ?? 'ERR').padEnd(8)} | WebGPU ${ps} ${gpuAvail ? (gpuVer[t.name] ?? 'ERR') : 'n/a'}`
      })
      const digestText =
        `df64 GPU probe\n` +
        `  WebGL2: ${glPass}/${total} pass · guard=${glGuard ? 'bound' : 'MISSING'}\n` +
        `  WebGPU: ${gpuAvail ? `${gpuPass}/${total} pass · guard=${gpuGuard ? 'bound' : 'MISSING'} · ${gpuNote}` : gpuNote}\n` +
        `  UA: ${navigator.userAgent}\n\n` +
        rows.join('\n')

      copyBtn.classList.remove('opacity-40', 'pointer-events-none')
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(digestText)
          const l = copyBtn.querySelector('.copy-label')
          if (!l) return
          const o = l.textContent
          l.textContent = 'Copied'
          copyBtn.classList.add('text-accent')
          setTimeout(() => { l.textContent = o; copyBtn.classList.remove('text-accent') }, 1400)
        } catch { /* clipboard denied (insecure context) — fail silently */ }
      })
    } catch (e) {
      const msg = 'ERROR: ' + (e instanceof Error ? e.message : String(e))
      summary.innerHTML = `<p class="text-[13px] text-destructive font-mono">${msg}</p>`
    }
  })()
</script>
