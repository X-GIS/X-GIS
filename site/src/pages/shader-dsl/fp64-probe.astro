---
// ═══ df64 GPU conformance probe (diagnostic, not in nav) ═══
//
// Runs a known-answer test PER df64 operation — plus the composed loran chain —
// through the REAL emit + the REAL _fp64 guard, the exact path the fp64 examples
// use. Each test's df64 result is rendered, read back as a real number, and
// compared to the CPU f64 oracle (JS number == f64). Output is a copy-pasteable
// text digest so the failing op(s) and the actual numbers are exact — no
// screenshot reading. SwiftShader (CI / headless) passes everything; the point
// is real-GPU behaviour, where driver fast-math can fold the error terms away.
//
// Every test is built so plain f32 would give a WRONG answer (a big magnitude +
// a sub-ulp signal), so a PASS genuinely means df64 held on this GPU.
import ShaderDsl from '../../layouts/ShaderDsl.astro'
import {
  fn,
  module,
  ioStruct,
  uniformStruct,
  builtin,
  location,
  u32,
  f32,
  vec2,
  vec3,
  vec4,
  toF32,
  toF64,
  sqrt,
  floor,
  fract,
  length,
  distance,
  min,
  max,
  vec2f64,
  Let,
  f32T,
  vec2fT,
  vec4fT,
  u32T,
  vec2f64T,
  emitGlslModule,
  reflect,
} from '@xgis/shader-dsl'

const VsOut = ioStruct('VsOut', { pos: builtin('position', vec4fT), uv: location(0, vec2fT) })
const vs = fn(
  'vs',
  { vi: builtin('vertex_index', u32T) },
  ({ vi }) => {
    const x = toF32(vi.bitAnd(u32(1))).mul(4).sub(1)
    const y = toF32(vi.shr(u32(1))).mul(4).sub(1)
    return VsOut.construct({ pos: vec4(x, y, 0, 1), uv: vec2(x.mul(0.5).add(0.5), y.mul(0.5).add(0.5)) })
  },
  { stage: 'vertex' },
)

// loran stations + observer, so the composed test reproduces the real render.
const ST_A: [number, number] = [1.2e7, 3.4e7]
const ST_B: [number, number] = [1.9e7, 2.6e7]
const OBS: [number, number] = [2.31e7 + 0.13, 3.07e7 + 0.57]

// Shared inputs (uniforms → no const-fold; the df64 chain must run on the GPU).
const U = uniformStruct(
  'Probe',
  { group: 0, binding: 0, as: 'u' },
  {
    big: f32T, // 1e8
    small: f32T, // 0.5
    root: f32T, // 1e6
    factor: vec2f64T, // df64 1 + 5e-9 (.x) — mul / div
    val: vec2f64T, // df64 1e8 + 0.5 (.x) — sub / floor / fract / cmp
    sq: vec2f64T, // df64 (1e6+0.5)^2 (.x) — sqrt
    pt: vec2f64T, // df64 vec (1e6+0.5, 0) — length / distance
    center: vec2f64T, // df64 observer — loran
  },
)

// f: () => f32 node (the displayable result; every test targets 0.5 unless noted).
// The fragment encodes r ∈ [-2,2] into an 8-bit grey level: t = (r+2)/4, read back
// and decoded on the host (≈0.016 quantisation, well inside the 0.06 pass band).
type Test = { name: string; glslVertex: string; glslFragment: string; reflection: ReturnType<typeof reflect>; golden: number; circular: boolean }
const mk = (name: string, f: () => ReturnType<typeof toF32>, golden: number, circular = false): Test => {
  const fs = fn(
    `fs_${name}`,
    { vo: VsOut },
    () => {
      const r = Let(f())
      const t = Let(min(max(r.add(2).mul(0.25), f32(0)), f32(1)))
      return vec4(vec3(t), f32(1))
    },
    { stage: 'fragment', retAttr: '@location(0)' },
  )
  const m = module({ funcs: [vs, fs], uses: [U, VsOut] })
  return {
    name,
    glslVertex: emitGlslModule(m, 'vertex'),
    glslFragment: emitGlslModule(m, 'fragment'),
    reflection: reflect(m),
    golden,
    circular,
  }
}

const B = () => U.field.big
const S = () => U.field.small
const R = () => U.field.root

// CPU f64 oracle (JS number == f64) for the composed loran chain.
const d1 = Math.hypot(OBS[0] - ST_A[0], OBS[1] - ST_A[1])
const d2 = Math.hypot(OBS[0] - ST_B[0], OBS[1] - ST_B[1])
const thRaw = ((d1 - d2) * 0.25) % 1
const THEXP = thRaw < 0 ? thRaw + 1 : thRaw

const tests: Test[] = [
  mk('add', () => toF32(toF64(B()).add(toF64(S())).sub(toF64(B()))), 0.5), // (1e8⊕0.5)⊖1e8
  mk('sub', () => toF32(U.field.val.x.sub(toF64(B()))), 0.5), // (1e8+0.5)⊖1e8
  mk('mul', () => toF32(toF64(B()).mul(U.field.factor.x).sub(toF64(B()))), 0.5), // 1e8·(1+5e-9)⊖1e8
  mk('div', () => toF32(U.field.val.x.div(toF64(B())).sub(toF64(1)).mul(toF64(B()))), 0.5), // ((1e8+.5)/1e8−1)·1e8
  mk('sqrt', () => toF32(sqrt(U.field.sq.x).sub(toF64(R()))), 0.5), // √((1e6+.5)²)⊖1e6
  mk('floor', () => toF32(U.field.val.x.sub(floor(U.field.val.x))), 0.5), // x − ⌊x⌋
  mk('fract', () => toF32(fract(U.field.val.x)), 0.5),
  mk('cmp', () => U.field.val.x.gt(toF64(B())).select(f32(0.5), f32(0)), 0.5), // (1e8+.5) > 1e8 ?
  mk('length', () => toF32(length(U.field.pt).sub(toF64(R()))), 0.5), // |(1e6+.5,0)| ⊖ 1e6
  mk('distance', () => toF32(distance(U.field.pt, vec2f64(0, 0)).sub(toF64(R()))), 0.5),
  mk(
    'loran',
    () =>
      toF32(
        fract(
          distance(U.field.center, vec2f64(ST_A[0], ST_A[1]))
            .sub(distance(U.field.center, vec2f64(ST_B[0], ST_B[1])))
            .mul(0.25),
        ),
      ),
    THEXP,
    true,
  ),
]

// Host-side packed inputs. df64: lossless double → (hi, lo) f32 pair.
const fr = Math.fround
const df = (x: number): [number, number] => [fr(x), fr(x - fr(x))]
const sc = (x: number): number[] => [df(x)[0], 0, df(x)[1], 0] // vec2f64 field, value only in .x
const factor = 1 + 0.5 / 1e8
const values: Record<string, number[]> = {
  big: [1e8],
  small: [0.5],
  root: [1e6],
  factor: sc(factor),
  val: sc(1e8 + 0.5),
  sq: sc((1e6 + 0.5) * (1e6 + 0.5)),
  pt: [df(1e6 + 0.5)[0], 0, df(1e6 + 0.5)[1], 0],
  center: [df(OBS[0])[0], df(OBS[1])[0], df(OBS[0])[1], df(OBS[1])[1]],
}
const payload = {
  values,
  tests: tests.map((t) => ({ name: t.name, glslVertex: t.glslVertex, glslFragment: t.glslFragment, reflection: t.reflection, golden: t.golden, circular: t.circular })),
}
---

<ShaderDsl current="probe" hideSectionNav title="X-GIS Shader DSL — df64 GPU conformance probe" description="Per-op df64 known-answer tests through the real emit + guard, GPU readback vs CPU oracle.">
  <h1 class="font-display font-normal text-fg leading-[1.0] tracking-[-0.02em] text-[30px] sm:text-[38px]">df64 GPU conformance probe</h1>
  <p class="mt-4 text-[15px] leading-[1.6] text-fg-dim max-w-full">
    One known-answer test per df64 operation, plus the composed <strong class="text-fg">loran</strong> chain, run through the same
    emit + <code class="font-mono text-[13px] text-fg">_fp64</code> guard the examples use. Each result is read back as a real number
    and compared to the CPU f64 oracle. Every test is built so plain f32 gives a wrong answer, so <strong class="text-fg">PASS means df64
    held on this GPU</strong>. Copy the digest below and paste it back (per device).
  </p>
  <div id="probe-chips" class="mt-5 flex flex-wrap gap-1.5 max-w-full"></div>
  <pre id="probe-digest" class="mt-4 max-w-full overflow-x-auto rounded-[10px] border border-line bg-bg-card p-4 font-mono text-[12px] leading-[1.6] text-fg-dim whitespace-pre">running…</pre>
  <canvas id="probe-gl" width="8" height="8" class="hidden"></canvas>
  <p class="mt-3 text-[13px] leading-[1.6] text-fg-mute max-w-full">
    SwiftShader (CI / headless) passes everything — the diagnostic value is on real GPUs, where driver fast-math can fold the df64 error terms away.
  </p>
</ShaderDsl>

<script type="application/json" id="probe-payload" set:html={JSON.stringify(payload)}></script>

<script>
  type Refl = { uniforms: { name: string; size: number; fields: { name: string; offset: number }[] }[] }
  type T = { name: string; glslVertex: string; glslFragment: string; reflection: Refl; golden: number; circular: boolean }
  const digest = document.getElementById('probe-digest')!
  const chips = document.getElementById('probe-chips')!
  try {
    const { values, tests } = JSON.parse(document.getElementById('probe-payload')!.textContent!) as {
      values: Record<string, number[]>; tests: T[]
    }
    const canvas = document.getElementById('probe-gl') as HTMLCanvasElement
    const gl = canvas.getContext('webgl2')
    if (!gl) throw new Error('WebGL2 not supported on this device')

    const build = (vsSrc: string, fsSrc: string): WebGLProgram => {
      const c = (type: number, src: string) => {
        const sh = gl.createShader(type)!
        gl.shaderSource(sh, src); gl.compileShader(sh)
        if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(sh) || 'compile')
        return sh
      }
      const p = gl.createProgram()!
      gl.attachShader(p, c(gl.VERTEX_SHADER, vsSrc)); gl.attachShader(p, c(gl.FRAGMENT_SHADER, fsSrc))
      gl.linkProgram(p)
      if (!gl.getProgramParameter(p, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(p) || 'link')
      return p
    }
    // Guard texture (texel 1.0) on unit 7 — shared across every program.
    const gtex = gl.createTexture()
    gl.activeTexture(gl.TEXTURE7); gl.bindTexture(gl.TEXTURE_2D, gtex)
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA8, 1, 1, 0, gl.RGBA, gl.UNSIGNED_BYTE, new Uint8Array([255, 255, 255, 255]))
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.NEAREST)
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST)
    gl.activeTexture(gl.TEXTURE0)
    gl.bindVertexArray(gl.createVertexArray())
    gl.viewport(0, 0, canvas.width, canvas.height)

    let guardBound = false
    const runOne = (t: T): number => {
      const prog = build(t.glslVertex, t.glslFragment)
      gl.useProgram(prog)
      const block = t.reflection.uniforms[0]
      if (block) {
        const buf = new ArrayBuffer(Math.ceil(block.size / 16) * 16)
        const f32 = new Float32Array(buf)
        for (const f of block.fields) { const v = values[f.name] ?? [0]; for (let i = 0; i < v.length; i++) f32[f.offset / 4 + i] = v[i] }
        const ubo = gl.createBuffer()
        gl.bindBuffer(gl.UNIFORM_BUFFER, ubo); gl.bufferData(gl.UNIFORM_BUFFER, buf, gl.STATIC_DRAW)
        const idx = gl.getUniformBlockIndex(prog, block.name)
        if (idx !== 0xffffffff) { gl.uniformBlockBinding(prog, idx, 0); gl.bindBufferBase(gl.UNIFORM_BUFFER, 0, ubo) }
      }
      const gLoc = gl.getUniformLocation(prog, '_fp64')
      if (gLoc) { gl.uniform1i(gLoc, 7); guardBound = true }
      gl.clearColor(0, 0, 0, 1); gl.clear(gl.COLOR_BUFFER_BIT)
      gl.drawArrays(gl.TRIANGLES, 0, 3)
      const px = new Uint8Array(4)
      gl.readPixels(4, 4, 1, 1, gl.RGBA, gl.UNSIGNED_BYTE, px)
      return (px[0] / 255) * 4 - 2 // decode grey → r
    }

    const rows: string[] = []
    chips.innerHTML = ''
    let nFail = 0
    for (const t of tests) {
      let gpu = NaN, verdict = 'ERR', diff = NaN
      try {
        gpu = runOne(t)
        let d = Math.abs(gpu - t.golden)
        if (t.circular) d = Math.min(d, 1 - d)
        diff = d
        verdict = d < 0.06 ? 'PASS' : Math.abs(gpu) < 0.06 ? 'FAIL(→0)' : 'FAIL'
      } catch (e) { verdict = 'ERR:' + (e instanceof Error ? e.message.slice(0, 30) : '') }
      if (verdict !== 'PASS') nFail++
      const chip = document.createElement('span')
      chip.className = 'font-mono text-[11px] px-2 py-0.5 rounded-full border'
      const ok = verdict === 'PASS'
      chip.style.cssText = `border-color:${ok ? '#22d16a' : '#f24340'};color:${ok ? '#22d16a' : '#f24340'}`
      chip.textContent = `${t.name} ${ok ? '✓' : '✗'}`
      chips.appendChild(chip)
      rows.push(`${t.name.padEnd(9)} GPU=${gpu.toFixed(4).padStart(8)}  gold=${t.golden.toFixed(4)}  Δ=${diff.toExponential(1).padStart(8)}  ${verdict}`)
    }
    const header = `df64 GPU probe · guard=${guardBound ? 'bound' : 'MISSING'} · ${tests.length - nFail}/${tests.length} pass\nUA: ${navigator.userAgent}\n`
    digest.textContent = header + '\n' + rows.join('\n')
  } catch (e) {
    digest.textContent = 'ERROR: ' + (e instanceof Error ? e.message : String(e))
    digest.style.color = '#f24340'
  }
</script>
