---
// ═══ df64 GPU conformance probe (diagnostic, not in nav) ═══
//
// Runs a known-answer test PER df64 operation — plus the composed loran chain —
// through the REAL emit + the REAL _fp64 guard, the exact path the fp64 examples
// use. Each test's df64 result is rendered, read back as a real number, and
// compared to the CPU f64 oracle (JS number == f64). Output is a copy-pasteable
// text digest so the failing op(s) and the actual numbers are exact — no
// screenshot reading. SwiftShader (CI / headless) passes everything; the point
// is real-GPU behaviour, where driver fast-math can fold the error terms away.
//
// Every test is built so plain f32 would give a WRONG answer (a big magnitude +
// a sub-ulp signal), so a PASS genuinely means df64 held on this GPU.
import ShaderDsl from '../../layouts/ShaderDsl.astro'
import {
  fn,
  module,
  ioStruct,
  uniformStruct,
  builtin,
  location,
  u32,
  f32,
  vec2,
  vec3,
  vec4,
  toF32,
  toF64,
  sqrt,
  floor,
  fract,
  length,
  distance,
  normalize,
  dot,
  mix,
  abs,
  min,
  max,
  vec2f64,
  Let,
  f32T,
  vec2fT,
  vec4fT,
  u32T,
  vec2f64T,
  emitModule,
  emitGlslModule,
  reflect,
} from '@xgis/shader-dsl'

const VsOut = ioStruct('VsOut', { pos: builtin('position', vec4fT), uv: location(0, vec2fT) })
const vs = fn(
  'vs',
  { vi: builtin('vertex_index', u32T) },
  ({ vi }) => {
    const x = toF32(vi.bitAnd(u32(1))).mul(4).sub(1)
    const y = toF32(vi.shr(u32(1))).mul(4).sub(1)
    return VsOut.construct({ pos: vec4(x, y, 0, 1), uv: vec2(x.mul(0.5).add(0.5), y.mul(0.5).add(0.5)) })
  },
  { stage: 'vertex' },
)

// loran stations + observer, so the composed test reproduces the real render.
const ST_A: [number, number] = [1.2e7, 3.4e7]
const ST_B: [number, number] = [1.9e7, 2.6e7]
const OBS: [number, number] = [2.31e7 + 0.13, 3.07e7 + 0.57]

// Shared inputs (uniforms → no const-fold; the df64 chain must run on the GPU).
const U = uniformStruct(
  'Probe',
  { group: 0, binding: 0, as: 'u' },
  {
    big: f32T, // 1e8
    small: f32T, // 0.5
    root: f32T, // 1e6
    factor: vec2f64T, // df64 1 + 5e-9 (.x) — mul / div
    val: vec2f64T, // df64 1e8 + 0.5 (.x) — sub / floor / fract / cmp
    sq: vec2f64T, // df64 (1e6+0.5)^2 (.x) — sqrt
    mulA: vec2f64T, // df64 B+0.5 (.x), B≈1.23e6 — mul_sq (genuine hi·hi product)
    mulRef: vec2f64T, // df64 B²+B (.x) — the exact reference mul_sq subtracts
    pt: vec2f64T, // df64 vec (1e6+0.5, 0) — length / distance / dot / normalize
    vBig: vec2f64T, // df64 vec (1e8, 0) — vec64 add / sub / mul
    center: vec2f64T, // df64 observer — loran
  },
)

// f: () => f32 node (the displayable result; every test targets 0.5 unless noted).
// The fragment encodes r ∈ [-2,2] into an 8-bit grey level: t = (r+2)/4, read back
// and decoded on the host (≈0.016 quantisation, well inside the 0.06 pass band).
type Test = {
  name: string
  glslVertex: string
  glslFragment: string
  wgsl: string
  vertexEntry: string
  fragmentEntry: string
  guardBinding: number | null
  reflection: ReturnType<typeof reflect>
  golden: number
  circular: boolean
}
const mk = (name: string, f: () => ReturnType<typeof toF32>, golden: number, circular = false): Test => {
  const fs = fn(
    `fs_${name}`,
    { vo: VsOut },
    () => {
      const r = Let(f())
      const t = Let(min(max(r.add(2).mul(0.25), f32(0)), f32(1)))
      // Pack t (∈[0,1)) across RGB8 (24-bit) so the host reads the result at full
      // f32 precision, not one 8-bit grey level — a correct answer reads ~0.5000
      // (not 0.4941), and a PARTIAL lo-word degradation becomes visible instead of
      // hiding under the ±0.016 grey quantisation. Host unpacks with the matching
      // dot(rgb, [1, 1/255, 1/65025]).
      const enc = Let(fract(vec3(t, t.mul(255), t.mul(65025))))
      const adj = Let(enc.sub(vec3(enc.y, enc.z, f32(0)).mul(1 / 255)))
      return vec4(adj, f32(1))
    },
    { stage: 'fragment', retAttr: '@location(0)' },
  )
  const m = module({ funcs: [vs, fs], uses: [U, VsOut] })
  const wgsl = emitModule(m)
  const gb = wgsl.match(/@binding\((\d+)\)\s+var\s+_fp64/)
  return {
    name,
    glslVertex: emitGlslModule(m, 'vertex'),
    glslFragment: emitGlslModule(m, 'fragment'),
    wgsl,
    vertexEntry: 'vs',
    fragmentEntry: `fs_${name}`,
    guardBinding: gb ? Number(gb[1]) : null,
    reflection: reflect(m),
    golden,
    circular,
  }
}

const B = () => U.field.big
const S = () => U.field.small
const R = () => U.field.root

// CPU f64 oracle (JS number == f64) for the composed loran chain.
const d1 = Math.hypot(OBS[0] - ST_A[0], OBS[1] - ST_A[1])
const d2 = Math.hypot(OBS[0] - ST_B[0], OBS[1] - ST_B[1])
// fract semantics (x − ⌊x⌋, always in [0,1)) — matches the shader's fract, NOT the
// truncated JS `%` (which returns a negative remainder for negative operands).
const tLoran = (d1 - d2) * 0.25
const THEXP = tLoran - Math.floor(tLoran)

const tests: Test[] = [
  // ── scalar arithmetic ──
  mk('add', () => toF32(toF64(B()).add(toF64(S())).sub(toF64(B()))), 0.5), // (1e8⊕0.5)⊖1e8
  mk('sub', () => toF32(U.field.val.x.sub(toF64(B()))), 0.5), // (1e8+0.5)⊖1e8
  mk('mul', () => toF32(toF64(B()).mul(U.field.factor.x).sub(toF64(B()))), 0.5), // 1e8·(1+5e-9)⊖1e8
  mk('div', () => toF32(U.field.val.x.div(toF64(B())).sub(toF64(1)).mul(toF64(B()))), 0.5), // ((1e8+.5)/1e8−1)·1e8
  mk('neg', () => toF32(toF64(B()).sub(U.field.val.x).neg()), 0.5), // −(1e8 − (1e8+.5))
  mk('abs', () => toF32(abs(U.field.val.x.sub(toF64(B())))), 0.5), // |(1e8+.5) − 1e8|
  mk('sqrt', () => toF32(sqrt(U.field.sq.x).sub(toF64(R()))), 0.5), // √((1e6+.5)²)⊖1e6
  // mul_sq: (B+0.5)² ⊖ (B²+B) = 0.25, ×2 → 0.5. Unlike `mul` above (whose big
  // operand multiplies 1.0 — exact on any ALU), BOTH hi words here are ~1.23e6,
  // so this exercises a genuine hi·hi f32 product — the split-based twoProd path
  // luma.gl's Intel/Apple HIGH_BITS_OVERFLOW workaround (split2) protects. A GPU
  // whose f32 multiply isn't correctly rounded fails HERE while `mul` passes.
  mk('mul_sq', () => toF32(U.field.mulA.x.mul(U.field.mulA.x).sub(U.field.mulRef.x).mul(2)), 0.5),
  mk('floor', () => toF32(U.field.val.x.sub(floor(U.field.val.x))), 0.5), // x − ⌊x⌋
  mk('fract', () => toF32(fract(U.field.val.x)), 0.5),
  mk('min', () => toF32(min(U.field.val.x, toF64(B()).add(2)).sub(toF64(B()))), 0.5),
  mk('max', () => toF32(max(U.field.val.x, toF64(B()).sub(2)).sub(toF64(B()))), 0.5),
  mk('mix', () => toF32(mix(toF64(B()), toF64(B()).add(1), S()).sub(toF64(B()))), 0.5), // t=0.5 → +.5
  // ── comparisons (near-equal df64 vs the f32-equal pair) ──
  mk('lt', () => toF64(B()).lt(U.field.val.x).select(f32(0.5), f32(0)), 0.5),
  mk('le', () => toF64(B()).le(U.field.val.x).select(f32(0.5), f32(0)), 0.5),
  mk('gt', () => U.field.val.x.gt(toF64(B())).select(f32(0.5), f32(0)), 0.5),
  mk('ge', () => U.field.val.x.ge(toF64(B())).select(f32(0.5), f32(0)), 0.5),
  mk('eq', () => U.field.val.x.eq(toF64(B())).select(f32(0), f32(0.5)), 0.5), // NOT equal in df64
  mk('ne', () => U.field.val.x.ne(toF64(B())).select(f32(0.5), f32(0)), 0.5),
  // ── vec64 (DF64VecN lane-wise) ──
  mk('vec_add', () => toF32(U.field.vBig.add(vec2f64(0.5, 0)).x.sub(toF64(B()))), 0.5),
  mk('vec_sub', () => toF32(U.field.vBig.add(vec2f64(0.5, 0)).sub(U.field.vBig).x), 0.5),
  mk('vec_mul', () => toF32(U.field.vBig.mul(vec2f64(1 + 0.5 / 1e8, 1)).x.sub(toF64(B()))), 0.5),
  mk('dot', () => toF32(dot(U.field.pt, vec2f64(1, 0)).sub(toF64(R()))), 0.5), // (1e6+.5)·1 ⊖ 1e6
  mk('length', () => toF32(length(U.field.pt).sub(toF64(R()))), 0.5), // |(1e6+.5,0)| ⊖ 1e6
  mk('distance', () => toF32(distance(U.field.pt, vec2f64(0, 0)).sub(toF64(R()))), 0.5),
  mk('normalize', () => toF32(normalize(U.field.pt).x), 1.0), // (1e6+.5,0) → (1,0); code-path check
  mk(
    'loran',
    () =>
      toF32(
        fract(
          distance(U.field.center, vec2f64(ST_A[0], ST_A[1]))
            .sub(distance(U.field.center, vec2f64(ST_B[0], ST_B[1])))
            .mul(0.25),
        ),
      ),
    THEXP,
    true,
  ),
]

// Host-side packed inputs. df64: lossless double → (hi, lo) f32 pair.
const fr = Math.fround
const df = (x: number): [number, number] => [fr(x), fr(x - fr(x))]
const sc = (x: number): number[] => [df(x)[0], 0, df(x)[1], 0] // vec2f64 field, value only in .x
const factor = 1 + 0.5 / 1e8
// mul_sq base: a globe-magnitude integer so B+0.5 is f32-exact and B²+B stays
// under 2⁵³ (packs losslessly into df64). B² ≈ 1.5e12 — length/distance square
// coordinates of this size, so this is a realistic, not synthetic, stress.
const MUL_B = 1234567
const values: Record<string, number[]> = {
  big: [1e8],
  small: [0.5],
  root: [1e6],
  factor: sc(factor),
  val: sc(1e8 + 0.5),
  sq: sc((1e6 + 0.5) * (1e6 + 0.5)),
  mulA: sc(MUL_B + 0.5),
  mulRef: sc(MUL_B * MUL_B + MUL_B),
  pt: [df(1e6 + 0.5)[0], 0, df(1e6 + 0.5)[1], 0],
  vBig: [df(1e8)[0], 0, df(1e8)[1], 0],
  center: [df(OBS[0])[0], df(OBS[1])[0], df(OBS[0])[1], df(OBS[1])[1]],
}
const payload = { values, tests }
---

<ShaderDsl current="fp64-probe" hideSectionNav title="X-GIS Shader DSL — df64 GPU conformance probe" description="Per-op df64 known-answer tests on WebGPU + WebGL2 through the real emit + guard, GPU readback vs CPU oracle.">
  <h1 class="font-display font-normal text-fg leading-[1.0] tracking-[-0.02em] text-[30px] sm:text-[38px]">df64 GPU conformance probe</h1>
  <p class="mt-4 text-[15px] leading-[1.6] text-fg-dim max-w-full">
    One known-answer test per df64 operation, plus the composed <strong class="text-fg">loran</strong> chain, run on
    <strong class="text-fg">both backends — WebGPU (WGSL) and WebGL2 (GLSL)</strong> — through the same emit +
    <code class="font-mono text-[13px] text-fg">_fp64</code> guard the examples use. Each result is read back as a real number
    and compared to the CPU f64 oracle. Every test is built so plain f32 gives a wrong answer, so <strong class="text-fg">PASS means df64
    held on this GPU</strong>. Run it, then hit <strong class="text-fg">Copy</strong> and paste the digest back (per device).
  </p>

  <!-- Loading -->
  <div id="probe-loading" class="mt-7 flex items-center gap-2.5 text-fg-mute text-[13px]">
    <span class="inline-block w-3.5 h-3.5 rounded-full border-2 border-line border-t-fg animate-spin motion-reduce:animate-none"></span>
    <span>Running tests on WebGL2 + WebGPU…</span>
  </div>

  <!-- Results — faded in when the run resolves -->
  <div id="probe-out" class="opacity-0 transition-opacity duration-200 motion-reduce:transition-none">
    <div class="mt-7 flex items-start justify-between gap-4">
      <div id="probe-summary" class="min-w-0 flex-1" aria-live="polite"></div>
      <button
        id="probe-copy"
        type="button"
        class="shrink-0 inline-flex items-center gap-1.5 px-3.5 h-8 rounded-full text-[12px] font-medium text-fg-dim hover:text-fg border border-line hover:border-line-strong transition-colors"
        aria-label="Copy df64 digest"
      >
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
        </svg>
        <span class="copy-label">Copy</span>
      </button>
    </div>

    <!-- Results table — grouped by family, failures first within each (built from the same results objects as the digest) -->
    <div id="probe-table" class="mt-8 max-w-full overflow-x-auto"></div>

    <!-- Raw digest — the copy-pasteable artifact the dev parses; format is frozen -->
    <details class="mt-8">
      <summary class="cursor-pointer select-none text-[11px] font-mono text-fg-mute uppercase tracking-[0.16em] hover:text-fg-dim transition-colors">Raw digest</summary>
      <pre id="probe-digest" class="mt-3 max-w-full overflow-x-auto rounded-[8px] border border-line bg-bg-card p-4 font-mono text-[12px] leading-[1.6] text-fg-dim whitespace-pre"></pre>
    </details>
  </div>

  <p class="mt-8 text-[13px] leading-[1.6] text-fg-mute max-w-full">
    SwiftShader (CI / headless) passes everything — the diagnostic value is on real GPUs, where driver fast-math can fold the df64 error terms away.
  </p>
</ShaderDsl>

<script type="application/json" id="probe-payload" set:html={JSON.stringify(payload)}></script>

<script>
  type Refl = { uniforms: { name: string; size: number; fields: { name: string; offset: number }[] }[] }
  type T = {
    name: string; glslVertex: string; glslFragment: string; wgsl: string
    vertexEntry: string; fragmentEntry: string; guardBinding: number | null
    reflection: Refl; golden: number; circular: boolean
  }
  const digest = document.getElementById('probe-digest')!
  const loading = document.getElementById('probe-loading')!
  const out = document.getElementById('probe-out')!
  const summary = document.getElementById('probe-summary')!
  const tableEl = document.getElementById('probe-table')!
  const copyBtn = document.getElementById('probe-copy') as HTMLButtonElement
  // RGB8 (24-bit) unpack → r ∈ [-2,2]. Inverse of the fragment's pack; a black
  // (undrawn) pixel decodes to exactly -2, distinct from a collapsed df64 (~0).
  const decode = (R: number, G: number, B: number) =>
    (R / 255 + G / 65025 + B / 16581375) * 4 - 2
  const pack = (block: Refl['uniforms'][0], values: Record<string, number[]>): ArrayBuffer => {
    const buf = new ArrayBuffer(Math.ceil(block.size / 16) * 16)
    const f = new Float32Array(buf)
    for (const fld of block.fields) { const v = values[fld.name] ?? [0]; for (let i = 0; i < v.length; i++) f[fld.offset / 4 + i] = v[i] }
    return buf
  }

  // WebGL2 (GLSL): render each test to an 8×8 target, read back the grey level.
  function runWebGL(tests: T[], values: Record<string, number[]>): { guard: boolean; results: Record<string, number | null> } {
    const canvas = document.createElement('canvas'); canvas.width = 8; canvas.height = 8
    const gl = canvas.getContext('webgl2')
    const results: Record<string, number | null> = {}
    if (!gl) return { guard: false, results }
    const gtex = gl.createTexture()
    gl.activeTexture(gl.TEXTURE7); gl.bindTexture(gl.TEXTURE_2D, gtex)
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA8, 1, 1, 0, gl.RGBA, gl.UNSIGNED_BYTE, new Uint8Array([255, 255, 255, 255]))
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.NEAREST); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST)
    gl.activeTexture(gl.TEXTURE0); gl.bindVertexArray(gl.createVertexArray()); gl.viewport(0, 0, 8, 8)
    let guard = false
    for (const t of tests) {
      try {
        const c = (ty: number, src: string) => { const s = gl.createShader(ty)!; gl.shaderSource(s, src); gl.compileShader(s); if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s) || ''); return s }
        const p = gl.createProgram()!
        gl.attachShader(p, c(gl.VERTEX_SHADER, t.glslVertex)); gl.attachShader(p, c(gl.FRAGMENT_SHADER, t.glslFragment)); gl.linkProgram(p)
        if (!gl.getProgramParameter(p, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(p) || '')
        gl.useProgram(p)
        const block = t.reflection.uniforms[0]
        if (block) { const ubo = gl.createBuffer(); gl.bindBuffer(gl.UNIFORM_BUFFER, ubo); gl.bufferData(gl.UNIFORM_BUFFER, pack(block, values), gl.STATIC_DRAW); const i = gl.getUniformBlockIndex(p, block.name); if (i !== 0xffffffff) { gl.uniformBlockBinding(p, i, 0); gl.bindBufferBase(gl.UNIFORM_BUFFER, 0, ubo) } }
        const gLoc = gl.getUniformLocation(p, '_fp64'); if (gLoc) { gl.uniform1i(gLoc, 7); guard = true }
        gl.clearColor(0, 0, 0, 1); gl.clear(gl.COLOR_BUFFER_BIT); gl.drawArrays(gl.TRIANGLES, 0, 3)
        const px = new Uint8Array(4); gl.readPixels(4, 4, 1, 1, gl.RGBA, gl.UNSIGNED_BYTE, px)
        results[t.name] = decode(px[0], px[1], px[2])
      } catch (e) { results[t.name] = null }
    }
    return { guard, results }
  }

  // WebGPU (WGSL): same modules, render to an 8×8 target, copy → buffer, read the grey level.
  async function runWebGPU(tests: T[], values: Record<string, number[]>): Promise<{ ok: boolean; note: string; guard: boolean; results: Record<string, number | null> }> {
    const g = (navigator as any).gpu
    const results: Record<string, number | null> = {}
    if (!g) return { ok: false, note: 'WebGPU unavailable (no navigator.gpu)', guard: false, results }
    let adapter: any
    try { adapter = await g.requestAdapter() } catch { return { ok: false, note: 'requestAdapter threw', guard: false, results } }
    if (!adapter) return { ok: false, note: 'no adapter', guard: false, results }
    const device = await adapter.requestDevice()
    const TU = (globalThis as any).GPUTextureUsage, BU = (globalThis as any).GPUBufferUsage, MM = (globalThis as any).GPUMapMode
    const guardTex = device.createTexture({ size: [1, 1], format: 'rgba8unorm', usage: TU.TEXTURE_BINDING | TU.COPY_DST })
    device.queue.writeTexture({ texture: guardTex }, new Uint8Array([255, 255, 255, 255]), { bytesPerRow: 4, rowsPerImage: 1 }, [1, 1])
    const guardView = guardTex.createView()
    let guard = false
    for (const t of tests) {
      try {
        const mod = device.createShaderModule({ code: t.wgsl })
        const target = device.createTexture({ size: [8, 8], format: 'rgba8unorm', usage: TU.RENDER_ATTACHMENT | TU.COPY_SRC })
        const ab = pack(t.reflection.uniforms[0], values)
        const ubuf = device.createBuffer({ size: ab.byteLength, usage: BU.UNIFORM | BU.COPY_DST }); device.queue.writeBuffer(ubuf, 0, ab)
        const pipeline = device.createRenderPipeline({ layout: 'auto', vertex: { module: mod, entryPoint: t.vertexEntry }, fragment: { module: mod, entryPoint: t.fragmentEntry, targets: [{ format: 'rgba8unorm' }] }, primitive: { topology: 'triangle-list' } })
        const entries: any[] = [{ binding: 0, resource: { buffer: ubuf } }]
        if (t.guardBinding != null) { entries.push({ binding: t.guardBinding, resource: guardView }); guard = true }
        const bg = device.createBindGroup({ layout: pipeline.getBindGroupLayout(0), entries })
        const rb = device.createBuffer({ size: 256 * 8, usage: BU.COPY_DST | BU.MAP_READ })
        const enc = device.createCommandEncoder()
        const pass = enc.beginRenderPass({ colorAttachments: [{ view: target.createView(), loadOp: 'clear', storeOp: 'store', clearValue: { r: 0, g: 0, b: 0, a: 1 } }] })
        pass.setPipeline(pipeline); pass.setBindGroup(0, bg); pass.draw(3); pass.end()
        enc.copyTextureToBuffer({ texture: target }, { buffer: rb, bytesPerRow: 256, rowsPerImage: 8 }, [8, 8])
        device.queue.submit([enc.finish()])
        await rb.mapAsync(MM.READ)
        const arr = new Uint8Array(rb.getMappedRange().slice(0)); const o = 4 * 256 + 4 * 4
        rb.unmap()
        results[t.name] = decode(arr[o], arr[o + 1], arr[o + 2])
      } catch (e) { results[t.name] = null }
    }
    const info = adapter.info || {}
    return { ok: true, note: `adapter ${info.vendor || ''} ${info.architecture || ''}`.trim(), guard, results }
  }

  const verdict = (r: number | null, gold: number, circular: boolean): string => {
    if (r == null) return 'ERR'
    let d = Math.abs(r - gold); if (circular) d = Math.min(d, 1 - d)
    return d < 0.06 ? 'PASS' : Math.abs(r) < 0.06 ? 'FAIL(→0)' : 'FAIL'
  }

  ;(async () => {
    try {
      const { values, tests } = JSON.parse(document.getElementById('probe-payload')!.textContent!) as { values: Record<string, number[]>; tests: T[] }
      const gl = runWebGL(tests, values)
      const gpu = await runWebGPU(tests, values)
      type Rec = { name: string; gold: number; gv: number | null; pv: number | null; vGl: string; vGpu: string }
      const rec: Rec[] = []
      const rows: string[] = []
      let glPass = 0, gpuPass = 0
      for (const t of tests) {
        const vGl = verdict(gl.results[t.name] ?? null, t.golden, t.circular)
        const vGpu = gpu.ok ? verdict(gpu.results[t.name] ?? null, t.golden, t.circular) : 'n/a'
        if (vGl === 'PASS') glPass++
        if (vGpu === 'PASS') gpuPass++
        const gv = gl.results[t.name] ?? null, pv = gpu.results[t.name] ?? null
        const gs = gv == null ? '  ERR ' : gv.toFixed(4)
        const ps = !gpu.ok ? '   —  ' : pv == null ? '  ERR ' : pv.toFixed(4)
        // Digest row — the copy-pasteable artifact the dev parses; format is FROZEN.
        rows.push(`${t.name.padEnd(9)} gold=${t.golden.toFixed(4)}  WebGL2 ${gs} ${vGl.padEnd(8)} | WebGPU ${ps} ${vGpu}`)
        rec.push({ name: t.name, gold: t.golden, gv, pv, vGl, vGpu })
      }
      const header =
        `df64 GPU probe\n` +
        `  WebGL2: ${glPass}/${tests.length} pass · guard=${gl.guard ? 'bound' : 'MISSING'}\n` +
        `  WebGPU: ${gpu.ok ? `${gpuPass}/${tests.length} pass · guard=${gpu.guard ? 'bound' : 'MISSING'} · ${gpu.note}` : gpu.note}\n` +
        `  UA: ${navigator.userAgent}\n`
      digest.textContent = header + '\n' + rows.join('\n')

      // ── Visual views, built from the SAME results objects (never re-parsed) ──
      // Test families — grouping preserves the diagnostic PATTERN (e.g. "vec64
      // collapsed as a block") that a global failure-sort would scatter.
      const famOf = (n: string): 'scalar' | 'vector' | 'comparison' | 'composed' =>
        n === 'loran' ? 'composed'
        : /^(lt|le|gt|ge|eq|ne)$/.test(n) ? 'comparison'
        : /^vec_|^(dot|length|distance|normalize)$/.test(n) ? 'vector'
        : 'scalar'
      const FAMS: [string, string][] = [['scalar', 'Scalar'], ['vector', 'Vector · vec64'], ['comparison', 'Comparison'], ['composed', 'Composed']]
      const isFail = (vr: string): boolean => vr !== 'PASS' && vr !== 'n/a'

      // A failing df64 result reads ~0 (error term folded) or ~-2 (undrawn pixel);
      // WHICH is the diagnosis. The value carries the only hue (rust); the reason
      // is grey lowercase metadata — rust marks the failure, grey explains it.
      const cell = (v: number | null, vr: string): string => {
        if (vr === 'n/a') return '<span class="text-fg-faint">—</span>'
        if (v == null) return '<span class="font-mono text-[11px] text-destructive">err</span>'
        const num = `<span class="font-mono tabular-nums text-[13px] inline-block min-w-[5.5ch] text-right ${vr === 'PASS' ? 'text-fg-mute' : 'text-destructive'}">${v.toFixed(4)}</span>`
        if (vr === 'PASS') return num
        const why = Math.abs(v) < 0.06 ? 'collapsed→0' : Math.abs(v + 2) < 0.06 ? 'no draw' : 'wrong'
        return `${num} <span class="font-mono text-[11px] text-fg-mute">${why}</span>`
      }

      // Hero verdict per backend: one dominant display number, rust only on the
      // failed-delta line (never the count). The 27-tick strip is the SAME rust
      // mark the table repeats at row scale — overview and detail rhyme.
      const strip = (get: (r: Rec) => string): string =>
        `<div class="flex items-end gap-[3px] h-[20px]" aria-hidden="true">${rec.map((r) => `<span class="w-[2px] h-full rounded-[1px] ${get(r) === 'PASS' ? 'bg-line-strong' : get(r) === 'n/a' ? 'bg-line' : 'bg-destructive'}"></span>`).join('')}</div>`
      const heroRow = (label: string, pass: number, guard: boolean, nFail: number, get: (r: Rec) => string, avail: boolean): string => `
        <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
          <div>
            <p class="text-[11px] font-mono text-fg-mute uppercase tracking-[0.16em]">${label}</p>
            ${avail
              ? `<p class="mt-2 flex items-baseline gap-1.5"><span class="font-display font-normal leading-none tracking-[-0.02em] text-fg" style="font-size:clamp(40px,8vw,54px)">${pass}</span><span class="text-fg-mute text-[15px]">/${tests.length}</span></p>
                 ${nFail ? `<p class="mt-2 text-[13px] text-destructive">${nFail} failed</p>` : '<p class="mt-2 text-[12px] font-mono uppercase tracking-[0.16em] text-fg">all pass</p>'}
                 ${guard ? '' : '<p class="mt-1 text-[11px] text-destructive">guard missing</p>'}`
              : '<p class="mt-2 text-[13px] text-fg-mute max-w-[22rem] leading-[1.5]">not available on this browser — WebGL2 results only</p>'}
          </div>
          ${avail ? strip(get) : ''}
        </div>`
      summary.innerHTML = `<div class="rounded-[10px] border border-line bg-bg-card p-5 sm:p-6 flex flex-col gap-6">
        ${heroRow('WebGL2 · GLSL', glPass, gl.guard, rec.filter((r) => r.vGl !== 'PASS').length, (r) => r.vGl, true)}
        ${heroRow('WebGPU · WGSL', gpuPass, gpu.guard, rec.filter((r) => r.vGpu !== 'PASS').length, (r) => r.vGpu, gpu.ok)}
      </div>`

      // Table — grouped by family; failures first WITHIN a family. Row rhythm is
      // whitespace + a left rust tick on every failing row (no per-row hairline).
      const rank = (vr: string): number => (vr === 'PASS' ? 3 : vr === 'n/a' ? 2 : vr === 'ERR' ? 1 : 0)
      const rowHtml = (r: Rec): string => {
        const differ = gpu.ok && r.vGl !== r.vGpu
        const fail = isFail(r.vGl) || (gpu.ok && isFail(r.vGpu))
        return `<tr class="hover:bg-bg-hover transition-colors">
          <td class="py-2.5 pr-6 whitespace-nowrap font-mono text-[13px] text-fg border-l-2 pl-3 ${fail ? 'border-destructive' : 'border-transparent'}">${r.name}${differ ? ' <span class="font-mono text-[11px] text-destructive lowercase">differ</span>' : ''}</td>
          <td class="py-2.5 pr-6 whitespace-nowrap">${cell(r.gv, r.vGl)}</td>
          <td class="py-2.5 whitespace-nowrap ${gpu.ok ? '' : 'text-fg-faint'}">${cell(r.pv, r.vGpu)}</td>
        </tr>`
      }
      const sections = FAMS.map(([key, label]) => {
        const items = rec.filter((r) => famOf(r.name) === key)
          .sort((a, b) => Math.min(rank(a.vGl), rank(a.vGpu)) - Math.min(rank(b.vGl), rank(b.vGpu)))
        return items.length
          ? `<tbody><tr><td colspan="3" class="pt-6 pb-2 border-t border-line-strong"><span class="text-[11px] font-mono text-fg-mute uppercase tracking-[0.16em]">${label}</span></td></tr>${items.map(rowHtml).join('')}</tbody>`
          : ''
      }).join('')
      const th = 'pb-2 text-left text-[11px] font-mono text-fg-mute uppercase tracking-[0.16em] font-normal'
      tableEl.innerHTML = `<table class="w-full border-collapse">
        <thead><tr><th class="${th} pl-3 pr-6">Test</th><th class="${th} pr-6">WebGL2</th><th class="${th} ${gpu.ok ? '' : 'text-fg-faint'}">WebGPU</th></tr></thead>
        ${sections}</table>`

      // Reveal (fade), then wire copy of the FROZEN digest text.
      loading.style.display = 'none'
      requestAnimationFrame(() => { out.classList.remove('opacity-0'); out.classList.add('opacity-100') })
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(digest.textContent ?? '')
          const l = copyBtn.querySelector('.copy-label')
          if (!l) return
          const o = l.textContent
          l.textContent = 'Copied'
          copyBtn.classList.add('text-accent')
          setTimeout(() => { l.textContent = o; copyBtn.classList.remove('text-accent') }, 1400)
        } catch { /* clipboard denied (insecure context) — fail silently */ }
      })
    } catch (e) {
      const msg = 'ERROR: ' + (e instanceof Error ? e.message : String(e))
      loading.style.display = 'none'
      out.classList.remove('opacity-0')
      digest.textContent = msg
      digest.classList.add('text-destructive')
      summary.innerHTML = `<p class="text-[13px] text-destructive">${msg}</p>`
    }
  })()
</script>
