---
// ═══ df64 GPU capability probe (diagnostic, not in nav) ═══
//
// Renders known-answer df64 tests through the REAL emit + the REAL _fp64 guard,
// so it reproduces exactly what the fp64 examples run — but instead of a scene it
// paints a flat PASS/FAIL colour per test. Open on a device and read the colour:
//   GREEN  = df64 is correct on this GPU
//   BLUE   = the df64 result collapsed to 0 (the f32 answer) — the error terms
//            were folded away (fast-math / FMA / precision loss)
//   RED    = neither — corrupted value
// SwiftShader (CI / headless) shows all-green; the point is real-GPU behaviour.
import ShaderDsl from '../../layouts/ShaderDsl.astro'
import {
  fn,
  module,
  ioStruct,
  uniformStruct,
  builtin,
  location,
  u32,
  f32,
  vec2,
  vec3,
  vec4,
  toF32,
  toF64,
  sqrt,
  abs,
  Let,
  f32T,
  vec2fT,
  vec4fT,
  u32T,
  vec2f64T,
  emitGlslModule,
  reflect,
} from '@xgis/shader-dsl'

// Fullscreen triangle (self-contained copy of examples/_fullscreen).
const VsOut = ioStruct('VsOut', { pos: builtin('position', vec4fT), uv: location(0, vec2fT) })
const vs = fn(
  'vs',
  { vi: builtin('vertex_index', u32T) },
  ({ vi }) => {
    const x = toF32(vi.bitAnd(u32(1))).mul(4).sub(1)
    const y = toF32(vi.shr(u32(1))).mul(4).sub(1)
    return VsOut.construct({ pos: vec4(x, y, 0, 1), uv: vec2(x.mul(0.5).add(0.5), y.mul(0.5).add(0.5)) })
  },
  { stage: 'vertex' },
)

// Runtime inputs (uniforms → no build-time const-fold; the df64 chain must run on the GPU).
const U = uniformStruct(
  'Probe',
  { group: 0, binding: 0, as: 'u' },
  {
    big: f32T, // 1e8
    small: f32T, // 0.5 (the expected answer of both tests)
    root: f32T, // 1e6
    sq: vec2f64T, // df64 value of (root + small)^2 — its .x feeds the sqrt test
  },
)

const fsProbe = fn(
  'fs_probe',
  { vo: VsOut },
  (p) => {
    const big = U.field.big
    const small = U.field.small
    const root = U.field.root

    // Test A (left half): the twoSum EFT. (big ⊕ small) ⊖ big must recover `small`.
    // In plain f32, big+small rounds back to big and the subtraction yields 0.
    const rA = Let(toF32(toF64(big).add(toF64(small)).sub(toF64(big))))
    // Test B (right half): df64 sqrt (loran's demanding path). sqrt((root+small)^2) − root == small.
    const rB = Let(toF32(sqrt(U.field.sq.x).sub(toF64(root))))

    const left = Let(p.vo.uv.x.lt(f32(0.5)))
    const r = Let(left.select(rA, rB))

    const green = vec3(0.13, 0.82, 0.4)
    const blue = vec3(0.24, 0.5, 0.98)
    const red = vec3(0.95, 0.26, 0.24)
    const okG = Let(abs(r.sub(small)).lt(f32(0.05)))
    const zeroB = Let(abs(r).lt(f32(0.05)))
    const col = Let(okG.select(green, zeroB.select(blue, red)))

    // Thin black centre divider so the two halves read as separate tests.
    const seam = Let(abs(p.vo.uv.x.sub(f32(0.5))).lt(f32(0.004)))
    return vec4(seam.select(vec3(0.0), col), f32(1))
  },
  { stage: 'fragment', retAttr: '@location(0)' },
)

const probeModule = module({ funcs: [vs, fsProbe], uses: [U, VsOut] })
const glslVertex = emitGlslModule(probeModule, 'vertex')
const glslFragment = emitGlslModule(probeModule, 'fragment')
const reflection = reflect(probeModule)

// Host-side values (JS number == f64). splitF64: lossless double → (hi, lo) f32 pair.
const fr = Math.fround
const df64 = (x: number): [number, number] => [fr(x), fr(x - fr(x))]
const BIG = 1e8
const SMALL = 0.5
const ROOT = 1e6
const SQ = (ROOT + SMALL) * (ROOT + SMALL) // (1e6+0.5)^2 — exact in f64
const sq = df64(SQ)
const values: Record<string, number[]> = {
  big: [BIG],
  small: [SMALL],
  root: [ROOT],
  sq: [sq[0], 0, sq[1], 0], // std140 DF64Vec2 planes [hi.x, hi.y, lo.x, lo.y]
}
const payload = { glslVertex, glslFragment, reflection, values }
---

<ShaderDsl current="probe" hideSectionNav title="X-GIS Shader DSL — df64 GPU probe" description="Diagnostic: known-answer df64 tests through the real emit + guard, painting PASS/FAIL per GPU.">
  <h1 class="font-display font-normal text-fg leading-[1.0] tracking-[-0.02em] text-[32px] sm:text-[40px]">df64 GPU probe</h1>
  <p class="mt-4 text-[15px] leading-[1.6] text-fg-dim max-w-full">
    Two known-answer double-float tests, run through the same emit + <code class="font-mono text-[13px] text-fg">_fp64</code>
    guard the fp64 examples use. Each half should recover <code class="font-mono text-[13px] text-fg">0.5</code>.
    Read the colour on <strong class="text-fg">this device</strong>:
  </p>
  <ul class="mt-3 text-[14px] leading-[1.7] text-fg-dim max-w-full">
    <li><span class="inline-block w-3 h-3 rounded-sm align-middle" style="background:#22d16a"></span> <strong class="text-fg">GREEN</strong> — df64 correct on this GPU.</li>
    <li><span class="inline-block w-3 h-3 rounded-sm align-middle" style="background:#3d80fa"></span> <strong class="text-fg">BLUE</strong> — result collapsed to 0 (the plain-f32 answer): the error terms were folded away (fast-math / precision).</li>
    <li><span class="inline-block w-3 h-3 rounded-sm align-middle" style="background:#f24340"></span> <strong class="text-fg">RED</strong> — corrupted value (neither 0.5 nor 0).</li>
  </ul>
  <div class="mt-5 grid grid-cols-2 gap-0 max-w-[520px] text-center font-mono text-[11px] text-fg-mute">
    <div class="pb-1">LEFT · add/sub EFT</div>
    <div class="pb-1">RIGHT · sqrt EFT (loran-class)</div>
  </div>
  <div class="rounded-[10px] border border-line overflow-hidden max-w-[520px]">
    <canvas id="probe" width="1040" height="360" class="block w-full" style="aspect-ratio: 1040 / 360;"></canvas>
    <div id="probe-status" class="px-4 py-2 border-t border-line bg-bg-card font-mono text-[12px] text-fg-mute"></div>
  </div>
  <p class="mt-4 text-[13px] leading-[1.6] text-fg-mute max-w-full">
    Screenshot this on each device (desktop + phone) so the failing half/colour is captured. SwiftShader (headless CI) shows all-green — the diagnostic value is on real GPUs.
  </p>
</ShaderDsl>

<script type="application/json" id="probe-payload" set:html={JSON.stringify(payload)}></script>

<script>
  type Reflection = { uniforms: { name: string; size: number; fields: { name: string; offset: number }[] }[] }
  const raw = document.getElementById('probe-payload')?.textContent
  const status = document.getElementById('probe-status')!
  const fail = (m: string) => { status.textContent = 'ERROR: ' + m; status.style.color = '#f24340' }
  try {
    const { glslVertex, glslFragment, reflection, values } = JSON.parse(raw!) as {
      glslVertex: string; glslFragment: string; reflection: Reflection; values: Record<string, number[]>
    }
    const canvas = document.getElementById('probe') as HTMLCanvasElement
    const gl = canvas.getContext('webgl2')
    if (!gl) throw new Error('WebGL2 not supported')

    const compile = (type: number, src: string): WebGLShader => {
      const sh = gl.createShader(type)!
      gl.shaderSource(sh, src)
      gl.compileShader(sh)
      if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(sh) || 'compile failed')
      return sh
    }
    const prog = gl.createProgram()!
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, glslVertex))
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, glslFragment))
    gl.linkProgram(prog)
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(prog) || 'link failed')
    gl.useProgram(prog)

    // Pack the std140 uniform block from reflection offsets.
    const block = reflection.uniforms[0]
    const buf = new ArrayBuffer(Math.ceil(block.size / 16) * 16)
    const f32 = new Float32Array(buf)
    for (const f of block.fields) {
      const v = values[f.name] ?? [0]
      for (let i = 0; i < v.length; i++) f32[f.offset / 4 + i] = v[i]
    }
    const ubo = gl.createBuffer()
    gl.bindBuffer(gl.UNIFORM_BUFFER, ubo)
    gl.bufferData(gl.UNIFORM_BUFFER, buf, gl.STATIC_DRAW)
    const idx = gl.getUniformBlockIndex(prog, block.name)
    if (idx !== 0xffffffff) { gl.uniformBlockBinding(prog, idx, 0); gl.bindBufferBase(gl.UNIFORM_BUFFER, 0, ubo) }

    // The _fp64 anti-fast-math guard: a 1×1 texel-1.0 texture bound as `_fp64`.
    const guardLoc = gl.getUniformLocation(prog, '_fp64')
    if (guardLoc) {
      const tex = gl.createTexture()
      gl.activeTexture(gl.TEXTURE7)
      gl.bindTexture(gl.TEXTURE_2D, tex)
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA8, 1, 1, 0, gl.RGBA, gl.UNSIGNED_BYTE, new Uint8Array([255, 255, 255, 255]))
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.NEAREST)
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST)
      gl.uniform1i(guardLoc, 7)
      gl.activeTexture(gl.TEXTURE0)
    }

    gl.bindVertexArray(gl.createVertexArray())
    gl.viewport(0, 0, canvas.width, canvas.height)
    gl.clearColor(0, 0, 0, 1)
    gl.clear(gl.COLOR_BUFFER_BIT)
    gl.drawArrays(gl.TRIANGLES, 0, 3)

    // Read back one pixel from each half to report the verdict in text too.
    const read = (x: number): string => {
      const px = new Uint8Array(4)
      gl.readPixels(x, (canvas.height / 2) | 0, 1, 1, gl.RGBA, gl.UNSIGNED_BYTE, px)
      const [r, g, b] = px
      if (g > 150 && r < 120) return 'GREEN (df64 ok)'
      if (b > 150 && r < 120) return 'BLUE (collapsed to f32)'
      if (r > 150) return 'RED (corrupted)'
      return `rgb(${r},${g},${b})`
    }
    status.textContent = `guard=${guardLoc ? 'bound' : 'MISSING'} · add/sub: ${read((canvas.width * 0.25) | 0)} · sqrt: ${read((canvas.width * 0.75) | 0)}`
  } catch (e) {
    fail(e instanceof Error ? e.message : String(e))
  }
</script>
