---
import ShaderDsl from '../../layouts/ShaderDsl.astro'
import { Code } from 'astro-expressive-code/components'
import { shaderCards } from '../../lib/shader-examples.ts'

const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
const root = `${base}/shader-dsl`

// The one-glance proof: a real example's authored source next to the WGSL it emits,
// both produced at build time by the same emit the CLI + render-gate use — so the
// landing page shows the transform, not a description of it.
const gradient = shaderCards.find((c) => c.id === 'gradient')!

const capabilities = [
  { label: 'One source → many targets', body: 'Author once; emit WGSL for WebGPU and GLSL ES 3.00 for WebGL2. The WGSL is byte-stable, so builds are reproducible and diff-testable.' },
  { label: 'Type-checked', body: 'Nodes carry compile-time keys — a wrong-typed field or return is a TypeScript error, not a shader-compile surprise.' },
  { label: 'Reflection', body: 'reflect(module) recovers bind groups, std140/std430 layouts, and entry signatures — the host binds without hand-derived offsets.' },
  { label: 'Optimize + lint', body: 'CSE, DCE, LICM, const-fold and auto-vars, plus a 21-rule lint engine and a capability gate.' },
  { label: 'CPU f64 oracle', body: 'Compile the same module to an f64 CPU function to cross-check the GPU result — the parity gate X-GIS rendering relies on.' },
  { label: 'Bring your own shaders', body: 'It ships the authoring + emit surface, not any app’s shaders. X-GIS authors its own map shaders through it.' },
]
---

<ShaderDsl
  current=""
  title="X-GIS — Shader DSL"
  description="A TypeScript shader DSL: author a typed shader once, compile to WGSL (WebGPU) and GLSL ES 3.00 (WebGL2), reflect the pipeline, and cross-check on a CPU f64 oracle."
>
  <p class="font-mono text-[12px] tracking-[0.18em] uppercase text-fg-mute mb-5">@xgis/shader-dsl</p>
  <h1 class="font-display font-normal text-fg leading-[1.0] tracking-[-0.02em] text-[40px] sm:text-[52px] lg:text-[64px]">
    Shaders, authored in <span class="font-mono">TypeScript</span>.
  </h1>
  <p class="mt-5 text-[16px] sm:text-[17px] leading-[1.6] text-fg-dim max-w-full">
    Write a shader once as typed TypeScript and one IR emits <span class="text-fg font-medium">WGSL</span>
    for WebGPU and <span class="text-fg font-medium">GLSL ES 3.00</span> for WebGL2 — no hand-porting, no
    hand-derived binding offsets, and a CPU f64 oracle to prove the two targets agree. It's the shader
    layer behind every X-GIS map.
  </p>

  <div class="mt-8 max-w-full flex flex-wrap gap-3">
    <a href={`${root}/getting-started`} class="inline-flex items-center gap-2 px-5 h-10 rounded-full bg-accent text-bg hover:bg-accent-hover text-[14px] font-medium transition-colors">
      Get started
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
    </a>
    <a href={`${root}/examples`} class="inline-flex items-center gap-2 px-5 h-10 rounded-full border border-line bg-bg text-fg hover:border-line-strong text-[14px] transition-colors">
      Browse examples
    </a>
  </div>

  <figure class="mt-10 max-w-full">
    <div class="sd-code grid lg:grid-cols-2 gap-4 items-start">
      <div>
        <p class="text-[11px] font-mono text-fg-mute uppercase tracking-[0.16em] mb-2">gradient.ts — authored</p>
        <Code code={gradient.source} lang="ts" />
      </div>
      <div>
        <p class="text-[11px] font-mono text-fg-mute uppercase tracking-[0.16em] mb-2">emitModule(m) — WGSL</p>
        <Code code={gradient.wgsl} lang="wgsl" />
      </div>
    </div>
    <figcaption class="mt-3 text-[13px] leading-[1.55] text-fg-mute">
      One module in; byte-stable WGSL out — and <code class="font-mono text-[12.5px] text-fg">emitGlslModule(m, …)</code>
      gives the matching GLSL ES 3.00 for WebGL2. Nothing is authored twice.
    </figcaption>
  </figure>

  <h2 class="font-display text-[22px] sm:text-[24px] font-normal text-fg tracking-[-0.02em] mt-16 mb-5">What it gives you</h2>
  <div class="max-w-full grid sm:grid-cols-2 gap-4">
    {capabilities.map((cap) => (
      <div class="rounded-[8px] bg-bg-card border border-line p-5">
        <h3 class="text-[15px] font-normal text-fg mb-1.5">{cap.label}</h3>
        <p class="text-[13.5px] leading-[1.55] text-fg-dim">{cap.body}</p>
      </div>
    ))}
  </div>

  <div class="mt-12 max-w-full rounded-[8px] border border-line p-5 bg-bg-card">
    <p class="text-[14px] leading-[1.6] text-fg-dim">
      <span class="text-fg font-medium">Two ways in.</span> Evaluating the design? Read
      <a href={`${root}/concepts`} class="text-accent hover:text-accent-hover transition-colors">Concepts</a>
      — one IR, two backends, and the parity oracle. Ready to write one? Jump to
      <a href={`${root}/getting-started`} class="text-accent hover:text-accent-hover transition-colors">Getting started</a>
      and emit your first shader in a few minutes.
    </p>
  </div>
</ShaderDsl>
