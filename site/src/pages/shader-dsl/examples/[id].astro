---
import ShaderDsl from '../../../layouts/ShaderDsl.astro'
import { Code } from 'astro-expressive-code/components'
import { shaderCards } from '../../../lib/shader-examples.ts'

export function getStaticPaths() {
  return shaderCards.map((c, i) => ({
    params: { id: c.id },
    props: {
      card: c,
      prev: i > 0 ? { id: shaderCards[i - 1].id, title: shaderCards[i - 1].title } : null,
      next: i < shaderCards.length - 1 ? { id: shaderCards[i + 1].id, title: shaderCards[i + 1].title } : null,
    },
  }))
}

const { card, prev, next } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
const examplesHref = `${base}/shader-dsl/examples`
const detailHref = (id: string) => `${base}/shader-dsl/examples/${id}`

const sliderControls = Object.entries(card.spec?.controls ?? {}).filter(
  ([, c]) => (c as { kind: string }).kind === 'slider',
) as [string, { kind: 'slider'; label: string; min: number; max: number; step: number; value: number }][]
const toggleControls = Object.entries(card.spec?.controls ?? {}).filter(
  ([, c]) => (c as { kind: string }).kind === 'toggle',
) as [string, { kind: 'toggle'; label: string; value: boolean }][]
const hasMouse = Object.values(card.spec?.controls ?? {}).some(
  (c) => (c as { kind: string }).kind === 'mouse' || (c as { kind: string }).kind === 'pan2d',
)

const tabs = [
  { id: 'dsl', label: 'DSL (TypeScript)' },
  { id: 'wgsl', label: 'WGSL' },
  // WGSL is one module carrying both entry points; GLSL ES 3.00 compiles as two
  // separate sources, so they get separate tabs instead of one concatenated dump.
  ...(card.glslVertex ? [{ id: 'glsl-vs', label: 'GLSL · vertex' }] : []),
  ...(card.glslFragment ? [{ id: 'glsl-fs', label: 'GLSL · fragment' }] : []),
  { id: 'reflect', label: 'Reflection' },
]
---

<ShaderDsl current="examples" hideSectionNav title={`X-GIS Shader DSL — ${card.title}`} description={card.blurb}>
  <div class="max-w-full">
  <a href={examplesHref} class="inline-flex items-center gap-1.5 text-[13px] text-fg-mute hover:text-fg transition-colors mb-6">
    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
    Examples
  </a>

  <div class="flex items-center gap-2 mb-3">
    <span class="font-mono text-[10px] text-fg-mute uppercase tracking-[0.16em] px-2 py-0.5 rounded-full bg-bg-card border border-line">{card.category}</span>
    {card.splitLabels && (
      <span class="font-mono text-[10px] text-bg uppercase tracking-[0.12em] px-2 py-0.5 rounded-full bg-accent border border-accent">f32 vs f64</span>
    )}
    <span class="font-mono text-[11px] text-fg-mute">{card.file}</span>
  </div>
  <h1 class="font-display font-normal text-fg leading-[1.0] tracking-[-0.02em] text-[40px] sm:text-[52px] lg:text-[64px]">{card.title}</h1>
  <p class="mt-4 text-[15.5px] sm:text-[16px] leading-[1.55] text-fg-dim max-w-full">{card.blurb}</p>

  {card.renderable && card.spec && (
    <section class="mt-7">
      <div data-shader-frame class="relative rounded-[8px] overflow-hidden bg-bg-elev border border-line" style="aspect-ratio: 16 / 10;">
        <canvas data-shader={card.id} class="block w-full h-full" style="touch-action: none;"></canvas>
        <div class="absolute top-3 left-3 inline-flex items-center gap-1.5 px-1.5 py-0.5 rounded-full bg-bg/80 backdrop-blur border border-line text-[10px] font-mono tracking-[0.14em] uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-fg inline-block animate-pulse" data-live-dot></span>
          <span class="text-fg-mute">Live</span>
          <span role="group" aria-label="Backend" class="inline-flex rounded-full overflow-hidden border border-line">
            <button type="button" data-backend="webgl2" aria-pressed="true" class="backend-btn px-1.5 py-0.5 transition-colors">WebGL2</button>
            <button type="button" data-backend="webgpu" aria-pressed="false" class="backend-btn px-1.5 py-0.5 transition-colors border-l border-line" hidden>WebGPU</button>
          </span>
        </div>
        {hasMouse && (
          <span class="absolute top-3 right-3 inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-bg/80 backdrop-blur border border-line text-fg-dim text-[10px] font-mono tracking-[0.16em] uppercase pointer-events-none">
            <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4l7 17 2.5-7.5L21 11z"/></svg>
            Pointer-interactive
          </span>
        )}
        {card.splitLabels && (
          <>
            <span class="absolute bottom-3 left-3 px-2 py-0.5 rounded-full bg-bg/80 backdrop-blur border border-line text-fg-dim text-[10px] font-mono tracking-[0.16em] uppercase pointer-events-none">
              ← {card.splitLabels[0]}
            </span>
            <span class="absolute bottom-3 right-3 px-2 py-0.5 rounded-full bg-bg/80 backdrop-blur border border-line text-fg-dim text-[10px] font-mono tracking-[0.16em] uppercase pointer-events-none">
              {card.splitLabels[1]} →
            </span>
          </>
        )}
        <div data-error hidden class="absolute inset-0 flex items-center justify-center p-6 text-center text-fg-mute text-[12px] font-mono bg-bg-elev"></div>
      </div>

      <!-- Transport chrome: shader-clock controls shared by every renderable
           example — the descriptor's {kind:'time'} is host-filled, so these need
           no shader/uniform change. -->
      <div data-transport class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2">
        <button type="button" data-play aria-label="Pause" title="Play / pause"
          class="inline-flex items-center justify-center w-8 h-8 rounded-full border border-line text-fg-dim hover:text-fg hover:border-line-strong transition-colors">
          <svg data-icon-pause viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
          <svg data-icon-play viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true" style="display: none;"><path d="M8 5.5v13l11-6.5z"/></svg>
        </button>
        <input type="range" data-scrub min="0" max="30" step="0.05" value="0" aria-label="Shader time"
          class="shader-range flex-1 min-w-[120px]" />
        <span data-clock class="font-mono text-[11px] text-fg-mute w-[4.5ch] text-right">0.0s</span>
        <div class="flex items-center gap-1" role="group" aria-label="Playback speed">
          {[0.25, 0.5, 1, 2].map((s) => (
            <button type="button" data-speed={s} aria-pressed={s === 1 ? 'true' : 'false'}
              class={`speed-btn font-mono text-[10.5px] px-2 py-0.5 rounded-full border transition-colors ${s === 1 ? 'border-line-strong text-fg' : 'border-line text-fg-mute hover:text-fg'}`}>
              {s}×
            </button>
          ))}
        </div>
        <button type="button" data-reset title="Reset time and controls"
          class="inline-flex items-center gap-1.5 font-mono text-[10.5px] px-2.5 py-1 rounded-full border border-line text-fg-mute hover:text-fg hover:border-line-strong transition-colors">
          <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
          Reset
        </button>
        <button type="button" data-fullscreen title="Fullscreen"
          class="inline-flex items-center justify-center w-8 h-8 rounded-full border border-line text-fg-dim hover:text-fg hover:border-line-strong transition-colors">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
        </button>
      </div>

      {(sliderControls.length > 0 || toggleControls.length > 0) && (
        <div class="mt-5 grid sm:grid-cols-2 gap-x-8 gap-y-4">
          {sliderControls.map(([field, ctl]) => (
            <label class="block">
              <span class="flex items-center justify-between text-[12px] text-fg-dim mb-1.5">
                <span>{ctl.label}</span>
                <span class="font-mono text-fg-mute" data-value={field}>{ctl.value}</span>
              </span>
              <input type="range" data-field={field} min={ctl.min} max={ctl.max} step={ctl.step} value={ctl.value} class="shader-range w-full" />
            </label>
          ))}
          {toggleControls.map(([field, ctl]) => (
            <label class="flex items-center justify-between gap-3 cursor-pointer select-none">
              <span class="text-[12px] text-fg-dim">{ctl.label}</span>
              <span class="relative inline-flex items-center">
                <input type="checkbox" data-toggle-field={field} checked={ctl.value} class="peer sr-only" />
                <span class="pointer-events-none w-9 h-5 rounded-full bg-bg-card border border-line peer-checked:bg-accent/25 peer-checked:border-accent transition-colors"></span>
                <span class="pointer-events-none absolute left-0.5 w-4 h-4 rounded-full bg-fg-mute peer-checked:bg-accent peer-checked:translate-x-4 transition-transform"></span>
              </span>
            </label>
          ))}
        </div>
      )}
    </section>
  )}

  {!card.renderable && (
    <section class="mt-7 rounded-[8px] bg-bg-card border border-line px-5 py-4 text-[13.5px] leading-[1.55] text-fg-dim">
      This is a <span class="text-fg font-medium">compute</span> kernel — WebGPU only. GLSL ES 3.00
      has no compute stage, so the DSL fails closed for WebGL2 and there is no live preview. The WGSL
      and reflection below are emitted from the same DSL source.
    </section>
  )}

  <section class="mt-10">
    <h2 class="font-display text-[19px] font-normal text-fg tracking-[-0.015em] mb-1.5">One source, compiled every way</h2>
    <p class="text-[13.5px] leading-[1.55] text-fg-dim mb-4 max-w-full">
      The DSL source below, compiled to WebGPU (WGSL), WebGL2 (GLSL ES 3.00 — two stages), and a
      reflection JSON the host binds from. Nothing but the DSL tab is hand-written.
    </p>
    <div data-tabs role="tablist" class="flex gap-1 overflow-x-auto no-scrollbar mb-2 -mx-1 px-1">
      {tabs.map((tab, i) => (
        <button type="button" role="tab" id={`tab-${tab.id}`} data-tab={tab.id} aria-controls={`panel-${tab.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="shrink-0 text-[12.5px] font-medium px-3.5 py-1.5 rounded-full border border-transparent transition-colors">
          {tab.label}
        </button>
      ))}
    </div>
    <div class="sd-code">
      <div data-panel="dsl" id="panel-dsl" role="tabpanel" aria-labelledby="tab-dsl" tabindex="0"><Code code={card.source} lang="ts" /></div>
      <div data-panel="wgsl" id="panel-wgsl" role="tabpanel" aria-labelledby="tab-wgsl" tabindex="0" hidden><Code code={card.wgsl} lang="wgsl" /></div>
      {card.glslVertex && <div data-panel="glsl-vs" id="panel-glsl-vs" role="tabpanel" aria-labelledby="tab-glsl-vs" tabindex="0" hidden><Code code={card.glslVertex} lang="glsl" /></div>}
      {card.glslFragment && <div data-panel="glsl-fs" id="panel-glsl-fs" role="tabpanel" aria-labelledby="tab-glsl-fs" tabindex="0" hidden><Code code={card.glslFragment} lang="glsl" /></div>}
      <div data-panel="reflect" id="panel-reflect" role="tabpanel" aria-labelledby="tab-reflect" tabindex="0" hidden><Code code={card.reflectionJson} lang="json" /></div>
    </div>
  </section>

  <section class="mt-8 rounded-[8px] border border-line px-5 py-4">
    <p class="text-[13px] text-fg-dim leading-[1.6]">
      Run it locally:
      <code class="font-mono text-[13px] text-fg ml-1">npx tsx examples/print.ts {card.id}</code>
      — prints the WGSL{card.renderable ? ', GLSL,' : ' and'} reflection. Source:
      <a href={`https://github.com/X-GIS/X-GIS/blob/main/shader-dsl/examples/${card.file}`} target="_blank" rel="noopener" class="text-accent hover:text-accent-hover transition-colors">GitHub</a>.
    </p>
    <p class="mt-2 text-[13px] text-fg-mute leading-[1.6]">
      New to the IR? See <a href={`${base}/shader-dsl/concepts`} class="text-accent hover:text-accent-hover transition-colors">Concepts</a>;
      the full authoring + emit surface is in the <a href={`${base}/shader-dsl/reference`} class="text-accent hover:text-accent-hover transition-colors">API reference</a>.
    </p>
  </section>

  <nav class="mt-12 pt-8 border-t border-line grid sm:grid-cols-2 gap-3">
    {prev ? (
      <a href={detailHref(prev.id)} class="group block rounded-[8px] border border-line px-5 py-4 hover:border-line-strong transition-colors">
        <p class="font-mono text-[11px] text-fg-mute uppercase tracking-[0.16em] mb-1.5">← Previous</p>
        <p class="text-[15px] font-medium text-fg group-hover:text-accent transition-colors">{prev.title}</p>
      </a>
    ) : <div></div>}
    {next && (
      <a href={detailHref(next.id)} class="group block rounded-[8px] border border-line px-5 py-4 hover:border-line-strong transition-colors text-right">
        <p class="font-mono text-[11px] text-fg-mute uppercase tracking-[0.16em] mb-1.5">Next →</p>
        <p class="text-[15px] font-medium text-fg group-hover:text-accent transition-colors">{next.title}</p>
      </a>
    )}
  </nav>
  </div>
</ShaderDsl>

<script type="application/json" id="shader-spec" set:html={JSON.stringify(card.spec)}></script>

<script>
  import {
    mountShader,
    mountShaderWebGPU,
    webgpuAvailable,
    type RenderSpec,
    type Backend,
    type Mounted,
  } from '../../../lib/shader-playground'

  const tablist = document.querySelector<HTMLElement>('[data-tabs]')
  if (tablist) {
    const buttons = Array.from(tablist.querySelectorAll<HTMLButtonElement>('button[data-tab]'))
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'))
    const select = (tab: string, focus = false): void => {
      buttons.forEach((b) => {
        const on = b.dataset.tab === tab
        b.setAttribute('aria-selected', String(on))
        b.tabIndex = on ? 0 : -1
        if (on && focus) b.focus()
      })
      panels.forEach((p) => { p.hidden = p.dataset.panel !== tab })
    }
    buttons.forEach((b) => b.addEventListener('click', () => select(b.dataset.tab!)))
    // Roving-tabindex keyboard nav (WAI-ARIA tabs pattern).
    tablist.addEventListener('keydown', (e) => {
      const i = buttons.findIndex((b) => b.getAttribute('aria-selected') === 'true')
      if (i < 0) return
      let j = i
      if (e.key === 'ArrowRight') j = (i + 1) % buttons.length
      else if (e.key === 'ArrowLeft') j = (i - 1 + buttons.length) % buttons.length
      else if (e.key === 'Home') j = 0
      else if (e.key === 'End') j = buttons.length - 1
      else return
      e.preventDefault()
      select(buttons[j].dataset.tab!, true)
    })
  }

  const raw = document.getElementById('shader-spec')?.textContent
  const spec: RenderSpec | null = raw && raw !== 'null' ? JSON.parse(raw) : null
  const canvas = document.querySelector<HTMLCanvasElement>('canvas[data-shader]')

  if (spec && canvas) {
    const sliders: Record<string, number> = {}
    const sliderInputs = Array.from(
      document.querySelectorAll<HTMLInputElement>('input[type="range"][data-field]'),
    )
    sliderInputs.forEach((input) => {
      const field = input.dataset.field!
      sliders[field] = parseFloat(input.value)
      const out = document.querySelector<HTMLElement>(`[data-value="${field}"]`)
      input.addEventListener('input', () => {
        sliders[field] = parseFloat(input.value)
        if (out) out.textContent = input.value
      })
    })
    // Toggles ride the same live-values record as sliders, as f32 1/0.
    const toggleInputs = Array.from(
      document.querySelectorAll<HTMLInputElement>('input[type="checkbox"][data-toggle-field]'),
    )
    toggleInputs.forEach((input) => {
      const field = input.dataset.toggleField!
      sliders[field] = input.checked ? 1 : 0
      input.addEventListener('change', () => {
        sliders[field] = input.checked ? 1 : 0
      })
    })

    const overlay = document.querySelector<HTMLElement>('[data-error]')
    const transport = document.querySelector<HTMLElement>('[data-transport]')
    const liveDot = document.querySelector<HTMLElement>('[data-live-dot]')
    const backendBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-backend]'))

    // A canvas is bound to ONE context type for its lifetime — switching WebGL2 ⟷
    // WebGPU needs a fresh element. Clone (attributes only, no context) and swap it
    // into the DOM; the new canvas re-receives the pointer/pan/wheel listeners.
    let canvasEl = canvas
    const attachWheel = (c: HTMLCanvasElement): void => {
      for (const [field, ctl] of Object.entries(spec.controls)) {
        if (ctl.kind !== 'slider' || !ctl.wheel) continue
        const input = sliderInputs.find((i) => i.dataset.field === field)
        if (!input) continue
        c.addEventListener(
          'wheel',
          (e) => {
            e.preventDefault()
            const cur = parseFloat(input.value)
            const next = Math.min(ctl.max, Math.max(ctl.min, cur - Math.sign(e.deltaY) * ctl.step * 4))
            input.value = String(next)
            input.dispatchEvent(new Event('input'))
          },
          { passive: false },
        )
      }
    }

    // ── Transport chrome (wired once; call through the live `mounted` ref) ──
    const playBtn = document.querySelector<HTMLButtonElement>('[data-play]')
    const iconPlay = document.querySelector<SVGElement>('[data-icon-play]')
    const iconPause = document.querySelector<SVGElement>('[data-icon-pause]')
    const scrub = document.querySelector<HTMLInputElement>('[data-scrub]')
    const clock = document.querySelector<HTMLElement>('[data-clock]')
    const speedBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-speed]'))
    const resetBtn = document.querySelector<HTMLButtonElement>('[data-reset]')
    const fsBtn = document.querySelector<HTMLButtonElement>('[data-fullscreen]')
    const frameEl = document.querySelector<HTMLElement>('[data-shader-frame]')
    const SCRUB_SPAN = 30

    let mounted: Mounted | null = null
    const reflectPlaying = (): void => {
      const p = mounted?.isPlaying() ?? true
      if (iconPlay) iconPlay.style.display = p ? 'none' : ''
      if (iconPause) iconPause.style.display = p ? '' : 'none'
      playBtn?.setAttribute('aria-label', p ? 'Pause' : 'Play')
    }
    playBtn?.addEventListener('click', () => {
      if (!mounted) return
      mounted.setPlaying(!mounted.isPlaying())
      reflectPlaying()
    })
    let scrubbing = false
    scrub?.addEventListener('pointerdown', () => (scrubbing = true))
    scrub?.addEventListener('pointerup', () => (scrubbing = false))
    scrub?.addEventListener('input', () => mounted?.setTime(parseFloat(scrub.value)))
    speedBtns.forEach((b) =>
      b.addEventListener('click', () => {
        mounted?.setSpeed(parseFloat(b.dataset.speed!))
        speedBtns.forEach((o) => {
          const on = o === b
          o.setAttribute('aria-pressed', String(on))
          o.classList.toggle('border-line-strong', on)
          o.classList.toggle('text-fg', on)
          o.classList.toggle('border-line', !on)
          o.classList.toggle('text-fg-mute', !on)
        })
      }),
    )
    resetBtn?.addEventListener('click', () => {
      mounted?.setTime(0)
      mounted?.resetCamera()
      sliderInputs.forEach((input) => {
        input.value = input.defaultValue
        input.dispatchEvent(new Event('input'))
      })
      toggleInputs.forEach((input) => {
        input.checked = input.defaultChecked
        input.dispatchEvent(new Event('change'))
      })
    })
    fsBtn?.addEventListener('click', () => {
      if (document.fullscreenElement) void document.exitFullscreen()
      else void frameEl?.requestFullscreen()
    })
    const tick = (): void => {
      requestAnimationFrame(tick)
      const t = mounted?.getTime() ?? 0
      if (clock) clock.textContent = `${t.toFixed(1)}s`
      if (scrub && !scrubbing) scrub.value = String(t % SCRUB_SPAN)
    }
    requestAnimationFrame(tick)

    // ── Backend mount / switch ──
    let backend: Backend = 'webgl2'
    const setBackendUI = (b: Backend): void => {
      backendBtns.forEach((btn) => {
        const on = btn.dataset.backend === b
        btn.setAttribute('aria-pressed', String(on))
        btn.classList.toggle('text-fg', on)
        btn.classList.toggle('bg-accent/20', on)
        btn.classList.toggle('text-fg-mute', !on)
      })
    }
    const showError = (msg: string): void => {
      if (overlay) {
        overlay.textContent = msg
        overlay.hidden = false
      }
      transport?.setAttribute('hidden', '')
      liveDot?.classList.remove('animate-pulse')
    }
    let switching = false
    const mount = async (b: Backend): Promise<void> => {
      if (switching) return
      switching = true
      backend = b
      setBackendUI(b)
      mounted?.destroy()
      mounted = null
      if (overlay) overlay.hidden = true
      transport?.removeAttribute('hidden')
      // Fresh canvas (context type is fixed for a canvas's lifetime).
      const fresh = canvasEl.cloneNode(false) as HTMLCanvasElement
      canvasEl.replaceWith(fresh)
      canvasEl = fresh
      attachWheel(fresh)
      try {
        mounted =
          b === 'webgpu'
            ? await mountShaderWebGPU(fresh, spec, sliders)
            : mountShader(fresh, spec, sliders)
        liveDot?.classList.add('animate-pulse')
        reflectPlaying()
      } catch (err) {
        showError(err instanceof Error ? err.message : 'Failed to render this shader.')
      } finally {
        switching = false
      }
    }
    backendBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        const b = btn.dataset.backend as Backend
        if (b !== backend) void mount(b)
      }),
    )
    // Reveal the WebGPU option only where an adapter is actually reachable.
    void webgpuAvailable().then((ok) => {
      if (ok) backendBtns.find((b) => b.dataset.backend === 'webgpu')?.removeAttribute('hidden')
    })
    void mount('webgl2')
  }
</script>
