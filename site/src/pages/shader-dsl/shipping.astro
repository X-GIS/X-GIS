---
import ShaderDsl from '../../layouts/ShaderDsl.astro'
import { Code } from 'astro-expressive-code/components'
import { examples } from '@xgis/shader-dsl/examples'
import { emitModule, emitGlslModule } from '@xgis/shader-dsl'
import type { EmitPlugin } from '@xgis/shader-dsl'
import { inline, mangle, minify } from '@xgis/shader-dsl/emit-prod'

const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
const root = `${base}/shader-dsl`

// kaleidoscope has a real authored vocabulary (hash / noise / fbm / palette),
// so the plugins' effect is visible. Every combination of the three plugins is
// emitted at BUILD time by the real emit; the client only toggles which
// precomputed string is shown — the DSL never ships to the browser. inline()
// flattens the call graph entirely (hash/fbm/palette AND multi-statement noise
// lift into the fragment body); the byte counts are measurements, not copy.
const kal = examples.find((e) => e.id === 'kaleidoscope')!

// The demo switches BOTH axes: the emit TARGET (WGSL, or GLSL per stage) and which
// of the three plugins are on. Every target × plugin combination is emitted at BUILD
// time by the real emit — the client only swaps the precomputed string, so the DSL
// never runs in the browser. The byte baseline is per-target (WGSL ≠ GLSL sizes).
const shipTargets: {
  key: string
  label: string
  lang: 'wgsl' | 'glsl'
  emit: (plugins: EmitPlugin[]) => string
  call: (names: string[]) => string
}[] = [
  {
    key: 'wgsl',
    label: 'WGSL',
    lang: 'wgsl',
    emit: (plugins) => emitModule(kal.module, { plugins }),
    call: (names) => (names.length ? `emitModule(m, { plugins: [${names.join(', ')}] })` : 'emitModule(m)'),
  },
  {
    key: 'glsl-vs',
    label: 'GLSL · vertex',
    lang: 'glsl',
    emit: (plugins) => emitGlslModule(kal.module, 'vertex', { plugins }),
    call: (names) =>
      names.length ? `emitGlslModule(m, 'vertex', { plugins: [${names.join(', ')}] })` : "emitGlslModule(m, 'vertex')",
  },
  {
    key: 'glsl-fs',
    label: 'GLSL · fragment',
    lang: 'glsl',
    emit: (plugins) => emitGlslModule(kal.module, 'fragment', { plugins }),
    call: (names) =>
      names.length ? `emitGlslModule(m, 'fragment', { plugins: [${names.join(', ')}] })` : "emitGlslModule(m, 'fragment')",
  },
]
const pluginCombos = [false, true].flatMap((i) =>
  [false, true].flatMap((m) => [false, true].map((n) => ({ i, m, n }))),
)
const shipCombos = shipTargets.flatMap((t) => {
  const plainBytes = t.emit([]).length
  return pluginCombos.map(({ i, m, n }) => {
    const plugins = [...(i ? [inline()] : []), ...(m ? [mangle()] : []), ...(n ? [minify()] : [])]
    const code = t.emit(plugins)
    const names = [i && 'inline()', m && 'mangle()', n && 'minify()'].filter(Boolean) as string[]
    return { key: `${t.key}:${+i}${+m}${+n}`, lang: t.lang, n, code, bytes: code.length, plainBytes, label: t.call(names) }
  })
})
const shipDefault = shipCombos.find((c) => c.key === 'wgsl:000')!

const usageSnippet = `import { emitModule, emitGlslModule } from '@xgis/shader-dsl'
import { inline, mangle, minify } from '@xgis/shader-dsl/emit-prod'

// A Vite/Webpack-style { plugins: [...] } bag. Order is execution order:
// inline() flattens the call graph, mangle() renames the survivors, minify() compacts.
const glsl = emitGlslModule(m, 'fragment', { plugins: [inline(), mangle(), minify()] })
const wgsl = emitModule(m, { plugins: [inline(), mangle(), minify()] }) // WGSL ships the same way`
---

<ShaderDsl
  current="shipping"
  title="X-GIS Shader DSL — Shipping shaders"
  description="Build-time plugins that minify, mangle, and inline the emitted WGSL/GLSL — the way your bundler treats JS — without touching the ABI names reflection depends on."
>
  <h1 class="font-display font-normal text-fg leading-[1.0] tracking-[-0.02em] text-[40px] sm:text-[52px] lg:text-[64px]">Shipping shaders</h1>
  <p class="mt-4 text-[16px] leading-[1.6] text-fg-dim max-w-full">
    Your bundler minifies every byte of JS — but never the shader text handed to
    <code class="font-mono text-[14px] text-fg">gl.shaderSource</code>. Build-time plugins fix that.
  </p>

  <section class="mt-10">
    <p class="text-[14.5px] leading-[1.6] text-fg-dim max-w-full mb-4">
      The production tooling lives on its own subpath
      (<code class="font-mono text-[13px] text-fg">@xgis/shader-dsl/emit-prod</code>) and composes the
      Vite/Webpack way — a <code class="font-mono text-[13px] text-fg">{'{ plugins: [...] }'}</code> bag you pass to the emit call.
      A consumer that never imports the subpath bundles zero bytes of it.
    </p>
    <p class="text-[14.5px] leading-[1.6] text-fg-dim max-w-full mb-3">Two compact the text; one reshapes the program:</p>
    <ul class="text-[14.5px] leading-[1.55] text-fg-dim max-w-full space-y-2">
      <li><strong class="text-fg font-mono text-[13px]">mangle</strong> — renames the authored vocabulary (helpers, plain structs, consts → <code class="font-mono text-[13px] text-fg">_f0/_S0/_k0</code>); pass a <code class="font-mono text-[13px] text-fg">Map</code> to get the reverse mapping back for decoding driver logs.</li>
      <li><strong class="text-fg font-mono text-[13px]">minify</strong> — strips whitespace and comments; token-safe by construction (WGSL/GLSL have no string literals).</li>
      <li class="pt-1"><strong class="text-fg font-mono text-[13px]">inline</strong> — a different kind of transform: it rewrites the IR, lifting every helper (single-return and linear multi-statement alike) into its call sites so the call graph disappears. Semantics-preserving, but it can <em>grow</em> bytes — the point is removing structure, not size.</li>
    </ul>
    <p class="mt-5 text-[14px] leading-[1.6] text-fg-dim max-w-full">
      The goal is narrow and honest: shrink the payload and raise the cost of reading or lifting your
      shader techniques. It is <strong class="text-fg">not encryption</strong> — a determined reader can
      still recover behaviour. These plugins make that expensive, not impossible.
    </p>
    <div class="sd-code mt-5 max-w-full"><Code code={usageSnippet} lang="ts" /></div>
  </section>

  <section class="mt-10">
    <h2 class="font-display text-[19px] font-normal text-fg tracking-[-0.015em] mb-2">The ABI boundary</h2>
    <p class="text-[14.5px] leading-[1.6] text-fg-dim max-w-full">
      The rule is simple: <strong class="text-fg">if a host looks a name up by string, we never change it.</strong>
      That freezes four categories — entry points (WebGPU <code class="font-mono text-[13px] text-fg">entryPoint</code>),
      binding names (including the <code class="font-mono text-[13px] text-fg">_fp64</code> fast-math guard the
      df64 helpers thread through), UBO block tags, and struct field names (std140 packing + GLSL varyings
      link vertex↔fragment by name). Reflection-driven hosts bind exactly as before. Full rules in the
      <a href={`${root}/reference`} class="text-accent hover:text-accent-hover transition-colors">reference</a>.
    </p>
  </section>

  <section class="mt-10">
    <h2 class="font-display text-[19px] font-normal text-fg tracking-[-0.015em] mb-2">Try it</h2>
    <p class="text-[14.5px] leading-[1.6] text-fg-dim max-w-full mb-5">
      Pick an emit target — <code class="font-mono text-[13px] text-fg">WGSL</code> for WebGPU, or GLSL ES 3.00 per stage —
      and toggle the plugins; the kaleidoscope shader updates live. Every target × plugin combination is emitted at
      build time, so nothing here runs the DSL in your browser — the client just swaps the precomputed string.
      Heads-up: toggling <code class="font-mono text-[13px] text-fg">inline</code> can <em>grow</em> the byte count (a
      multi-call helper is duplicated at each site) — the badge shows a signed delta, and that growth is expected,
      not a regression. Structure removal is the point.
    </p>

    <div
      id="ship-demo"
      class="max-w-full rounded-[10px] border border-line overflow-hidden"
    >
      <div class="px-4 py-3 border-b border-line bg-bg-card flex flex-col gap-3">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <div class="flex flex-wrap gap-1" role="group" aria-label="Emit target">
            {shipTargets.map((t, i) => (
              <button type="button" data-ship-target={t.key} aria-pressed={i === 0 ? 'true' : 'false'}
                class={`font-mono text-[11px] px-2.5 py-1 rounded-full border transition-colors ${i === 0 ? 'border-line-strong text-fg' : 'border-line text-fg-mute hover:text-fg'}`}>{t.label}</button>
            ))}
          </div>
          <span class="ml-auto flex items-center gap-3">
            <code data-ship-call class="font-mono text-[11.5px] text-fg-mute hidden md:inline">{shipDefault.label}</code>
            <span data-ship-badge class="font-mono text-[12px] text-fg tabular-nums">{shipDefault.plainBytes.toLocaleString()} B</span>
          </span>
        </div>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 pt-3 border-t border-line">
          {['inline', 'mangle', 'minify'].map((name) => (
            <label class="inline-flex items-center gap-2 cursor-pointer select-none">
              <input type="checkbox" data-ship-toggle={name} class="peer sr-only" />
              <span class="w-9 h-5 rounded-full bg-line-strong peer-checked:bg-accent peer-focus-visible:ring-2 peer-focus-visible:ring-accent peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-bg-card transition-colors relative after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:rounded-full after:bg-white after:transition-transform peer-checked:after:translate-x-4"></span>
              <span class="font-mono text-[12.5px] text-fg">{name}()</span>
            </label>
          ))}
        </div>
      </div>
      <div class="sd-code">
        {shipCombos.map((c) => (
          <div data-ship-panel={c.key} data-bytes={String(c.bytes)} data-plain={String(c.plainBytes)} data-label={c.label} hidden={c.key !== 'wgsl:000'}>
            <Code code={c.code} lang={c.lang} wrap={c.n} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mt-20 pt-10 border-t border-line">
    <h2 class="font-display text-[21px] font-normal text-fg tracking-[-0.02em] mb-2">Baking: emit at build time, commit the result</h2>
    <p class="text-[14.5px] leading-[1.6] text-fg-dim max-w-full">
      Nothing forces the emit to happen in the browser. If your shader set is closed — a known list of modules,
      not one derived from user data at runtime — you can emit every one at build time, commit the strings as a
      generated module, and ship <strong class="text-fg">zero bytes of DSL</strong>. The optimizer fixpoint is
      then a build cost paid once instead of a first-frame cost paid by every user, and
      <code class="font-mono text-[13px] text-fg">emitGlslModule</code> never appears in your runtime bundle at all.
    </p>
    <p class="mt-3 text-[14.5px] leading-[1.6] text-fg-dim max-w-full">
      The catch is the one every code-generation step has: <strong class="text-fg">a committed artifact is a
      second copy of something the emitters already know how to produce.</strong> The moment a DSL source changes
      without a re-bake, you are shipping a shader that no longer matches its source — and nothing in a normal
      build will say so.
    </p>

    <div class="mt-6 rounded-2xl bg-bg-card border border-line overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[600px] text-[13px] sm:text-[14px]">
          <thead class="bg-bg-elev text-fg">
            <tr>
              <th class="px-4 py-3 text-left font-medium w-[30%]">Gate</th>
              <th class="px-4 py-3 text-left font-medium">Fails when</th>
            </tr>
          </thead>
          <tbody class="text-fg-dim">
            <tr class="border-t border-line">
              <td class="px-4 py-3 text-fg">Hash equality</td>
              <td class="px-4 py-3">The committed bytes differ from a live emit, for any key. Emit is byte-deterministic across processes, so this can be exact equality — not a tolerance, not a similarity score.</td>
            </tr>
            <tr class="border-t border-line">
              <td class="px-4 py-3 text-fg">Completeness, both directions</td>
              <td class="px-4 py-3">A module was added to the registry without a re-bake (missing), <em>or</em> deleted from it and left behind in the artifact (orphan). One direction alone misses half the drift.</td>
            </tr>
            <tr class="border-t border-line">
              <td class="px-4 py-3 text-fg">Configuration meta</td>
              <td class="px-4 py-3">The bake was produced under different build-time inputs than the ones live now — injected constants, a specialisation value, a precision option. Hash equality catches this too; the meta gate <em>names</em> it.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <p class="mt-6 text-[14.5px] leading-[1.6] text-fg-dim max-w-full">
      Two rules about where that gate lives, both easy to get backwards:
    </p>
    <ul class="mt-3 text-[14.5px] leading-[1.55] text-fg-dim max-w-full space-y-2">
      <li>
        <strong class="text-fg">Do not wire the bake into your build.</strong> CI typically builds before it
        tests, so a bake that runs during the build regenerates the very artifact it is about to be checked
        against. The gate then passes by construction and proves nothing. Keep the bake a separate command a
        human runs, and commit its output.
      </li>
      <li>
        <strong class="text-fg">Do not give the gate a write-back mode.</strong> A gate that can fix its own
        failure is a second generator, and now two places decide what the artifact should contain. One
        regenerator, one judge.
      </li>
    </ul>

    <p class="mt-6 text-[14.5px] leading-[1.6] text-fg-dim max-w-full">
      <strong class="text-fg">If you bake reflection alongside the source, read
      <a href={`${root}/webgl2-compute`} class="text-accent hover:text-accent-hover transition-colors">Compute on WebGL2</a> first.</strong>
      <code class="font-mono text-[13px] text-fg">reflect()</code> describes the module you authored, while the
      GLSL you baked is the module the backend lowered. For a compute kernel — or any module with a
      <code class="font-mono text-[13px] text-fg">storage</code> binding — those disagree about every affected
      binding, and a host driven from the reflected copy binds a buffer where a sampler lives. Bake a
      GLSL-side binding table for those modules, not the raw reflection.
    </p>
  </section>
</ShaderDsl>

<script>
  // Pick an emit target (WGSL / GLSL vertex / GLSL fragment) and toggle the
  // inline/mangle/minify plugins; show the matching build-time-emitted string,
  // with a live (growth-aware, per-target) byte badge.
  const demo = document.getElementById('ship-demo')
  if (demo) {
    const targetBtns = Array.from(demo.querySelectorAll<HTMLButtonElement>('[data-ship-target]'))
    const toggles = Array.from(demo.querySelectorAll<HTMLInputElement>('[data-ship-toggle]'))
    const panels = Array.from(demo.querySelectorAll<HTMLElement>('[data-ship-panel]'))
    const badge = demo.querySelector<HTMLElement>('[data-ship-badge]')!
    const call = demo.querySelector<HTMLElement>('[data-ship-call]')
    let target = targetBtns[0]?.dataset.shipTarget ?? 'wgsl'
    const bit = (name: string) =>
      toggles.find((t) => t.dataset.shipToggle === name)?.checked ? '1' : '0'
    const fmt = (n: number) => n.toLocaleString()
    const sync = () => {
      const key = `${target}:${bit('inline')}${bit('mangle')}${bit('minify')}`
      const active = panels.find((p) => p.dataset.shipPanel === key)
      if (!active) return
      panels.forEach((p) => { p.hidden = p !== active })
      const bytes = Number(active.dataset.bytes)
      const plain = Number(active.dataset.plain)
      const pct = Math.round((Math.abs(bytes - plain) / plain) * 100)
      const sign = bytes <= plain ? '−' : '+'
      badge.textContent =
        bytes === plain ? `${fmt(bytes)} B` : `${fmt(plain)} B → ${fmt(bytes)} B (${sign}${pct}%)`
      if (call) call.textContent = active.dataset.label ?? ''
    }
    targetBtns.forEach((b) =>
      b.addEventListener('click', () => {
        target = b.dataset.shipTarget!
        targetBtns.forEach((o) => {
          const on = o === b
          o.setAttribute('aria-pressed', String(on))
          o.classList.toggle('border-line-strong', on)
          o.classList.toggle('text-fg', on)
          o.classList.toggle('border-line', !on)
          o.classList.toggle('text-fg-mute', !on)
        })
        sync()
      }),
    )
    toggles.forEach((t) => t.addEventListener('change', sync))
  }
</script>
