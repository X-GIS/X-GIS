---
import Base from '../../layouts/Base.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import { getCollection } from 'astro:content'

const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
// Newest first. Same-day posts should carry a TIME in their frontmatter date
// (e.g. 2026-07-07T06:26:00Z) — the id tie-breaker below only makes a
// missing-time tie DETERMINISTIC (the glob loader's file order is not).
const posts = (await getCollection('blog', (e) => !e.data.draft && e.data.lang === 'en'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || b.id.localeCompare(a.id))
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
---

<Base
  title="X-GIS — Blog"
  description="Engineering notes from the X-GIS team — the compiler, the shader IR, the globe math, the GPU render graph."
>
  <Header />
  <main class="pt-28 sm:pt-36 pb-32">
    <div class="max-w-[1200px] mx-auto px-6">
      <header class="mb-16 sm:mb-24">
        <p class="font-mono text-[12px] tracking-[0.22em] uppercase text-accent mb-4">Blog</p>
        <h1 class="font-display font-normal text-fg leading-[0.92] tracking-[-0.02em] text-[52px] sm:text-[72px] lg:text-[88px]">
          Engineering notes.
        </h1>
        <p class="mt-6 text-[17px] sm:text-[19px] leading-[1.6] text-fg-dim max-w-[640px]">
          How X-GIS works under the hood — the compiler, the shader IR, the globe
          math, the WebGPU render graph.
        </p>
      </header>

      {posts.length === 0 ? (
        <p class="text-fg-mute text-[15px]">No posts yet — check back soon.</p>
      ) : (
        <ul class="divide-y divide-line border-t border-line">
          {posts.map((post) => (
            <li>
              <a href={`${base}/blog/${post.id}`} class="group block py-8 sm:py-10">
                <time datetime={post.data.date.toISOString()} class="font-mono text-[12px] tracking-[0.14em] uppercase text-fg-mute">
                  {fmt(post.data.date)}
                </time>
                <h2 class="mt-2 font-display font-normal text-fg text-[28px] sm:text-[36px] leading-[1.05] tracking-[-0.02em] group-hover:text-accent transition-colors">
                  {post.data.title}
                </h2>
                <p class="mt-3 text-[16px] leading-[1.6] text-fg-dim max-w-[640px]">
                  {post.data.description}
                </p>
                {post.data.tags.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-2">
                    {post.data.tags.map((t) => (
                      <span class="font-mono text-[11px] tracking-[0.1em] uppercase text-fg-mute border border-line rounded-full px-2.5 py-0.5">
                        {t}
                      </span>
                    ))}
                  </div>
                )}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </main>
  <Footer />
</Base>
