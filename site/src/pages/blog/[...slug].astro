---
import Base from '../../layouts/Base.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import OnThisPage from '../../components/OnThisPage.astro'
import BlogPostCard from '../../components/BlogPostCard.astro'
import { getCollection, render } from 'astro:content'
import { publishedPosts, readingTimeMin } from '../../lib/blog'
// KaTeX layout CSS for $…$ math rendered by rehype-katex (build-time HTML —
// this stylesheet is the only client-side piece).
import 'katex/dist/katex.min.css'

export async function getStaticPaths() {
  const posts = await getCollection('blog', (e) => !e.data.draft)
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })

const readingMin = readingTimeMin(post.body)

// Sibling posts in the post's own locale, in the shared /blog order
// (publishedPosts is the authority for that order).
const siblings = await publishedPosts(post.data.lang)

// Left-rail "Recent posts": the newest siblings other than this one.
const recent = siblings.filter((p) => p.id !== post.id).slice(0, 6)

// "Read next": siblings ranked by shared-tag count, newest breaking ties —
// so a post with no tag overlap still falls back to the newest siblings
// rather than showing nothing.
const related = siblings
  .filter((p) => p.id !== post.id)
  .map((p) => ({ p, shared: p.data.tags.filter((t) => post.data.tags.includes(t)).length }))
  .sort((a, b) => b.shared - a.shared || b.p.data.date.getTime() - a.p.data.date.getTime())
  .slice(0, 3)
  .map((x) => x.p)

// Series navigation: when this post declares `series`, gather its siblings in
// the same series, order by their `series.order`, and expose Part-N/M + the
// adjacent posts. `part` is the author-assigned order (intent), `total` the
// actual count, so a series still reads correctly mid-authoring.
const series = post.data.series
const seriesInfo = series
  ? (() => {
      const inSeries = siblings
        .filter((p) => p.data.series?.name === series.name)
        .sort((a, b) => (a.data.series?.order ?? 0) - (b.data.series?.order ?? 0))
      const idx = inSeries.findIndex((p) => p.id === post.id)
      return {
        name: series.name,
        part: series.order,
        total: inSeries.length,
        prev: idx > 0 ? inSeries[idx - 1] : null,
        next: idx >= 0 && idx < inSeries.length - 1 ? inSeries[idx + 1] : null,
      }
    })()
  : null

// Article structured data — Base emits the site-wide WebSite/SoftwareSourceCode
// graph; this BlogPosting rides in via the head slot alongside article:* OG.
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://x-gis.github.io/X-GIS/')
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  keywords: post.data.tags.join(', '),
  inLanguage: post.data.lang,
  mainEntityOfPage: canonical.toString(),
  author: { '@type': 'Organization', name: 'X-GIS' },
}
---

<Base title={`${post.data.title} — X-GIS Blog`} description={post.data.description} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.date.toISOString()} />
    {post.data.tags.map((t) => <meta property="article:tag" content={t} />)}
    <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  </Fragment>
  <Header />
  <div id="read-progress" class="fixed top-0 left-0 h-[2px] bg-accent origin-left z-50" style="transform: scaleX(0)"></div>
  <main class="pt-28 sm:pt-36 pb-32">
    <!-- 3-zone shell on the site's 1400 standard band (same band as the
         blog index and Header), so the post stops being a layout one-off:
         a left contextual rail (recent posts + tags) fills what used to be
         dead left margin — the content now begins at the header's left
         edge — the content column holds the reading rail, and the TOC sits
         right, mirroring Docs.astro. Prose caps at the 700px measure; code,
         tables, figures and the LiveShader embed fill the content column
         (see .blog-prose rules below). The rail appears at lg; the TOC (its
         own `hidden xl:block`) joins as the third column at xl. -->
    <div class="max-w-[1400px] mx-auto px-6 lg:grid lg:gap-x-12 lg:grid-cols-[220px_minmax(0,1fr)] xl:grid-cols-[220px_minmax(0,1fr)_200px]">
      <aside class="hidden lg:block">
        <nav class="sticky top-20 text-[13px] leading-[1.7]">
          <div class="mb-7">
            <p class="text-[11px] font-mono text-fg-mute uppercase tracking-[0.16em] mb-3">Recent posts</p>
            <ul class="space-y-2">
              {recent.map((p) => (
                <li>
                  <a href={`${base}/blog/${p.id}`} class="block leading-[1.4] text-fg-dim hover:text-fg transition-colors">{p.data.title}</a>
                </li>
              ))}
            </ul>
          </div>
          {post.data.tags.length > 0 && (
            <div>
              <p class="text-[11px] font-mono text-fg-mute uppercase tracking-[0.16em] mb-3">Tags</p>
              <div class="flex flex-wrap gap-2">
                {post.data.tags.map((t) => (
                  <a href={`${base}/blog/tags/${t}`} class="font-mono text-[11px] tracking-[0.1em] uppercase text-fg-mute border border-line rounded-full px-2.5 py-0.5 hover:text-fg hover:border-line-strong transition-colors">{t}</a>
                ))}
              </div>
            </div>
          )}
        </nav>
      </aside>
      <article class="w-full min-w-0">
      <a href={`${base}/blog`} class="font-mono text-[12px] tracking-[0.14em] uppercase text-fg-mute hover:text-accent transition-colors inline-flex items-center gap-1.5">
        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
        Blog
      </a>
      <header class="mt-8 mb-12 pb-10 border-b border-line">
        {seriesInfo ? (
          <p class="font-mono text-[12px] tracking-[0.16em] uppercase text-accent">
            {seriesInfo.name} · Part {seriesInfo.part} of {seriesInfo.total}
          </p>
        ) : (
          post.data.tags[0] && (
            <p class="font-mono text-[12px] tracking-[0.16em] uppercase text-accent">{post.data.tags[0]}</p>
          )
        )}
        <h1 class="mt-4 font-display font-normal text-fg text-[40px] sm:text-[56px] leading-[1.02] tracking-[-0.02em]">
          {post.data.title}
        </h1>
        <p class="mt-5 max-w-[640px] text-[21px] leading-[1.45] text-fg">{post.data.description}</p>
        <p class="mt-6 font-mono text-[12px] tracking-[0.06em] text-fg-mute flex flex-wrap items-center gap-x-2">
          <span class="text-fg-dim">By the X-GIS team</span>
          <span aria-hidden="true">·</span>
          <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingMin} min read</span>
        </p>
        {post.data.tags.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2">
            {post.data.tags.map((t) => (
              <a
                href={`${base}/blog/tags/${t}`}
                class="font-mono text-[11px] tracking-[0.1em] uppercase text-fg-mute border border-line rounded-full px-2.5 py-0.5 hover:text-fg hover:border-line-strong transition-colors"
              >
                {t}
              </a>
            ))}
          </div>
        )}
      </header>
      <div class="blog-prose">
        <Content />
      </div>
      <aside class="mt-16 pt-8 border-t border-line text-[15px] leading-[1.6]">
        <p class="max-w-[640px] text-fg-dim">
          <span class="text-fg">Written by the X-GIS team.</span> X-GIS is an open-source,
          GPU-first map engine — a declarative style language, a typed shader IR, and the
          globe math, compiled to WebGPU. <a href={`${base}/`} class="text-accent hover:text-accent-hover transition-colors">About the project →</a>
        </p>
      </aside>
      {seriesInfo && (seriesInfo.prev || seriesInfo.next) && (
        <nav class="mt-14 pt-10 border-t border-line grid gap-6 sm:grid-cols-2 text-[15px]">
          {seriesInfo.prev ? (
            <a href={`${base}/blog/${seriesInfo.prev.id}`} class="group block">
              <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-fg-mute">← Previous · {seriesInfo.name}</span>
              <span class="mt-1.5 block leading-[1.35] text-fg-dim group-hover:text-fg transition-colors">{seriesInfo.prev.data.title}</span>
            </a>
          ) : (
            <span aria-hidden="true"></span>
          )}
          {seriesInfo.next && (
            <a href={`${base}/blog/${seriesInfo.next.id}`} class="group block sm:text-right">
              <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-fg-mute">Next · {seriesInfo.name} →</span>
              <span class="mt-1.5 block leading-[1.35] text-fg-dim group-hover:text-fg transition-colors">{seriesInfo.next.data.title}</span>
            </a>
          )}
        </nav>
      )}
      {related.length > 0 && (
        <section class="mt-14 pt-10 border-t border-line">
          <p class="font-mono text-[12px] tracking-[0.16em] uppercase text-fg-mute mb-6">Read next</p>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => <BlogPostCard post={p} />)}
          </div>
        </section>
      )}
      </article>
      <OnThisPage headings={headings} />
    </div>
  </main>
  <Footer />
</Base>

<script>
  // Decorate h2/h3 with hover "#" permalinks. Astro already stamps ids on
  // markdown headings at build time; decorating client-side keeps the
  // markdown pipeline free of an extra rehype dependency. Pure enhancement —
  // without JS the headings still have ids and the TOC links still work.
  document.querySelectorAll('.blog-prose h2[id], .blog-prose h3[id]').forEach((h) => {
    const a = document.createElement('a')
    a.href = `#${h.id}`
    a.className = 'heading-anchor'
    a.setAttribute('aria-label', 'Link to this heading')
    a.textContent = '#'
    h.appendChild(a)
  })

  // Only show a table's scroll-fade when it's actually wider than its box —
  // a table that fits shouldn't hint at hidden content. Re-checked on
  // resize since the same table can overflow on mobile and fit on desktop.
  const tableScrolls = document.querySelectorAll<HTMLElement>('.blog-prose .table-scroll')
  const syncOverflow = () => {
    tableScrolls.forEach((wrap) => {
      const inner = wrap.querySelector<HTMLElement>('.table-scroll-inner')
      if (!inner) return
      wrap.classList.toggle('has-overflow', inner.scrollWidth > inner.clientWidth)
    })
  }
  syncOverflow()
  window.addEventListener('resize', syncOverflow)

  // Reading-progress hairline — most useful on mobile, where the TOC is
  // hidden. A 2px accent line; scaleX tracks scroll position through the
  // document. Pure enhancement, no layout cost.
  const bar = document.getElementById('read-progress')
  if (bar) {
    const onScroll = () => {
      const h = document.documentElement.scrollHeight - window.innerHeight
      bar.style.transform = `scaleX(${h > 0 ? window.scrollY / h : 0})`
    }
    onScroll()
    window.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('resize', onScroll)
  }
</script>

<style is:global>
  /* Apple-style long-form reading: generous measure, calm hierarchy, hairline
     rules. Code fences are handled by astro-expressive-code; this styles the
     prose around them. */
  .blog-prose { font-size: 19px; line-height: 1.70; color: var(--color-fg-dim); }
  .blog-prose > * + * { margin-top: 1.6em; }
  /* Prose caps at the 700px measure (~66–73 chars at 19px) and centers
     while the layout is a single column (< lg). Once the grid engages
     (lg+) the article lives in its own track, so prose left-aligns and the
     wide children — code fences (.expressive-code), tables (.table-scroll),
     figures incl. the LiveShader embed (figure.live-shader), and display
     math (.katex-display) — break out to fill the content column toward
     the TOC. Wide content still scrolls inside its own box, so the fluid
     column is never blown out. */
  .blog-prose > * { max-width: 700px; margin-inline: auto; }
  @media (min-width: 1024px) {
    .blog-prose > * { margin-inline: 0; }
    .blog-prose > .expressive-code,
    .blog-prose > .table-scroll,
    .blog-prose > figure,
    .blog-prose > .katex-display {
      max-width: none;
    }
  }
  .blog-prose h2 {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-fg);
    font-size: 30px;
    line-height: 1.15;
    letter-spacing: 0.01em;
    margin-top: 2.4em;
    margin-bottom: 0.2em;
  }
  .blog-prose h3 {
    font-weight: 400;
    color: var(--color-fg);
    font-size: 23px;
    margin-top: 1.8em;
    margin-bottom: 0.35em;
  }
  /* Anchor targets land below the fixed header. */
  .blog-prose h2, .blog-prose h3 { scroll-margin-top: 6rem; }
  /* Hover "#" permalink appended by rehypeHeadingAnchors (astro.config). */
  .blog-prose .heading-anchor {
    margin-left: 0.4em;
    color: var(--color-fg-mute);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .blog-prose h2:hover .heading-anchor,
  .blog-prose h3:hover .heading-anchor,
  .blog-prose .heading-anchor:focus-visible { opacity: 1; }
  .blog-prose .heading-anchor:hover { color: var(--color-accent); }
  .blog-prose p { color: var(--color-fg-dim); }
  .blog-prose strong { color: var(--color-fg); font-weight: 500; }
  .blog-prose a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
  .blog-prose a:hover { color: var(--color-accent-hover); }
  .blog-prose ul, .blog-prose ol { padding-left: 1.3em; }
  .blog-prose ul { list-style: disc; }
  .blog-prose ol { list-style: decimal; }
  .blog-prose li + li { margin-top: 0.4em; }
  .blog-prose :not(pre) > code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    color: var(--color-fg);
    background: var(--color-bg-card);
    border-radius: 5px;
    padding: 0.1em 0.4em;
  }
  .blog-prose blockquote {
    border-left: 3px solid var(--color-accent);
    padding-left: 1em;
    color: var(--color-fg-mute);
    font-style: italic;
  }
  /* Figures / images — hairline-framed on the dark surface, with a quiet
     mono caption (matches the meta/eyebrow voice). Latent until a post
     embeds one; figures already break out to the full column at lg. */
  .blog-prose figure img,
  .blog-prose :not(figure) > img {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: 6px;
  }
  .blog-prose figcaption {
    margin-top: 0.7em;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--color-fg-mute);
  }
  /* Citation markers ([1], [2][3]) — linked to the matching #ref-N item in
     "## References" by rehypeCitations (astro.config.mjs). Superscript so
     they read as references, not body text. */
  .blog-prose a.citation {
    font-size: 0.72em;
    vertical-align: super;
    line-height: 0;
    text-decoration: none;
    color: var(--color-accent);
    font-family: var(--font-mono);
  }
  .blog-prose a.citation:hover { text-decoration: underline; }
  /* Reference-list targets land below the fixed header, same as headings. */
  .blog-prose ol li[id^='ref-'] { scroll-margin-top: 6rem; }
  /* Tables (comparison/reference tables in a few posts) — the browser
     default is borderless and unreadable on the dark surface. rehypeWrapTables
     (astro.config.mjs) wraps each <table> in .table-scroll > .table-scroll-inner
     so a too-wide table doesn't blow out the prose measure; the OUTER static
     box paints a right-edge fade that stays pinned to the visible edge while
     the INNER box scrolls — see astro.config.mjs for why the fade can't live
     on the scrolling element itself. */
  .blog-prose .table-scroll {
    position: relative;
  }
  .blog-prose .table-scroll::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 28px;
    background: linear-gradient(to right, transparent, var(--color-bg));
    pointer-events: none;
    /* Hidden until script below confirms the table actually overflows —
       a table that fits shouldn't show a "there's more" hint. Visible by
       default so a table still reads as scrollable without JS. */
    opacity: 1;
    transition: opacity 0.15s;
  }
  .blog-prose .table-scroll:not(.has-overflow)::after {
    opacity: 0;
  }
  .blog-prose .table-scroll-inner {
    overflow-x: auto;
  }
  .blog-prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9em;
  }
  .blog-prose th, .blog-prose td {
    border: 1px solid var(--color-line);
    padding: 0.55em 0.9em;
    text-align: left;
    vertical-align: top;
    /* Gives the row a background lighter than the page, so the .table-scroll
       right-edge fade (which fades TO the page's --color-bg) has something
       to fade FROM — an empty <td> is otherwise transparent, showing the
       page background straight through, which is the SAME color the fade
       ends on and would make the fade invisible everywhere it isn't
       overlapping a glyph. */
    background: var(--color-bg-elev);
  }
  .blog-prose th {
    background: var(--color-bg-card);
    color: var(--color-fg);
    font-weight: 500;
    white-space: nowrap;
  }
  /* Admonition callouts (:::note / :::tip / :::warning / :::caution /
     :::important) produced by remarkCallouts (astro.config.mjs). Coloured
     left rail + uppercase mono label, matching the <Callout> component used on
     docs pages — but reachable from plain markdown. Colours mirror
     components/Callout.astro. */
  .blog-prose .callout {
    border-left: 2px solid;
    border-radius: 0 6px 6px 0;
    padding: 0.75rem 1rem 0.8rem;
    font-size: 15px;
    line-height: 1.6;
  }
  .blog-prose .callout > * { max-width: none; margin-inline: 0; }
  .blog-prose .callout > * + * { margin-top: 0.5em; }
  .blog-prose .callout > p { color: var(--color-fg-dim); }
  .blog-prose .callout-label {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }
  .blog-prose .callout-note { border-color: rgba(203, 106, 60, 0.6); background: rgba(203, 106, 60, 0.05); }
  .blog-prose .callout-note .callout-label { color: #cb6a3c; }
  .blog-prose .callout-tip { border-color: rgba(52, 211, 153, 0.6); background: rgba(52, 211, 153, 0.05); }
  .blog-prose .callout-tip .callout-label { color: #6ee7b7; }
  .blog-prose .callout-warning { border-color: rgba(251, 191, 36, 0.6); background: rgba(251, 191, 36, 0.05); }
  .blog-prose .callout-warning .callout-label { color: #fcd34d; }
  .blog-prose .callout-caution { border-color: rgba(251, 113, 133, 0.6); background: rgba(251, 113, 133, 0.05); }
  .blog-prose .callout-caution .callout-label { color: #fda4af; }
  .blog-prose .callout-important { border-color: rgba(181, 138, 90, 0.6); background: rgba(181, 138, 90, 0.05); }
  .blog-prose .callout-important .callout-label { color: #b58a5a; }
  /* KaTeX on the dark surface: inherit the prose color, keep display math
     scrollable on narrow screens instead of overflowing the measure. */
  .blog-prose .katex { color: var(--color-fg); font-size: 1.06em; }
  .blog-prose .katex-display { overflow-x: auto; overflow-y: hidden; padding: 0.2em 0; }
</style>
