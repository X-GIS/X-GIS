---
import Base from '../../layouts/Base.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('blog', (e) => !e.data.draft)
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
---

<Base title={`${post.data.title} — X-GIS Blog`} description={post.data.description}>
  <Header />
  <main class="pt-28 sm:pt-36 pb-32">
    <article class="max-w-[720px] mx-auto px-6">
      <a href={`${base}/blog`} class="font-mono text-[12px] tracking-[0.14em] uppercase text-fg-mute hover:text-accent transition-colors inline-flex items-center gap-1.5">
        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
        Blog
      </a>
      <header class="mt-8 mb-12 pb-10 border-b border-line">
        <time datetime={post.data.date.toISOString()} class="font-mono text-[12px] tracking-[0.14em] uppercase text-accent">
          {fmt(post.data.date)}
        </time>
        <h1 class="mt-3 font-display font-semibold text-fg text-[40px] sm:text-[56px] leading-[1.02] tracking-[0.01em]">
          {post.data.title}
        </h1>
        <p class="mt-5 text-[18px] leading-[1.6] text-fg-dim">{post.data.description}</p>
      </header>
      <div class="blog-prose">
        <Content />
      </div>
    </article>
  </main>
  <Footer />
</Base>

<style is:global>
  /* Apple-style long-form reading: generous measure, calm hierarchy, hairline
     rules. Code fences are handled by astro-expressive-code; this styles the
     prose around them. */
  .blog-prose { font-size: 17px; line-height: 1.75; color: var(--color-fg-dim); }
  .blog-prose > * + * { margin-top: 1.4em; }
  .blog-prose h2 {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-fg);
    font-size: 30px;
    line-height: 1.15;
    letter-spacing: 0.01em;
    margin-top: 2.4em;
    margin-bottom: 0.2em;
  }
  .blog-prose h3 {
    font-weight: 600;
    color: var(--color-fg);
    font-size: 21px;
    margin-top: 1.8em;
  }
  .blog-prose p { color: var(--color-fg-dim); }
  .blog-prose strong { color: var(--color-fg); font-weight: 600; }
  .blog-prose a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
  .blog-prose a:hover { color: var(--color-accent-hover); }
  .blog-prose ul, .blog-prose ol { padding-left: 1.3em; }
  .blog-prose ul { list-style: disc; }
  .blog-prose ol { list-style: decimal; }
  .blog-prose li + li { margin-top: 0.4em; }
  .blog-prose :not(pre) > code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    color: var(--color-fg);
    background: var(--color-bg-card);
    border: 1px solid var(--color-line);
    border-radius: 5px;
    padding: 0.1em 0.4em;
  }
  .blog-prose blockquote {
    border-left: 3px solid var(--color-accent);
    padding-left: 1em;
    color: var(--color-fg-mute);
    font-style: italic;
  }
</style>
