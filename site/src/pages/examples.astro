---
import Base from '../layouts/Base.astro'
import Graticule from '../components/Graticule.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { Eyebrow, SectionHead } from '@/components/kit'
import { galleryCategories, featuredDemos, runIdOf } from '../content/gallery-demos'

const githubUrl = 'https://github.com/X-GIS/X-GIS'
const examplesPath = `${githubUrl}/blob/main/playground/src/examples`
// Deployed playground lives under /play/ inside the same GH Pages
// artifact (see .github/workflows/deploy-pages.yml). Cards deep-link
// to /play/demo.html?id=<name> so a click loads the running demo
// directly. BASE_URL handles the production /X-GIS/ prefix.
//
// In `astro dev` the playground isn't merged, so the cards target
// the playground's own dev server at https://<host>:3000/demo.html
// (started independently with `bun run dev` from the playground
// workspace). The user accepts the cert warning once and from there
// on dev clicks just work.
//
// `__PG_HOST__` is a SSR-emitted placeholder swapped to
// `location.hostname` by the inline script at the bottom of the page
// — this keeps dev access from a LAN IP (mobile WiFi) routing the
// card clicks back to the playground on the same machine, instead of
// the device's own (non-existent) localhost:3000.
const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
const playPath = import.meta.env.DEV
  ? 'https://__PG_HOST__:3000/demo.html'
  : `${base}/play/demo.html`
const playBase = import.meta.env.DEV
  ? 'https://__PG_HOST__:3000'
  : `${base}/play`

/** Pick the right URL for a demo card: standalone HTML when set,
 *  else the unified `demo.html?id=…` runner. The standalone path
 *  is for demos with bespoke JS glue (e.g. addOverlay calls) that
 *  doesn't fit the .xgis-source-only contract of demos.ts. */
function demoHref(d: typeof featuredDemos[number]): string {
  if (d.standaloneUrl) return `${playBase}/${d.standaloneUrl}`
  return `${playPath}?id=${runIdOf(d)}${d.defaultHash ? `#${d.defaultHash}` : ''}`
}
// Thumbnails captured by playground/e2e/_capture-thumbnails.spec.ts
// land in site/public/thumbnails/<runId>.jpg, served by Astro under
// `${base}/thumbnails/<runId>.jpg`.
const thumbBase = `${base}/thumbnails`

// Filter out demos marked `devOnly` for the production build —
// they're either pointing at a dev-server-only proxy URL (PMTiles
// world archive without CORS) or otherwise aren't usable on the
// deployed playground. In dev (astro dev) every card stays visible.
const showDevOnly = import.meta.env.DEV
const visibleCategories = showDevOnly
  ? galleryCategories
  : galleryCategories
      .map(cat => ({ ...cat, demos: cat.demos.filter(d => !d.devOnly) }))
      .filter(cat => cat.demos.length > 0)
const visibleFeatured = showDevOnly
  ? featuredDemos
  : featuredDemos.filter(d => !d.devOnly)

// Anchor slug for a category section, derived from its title so
// gallery-demos.ts stays the single source of truth without growing
// an id field ("PMTiles + MVT" → "pmtiles-mvt").
const slugOf = (title: string): string =>
  title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
---

<Base
  title="X-GIS — Examples"
  description="Working .xgis examples organized by topic — basics, PMTiles, vector tiles, data-driven styling, lines, symbols, animation, interaction, raster, and more."
>
  <Graticule />
  <Header />

  <main class="pt-24 pb-32">

    <!-- Page header -->
    <section class="max-w-[820px] mx-auto px-6 mb-16">
      <SectionHead eyebrow="Examples"
        lead="Click any card to launch the running demo — pan, zoom, rotate, and inspect. Each card also carries a source link to the underlying .xgis on GitHub for copy-paste.">
        Real <code class="font-mono text-fg">.xgis</code> samples.
      </SectionHead>
    </section>

    <!-- Featured starter — three big cards for the most representative
         entry points. Helps a first-time visitor pick a path without
         scanning the full ~50-card gallery. -->
    <section class="max-w-[1200px] mx-auto px-6 mb-20">
      <Eyebrow label="Start here" class="mb-5" />
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {visibleFeatured.map(d => (
          <a
            href={demoHref(d)}
            class="demo-card group block rounded-[8px] bg-bg-card border border-line
                   hover:border-line-strong overflow-hidden"
          >
            <div class="aspect-[16/9] bg-bg-elev relative overflow-hidden">
              <img
                src={`${thumbBase}/${runIdOf(d)}.jpg`}
                alt=""
                width="1200"
                height="675"
                loading="lazy"
                class="w-full h-full object-cover"
              />
              <span class="absolute top-3 left-3 inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full
                           bg-bg/85 backdrop-blur border border-line text-fg-dim text-[10px] font-mono tracking-[0.16em] uppercase">
                <span class="w-1.5 h-1.5 rounded-full bg-fg inline-block animate-pulse"></span>
                Live
              </span>
            </div>
            <div class="p-5">
              <p class="font-mono text-[11px] text-fg-mute mb-2 truncate">
                {d.id}.xgis
              </p>
              <h3 class="text-[20px] font-normal text-fg leading-[1.3] tracking-[-0.01em] mb-2">
                {d.title}
              </h3>
              <p class="text-[14px] leading-[1.55] text-fg-dim">
                {d.body}
              </p>
              <p class="mt-4 inline-flex items-center gap-1.5 text-[13px] font-medium text-accent group-hover:text-accent-hover transition-colors">
                Run demo
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 6l6 6-6 6"/>
                </svg>
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Section divider -->
    <div class="max-w-[1200px] mx-auto px-6 mb-6">
      <Eyebrow label="All examples" />
    </div>

    <!-- Sticky range: category jump-nav + the category sections it
         navigates. The wrapper bounds position:sticky so the strip
         releases after the last category (before the footer pointer). -->
    <div>
      <!-- Category jump-nav — the gallery is a ~50-card, 14-section
           scroll with no way to land on a topic. A single row of
           anchor pills that scrolls horizontally instead of wrapping
           (hidden scrollbar, same idiom as the mobile docs
           breadcrumb) and sticks just below the fixed header. Each
           pill carries the demo count in mono. -->
      <nav
        aria-label="Example categories"
        class="sticky top-12 z-40 bg-bg/85 backdrop-blur-xl border-y border-line"
      >
        <div class="max-w-[1200px] mx-auto px-6 py-2.5 flex items-center gap-2 overflow-x-auto no-scrollbar">
          {visibleCategories.map(cat => (
            <a
              href={`#${slugOf(cat.title)}`}
              class="flex-none inline-flex items-baseline gap-1.5 px-3 py-1 rounded-full border border-line
                     text-[12.5px] leading-[1.6] text-fg-dim whitespace-nowrap
                     hover:text-fg hover:border-line-strong transition-colors"
            >
              {cat.title}
              <span class="font-mono text-[10.5px] text-fg-mute">{cat.demos.length}</span>
            </a>
          ))}
        </div>
      </nav>

      <!-- Categories -->
      <div class="max-w-[1200px] mx-auto px-6 space-y-20 pt-12">
      {visibleCategories.map(cat => (
        <section id={slugOf(cat.title)} class="scroll-mt-12">
          <h2 class="font-display text-[26px] sm:text-[30px] font-normal text-fg leading-[1.2] tracking-[-0.02em] mb-2">
            {cat.title}
          </h2>
          <p class="text-[15px] leading-[1.6] text-fg-dim mb-8 max-w-[680px]">
            {cat.body}
          </p>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {cat.demos.map(d => (
              <article
                class="demo-card group relative rounded-[8px] bg-bg-card border border-line
                       hover:border-line-strong overflow-hidden"
              >
                <a
                  href={demoHref(d)}
                  class="block"
                  aria-label={`Run ${d.title} demo`}
                >
                  {!d.noThumb && (
                    <div class="aspect-[16/9] bg-bg-elev relative overflow-hidden">
                      <img
                        src={`${thumbBase}/${runIdOf(d)}.jpg`}
                        alt=""
                        width="1200"
                        height="675"
                        loading="lazy"
                        class="w-full h-full object-cover"
                      />
                      <span class="absolute top-3 left-3 inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full
                                   bg-bg/85 backdrop-blur border border-line text-fg-dim text-[10px] font-mono tracking-[0.16em] uppercase">
                        <span class="w-1.5 h-1.5 rounded-full bg-fg inline-block animate-pulse"></span>
                        Live
                      </span>
                    </div>
                  )}
                  <div class="p-5 pr-12">
                    {d.noThumb && (
                      <div class="flex items-center gap-2 mb-2">
                        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full
                                     border border-line text-fg-dim text-[10px] font-mono tracking-[0.16em] uppercase">
                          <span class="w-1.5 h-1.5 rounded-full bg-fg inline-block animate-pulse"></span>
                          Live
                        </span>
                      </div>
                    )}
                    <p class="font-mono text-[11px] text-fg-mute group-hover:text-fg-dim transition-colors truncate mb-2">
                      {d.id}.xgis
                    </p>
                    <h3 class="text-[16px] font-normal text-fg leading-[1.3] tracking-[-0.01em] mb-2">
                      {d.title}
                    </h3>
                    <p class="text-[13px] leading-[1.5] text-fg-dim">
                      {d.body}
                    </p>
                  </div>
                </a>
                {/* Standalone-HTML demos (e.g. labels / text-overlay) have
                    no backing .xgis file, so the GitHub source link would
                    404 — suppress it for those cards. */}
                {!d.standaloneUrl && (
                  <a
                    href={`${examplesPath}/${d.id}.xgis`}
                    target="_blank"
                    rel="noopener"
                    aria-label={`View ${d.id}.xgis source on GitHub`}
                    class="absolute bottom-4 right-4 inline-flex items-center justify-center
                           w-8 h-8 rounded-[6px] text-fg-mute hover:text-fg hover:bg-line
                           transition-colors"
                    title="View source on GitHub"
                  >
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="16 18 22 12 16 6" />
                      <polyline points="8 6 2 12 8 18" />
                    </svg>
                  </a>
                )}
              </article>
            ))}
          </div>
        </section>
      ))}
      </div>
    </div>

    <!-- Footer pointer -->
    <section class="max-w-[820px] mx-auto px-6 mt-24 pt-12 border-t border-line">
      <p class="text-[14px] leading-[1.6] text-fg-dim">
        The
        <a href={`${examplesPath}`} target="_blank" rel="noopener" class="text-accent hover:text-accent-hover transition-colors">full examples directory</a>
        carries another ~60 fixture and reference-test files used by the e2e harness — useful for
        contributors digging into a specific renderer behavior, less so for learning the language.
      </p>
    </section>
  </main>

  <Footer />
</Base>

<!-- Swap the `__PG_HOST__` SSR placeholder in every dev card href to
     the current page hostname. localhost-hardcoded cards would 404
     when the dev server is browsed from a phone over LAN — this lets
     the LAN IP origin route clicks back to the same machine. Prod
     builds don't emit the placeholder, so this no-ops there. -->
<script is:inline>
  (function () {
    var h = location.hostname
    document.querySelectorAll('a[href*="__PG_HOST__"]').forEach(function (a) {
      a.href = a.href.replace(/__PG_HOST__/g, h)
    })
  })()
</script>

<style>
  /* Apple-signature card hover: combined transform + color easing,
   * slow quart-out curve. Color shifts (border, bg) get the same
   * timing as the lift so they read as one motion. */
  .demo-card {
    transition:
      transform 500ms cubic-bezier(0.16, 0.84, 0.32, 1),
      border-color 350ms cubic-bezier(0.16, 0.84, 0.32, 1),
      background-color 350ms cubic-bezier(0.16, 0.84, 0.32, 1);
  }
  .demo-card:hover {
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .demo-card { transition: none; }
    .demo-card:hover { transform: none; }
  }
</style>
