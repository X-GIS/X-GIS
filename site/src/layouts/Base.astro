---
import '../styles/global.css'
import MobileNavDrawer from '../components/MobileNavDrawer.astro'
import { getAbsoluteLocaleUrl } from 'astro:i18n'
import { koRoutes, toLogicalPath, hasKoTwin, localeOf } from '../lib/i18n'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'X-GIS — A language for cartography',
  description = 'A domain-specific language and WebGPU rendering engine for GIS maps. Declare what your map should look like; the compiler emits the WGSL.',
} = Astro.props

const siteUrl = 'https://x-gis.github.io/X-GIS/'
const canonical = new URL(Astro.url.pathname, Astro.site ?? siteUrl).toString()

// Asset paths must respect the GH Pages base prefix (`/X-GIS/` in CI,
// `/` in dev). BASE_URL handles that; we strip a trailing slash so the
// joined path doesn't double up.
const base = import.meta.env.BASE_URL.replace(/\/+$/, '')
const logoUrl = `${base}/x-gis-logo-dark.svg`

// Locale of the current page + its locale-agnostic logical path, used for the
// <html lang>, the hreflang alternates, and JSON-LD inLanguage. `koRoutes`
// (the build-time manifest of /ko pages) is the single source of truth shared
// with LangToggle.astro and the first-visit auto-switch script below — it only
// redirects a Korean browser to a /ko page that ACTUALLY exists, so it is a
// safe no-op until /ko content is filled in. See src/lib/i18n.ts.
const lang = localeOf(Astro.url.pathname)
const logical = toLogicalPath(Astro.url.pathname)
const koTwin = hasKoTwin(logical)

// JSON-LD: SoftwareSourceCode + WebSite. Helps search engines surface
// the project as a software listing rather than a generic page.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'X-GIS',
      description,
      inLanguage: lang,
    },
    {
      '@type': 'SoftwareSourceCode',
      '@id': `${siteUrl}#software`,
      name: 'X-GIS',
      description,
      programmingLanguage: ['TypeScript', 'WGSL'],
      codeRepository: 'https://github.com/X-GIS/X-GIS',
      license: 'https://opensource.org/licenses/MIT',
      url: siteUrl,
    },
  ],
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1722" />
    <link rel="canonical" href={canonical} />

    <!-- hreflang alternates — pair the language variants for search engines.
         English always exists at the root; Korean only when a /ko twin of this
         page is present. x-default points at the English (default) variant.
         getAbsoluteLocaleUrl folds in the base prefix + site origin. -->
    <link rel="alternate" hreflang="en" href={getAbsoluteLocaleUrl('en', logical)} />
    {koTwin && <link rel="alternate" hreflang="ko" href={getAbsoluteLocaleUrl('ko', logical)} />}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en', logical)} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}og.svg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="X-GIS" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}og.svg`} />

    <link rel="icon" type="image/svg+xml" href={logoUrl} />
    <!-- Fonts are self-hosted via @fontsource-variable (Big Shoulders
         Display / Archivo / Spline Sans Mono) — no preconnect to
         fonts.googleapis.com / fonts.gstatic.com needed. -->

    <title>{title}</title>

    <!-- First-visit language auto-switch. Runs before paint (is:inline, in
         <head>) so a Korean browser lands on the /ko twin without a flash.
         Rules: a manually-stored choice ALWAYS wins (the toggle sets it); on a
         first visit with no stored choice we detect navigator.language, remember
         it, and redirect to /ko ONLY when a localized twin exists (koRoutes). -->
    <script is:inline define:vars={{ koRoutes, base }}>
      (function () {
        try {
          var KEY = 'xgis-lang'
          if (localStorage.getItem(KEY)) return // manual choice wins
          var isKo = (navigator.language || '').toLowerCase().slice(0, 2) === 'ko'
          localStorage.setItem(KEY, isKo ? 'ko' : 'en') // remember first-visit detection
          if (!isKo) return
          var path = location.pathname
          if (path.indexOf(base + '/ko') === 0) return // already localized
          var rel = path.indexOf(base) === 0 ? path.slice(base.length) : path
          var tail = rel === '/' || rel === '' ? '' : rel
          var want = '/ko' + tail
          if (koRoutes.indexOf(want) !== -1 || koRoutes.indexOf(want.replace(/\/$/, '')) !== -1) {
            location.replace(base + '/ko' + tail)
          }
        } catch (e) {}
      })()
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="overflow-x-hidden">
    <slot />
    <!-- Mobile nav drawer lives at body root, NOT inside the header
         that hosts its trigger button — see MobileNavDrawer.astro
         for the containing-block reasoning. -->
    <MobileNavDrawer />
  </body>
</html>
