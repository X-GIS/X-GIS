{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["@webgpu/types"],
    // Consume the emitted declarations of the referenced packages (built first
    // via the project references below) instead of recompiling their source
    // under engine's rootDir — same pattern as runtime/tsconfig.json: lets
    // standalone `tsc` / VSCode resolve @xgis/* to their .d.ts the way the
    // project-reference build does, avoiding cross-package TS6059 rootDir
    // errors and source type-drift.
    "paths": {
      "@xgis/compiler": ["../compiler/dist/index.d.ts"],
      "@xgis/compiler/tiler/geodesic": ["../compiler/dist/tiler/geodesic.d.ts"],
      "@xgis/shared": ["../shared/dist/index.d.ts"],
      "@xgis/shader-dsl": ["../shader-dsl/dist/index.d.ts"],
      "@xgis/shader-dsl/*": ["../shader-dsl/dist/*"]
    }
  },
  "references": [{ "path": "../compiler" }, { "path": "../shared" }, { "path": "../shader-dsl" }],
  "include": ["src/**/*.ts"]
}
